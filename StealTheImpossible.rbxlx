<Item class="ModuleScript" referent="RBX00000027">
  <Properties>
    <string name="Name">ActionController</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Client Gameplay Actions (Tackle/Steal, Gadget Use, Return Home)
-- Plus real-time 3D item animation: The Last Eye tracking nearest player & Time Eater reverse spin!

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Remotes = require(Shared.Remotes)
local Localization = require(Shared.Localization)

local UITheme = require(script.Parent.UITheme)
local HUDController = require(script.Parent.HUDController)

local ActionController = {}
local tackleCooldownUntil = 0
local tackleBtn: TextButton
local gadgetBtn: TextButton

local function triggerTackleSteal()
    if os.clock() < tackleCooldownUntil then
        return
    end
    tackleCooldownUntil = os.clock() + 1.2
    Remotes.GetEvent("RequestTackleSteal"):FireServer()

    -- Snappy visual dash lunge on client responsiveness
    local char = Players.LocalPlayer.Character
    local hrp = if char then char:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
    if hrp then
        hrp.AssemblyLinearVelocity += hrp.CFrame.LookVector * 36 + Vector3.new(0, 6, 0)
    end
end

local function triggerFirstOwnedGadget()
    local profile = HUDController.CurrentProfile
    if not profile then
        return
    end
    -- Priority order of owned gadgets
    for _, gid in ipairs({ "speed_coil", "phase_dash", "magnet_radar", "frost_bolas" }) do
        if profile.OwnedGadgets[gid] then
            Remotes.GetEvent("RequestUseGadget"):FireServer(gid)
            return
        end
    end
end

function ActionController.Init(rootGui: ScreenGui)
    local isTouchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    local actionPanel = Instance.new("Frame")
    actionPanel.Name = "ActionButtons"
    actionPanel.Size = UDim2.fromOffset(170, 146)
    actionPanel.Position = UDim2.new(1, -184, 1, if isTouchOnly then -270 else -218)
    actionPanel.BackgroundTransparency = 1
    actionPanel.Parent = rootGui

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.Parent = actionPanel

    tackleBtn = UITheme.MakeButton({
        Text = "⚡ STEAL [E]",
        Size = UDim2.fromOffset(168, 44),
        Color = UITheme.Colors.Red,
        Parent = actionPanel,
        FontSize = 15,
    })
    tackleBtn.MouseButton1Click:Connect(triggerTackleSteal)

    gadgetBtn = UITheme.MakeButton({
        Text = "📡 GADGET [Q]",
        Size = UDim2.fromOffset(168, 40),
        Color = UITheme.Colors.Cyan,
        TextColor = Color3.fromRGB(12, 16, 26),
        Parent = actionPanel,
        FontSize = 14,
    })
    gadgetBtn.MouseButton1Click:Connect(triggerFirstOwnedGadget)

    local homeBtn = UITheme.MakeButton({
        Text = "🏠 HOME [H]",
        Size = UDim2.fromOffset(168, 36),
        Color = UITheme.Colors.BgCard,
        Parent = actionPanel,
        FontSize = 13,
    })
    homeBtn.MouseButton1Click:Connect(function()
        Remotes.GetEvent("RequestReturnHome"):FireServer()
    end)

    HUDController.OnLanguageChange(function(lang)
        tackleBtn.Text = "⚡ " .. Localization.Get("TACKLE_BTN", lang) .. " [E]"
        gadgetBtn.Text = "📡 " .. Localization.Get("GADGET_BTN", lang) .. " [Q]"
        homeBtn.Text = "🏠 " .. Localization.Get("RETURN_HOME", lang) .. " [H]"
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then
            return
        end
        if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonX then
            triggerTackleSteal()
        elseif input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.ButtonY then
            triggerFirstOwnedGadget()
        elseif input.KeyCode == Enum.KeyCode.H then
            Remotes.GetEvent("RequestReturnHome"):FireServer()
        end
    end)

    -- Live 3D Visual Animations (The Last Eye tracks nearest player! Time Eater hands spin backwards!)
    RunService.RenderStepped:Connect(function(dt)
        -- 1. The Last Eye Tracking Iris ("Oyuncuyu takip eden gizemli göz")
        for _, iris in ipairs(CollectionService:GetTagged("TrackingEyeIris")) do
            if iris:IsA("BasePart") and iris.Parent then
                local model = iris.Parent :: Model
                local core = model:FindFirstChild("Sclera") :: BasePart?
                if core then
                    local bestTargetPos: Vector3? = nil
                    local bestDist = 85
                    for _, plr in ipairs(Players:GetPlayers()) do
                        local ch = plr.Character
                        local head = if ch then ch:FindFirstChild("Head") :: BasePart? else nil
                        if head then
                            local d = (head.Position - core.Position).Magnitude
                            if d < bestDist then
                                bestDist = d
                                bestTargetPos = head.Position
                            end
                        end
                    end
                    if bestTargetPos then
                        local dir = (bestTargetPos - core.Position).Unit
                        local irisCF = CFrame.lookAt(core.Position + dir * (core.Size.X * 0.42), bestTargetPos)
                        iris.CFrame = irisCF
                        local pupil = model:FindFirstChild("VoidPupil") :: BasePart?
                        if pupil then
                            pupil.CFrame = CFrame.lookAt(core.Position + dir * (core.Size.X * 0.50), bestTargetPos)
                        end
                    end
                end
            end
        end

        -- 2. Time Eater / Clockwork reverse rotation
        for _, hand in ipairs(CollectionService:GetTagged("ReverseClockHand")) do
            if hand:IsA("BasePart") and hand.Parent then
                hand.CFrame = hand.CFrame * CFrame.Angles(0, 0, dt * 3.5)
            end
        end
    end)
end

return ActionController
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000028">
  <Properties>
    <string name="Name">BaseManagerController</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Base Tier 1-5 Upgrades, Showcase Pedestal Flex Assignment & Galaxy Egg Hatching UI

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local BaseConfig = require(Shared.BaseConfig)
local ItemCatalog = require(Shared.ItemCatalog)
local MutationConfig = require(Shared.MutationConfig)
local RarityConfig = require(Shared.RarityConfig)
local Remotes = require(Shared.Remotes)
local Localization = require(Shared.Localization)
local Utils = require(Shared.Utils)

local UITheme = require(script.Parent.UITheme)
local HUDController = require(script.Parent.HUDController)

local BaseManagerController = {}
local bodyFrame: ScrollingFrame
local modalPanel: Frame

local function clearChildren(parent: Instance)
    for _, ch in ipairs(parent:GetChildren()) do
        if ch:IsA("GuiObject") then
            ch:Destroy()
        end
    end
end

function BaseManagerController.Refresh()
    if not bodyFrame then
        return
    end
    clearChildren(bodyFrame)

    local profile = HUDController.CurrentProfile
    local lang = HUDController.GetLanguage()
    if not profile then
        return
    end

    local currentTier = BaseConfig.GetTier(profile.BaseTier)
    local nextTier = if profile.BaseTier < #BaseConfig.UpgradeTiers then BaseConfig.GetTier(profile.BaseTier + 1) else nil

    -- Base Tier Growth Card
    local tierCard = Instance.new("Frame")
    tierCard.Size = UDim2.new(1, -10, 0, 108)
    tierCard.BackgroundColor3 = UITheme.Colors.BgCard
    UITheme.AddCorner(tierCard, 10)
    UITheme.AddStroke(tierCard, UITheme.Colors.Green, 1.5)
    tierCard.Parent = bodyFrame

    local tierTitle = Instance.new("TextLabel")
    tierTitle.Size = UDim2.new(0.65, 0, 0, 34)
    tierTitle.Position = UDim2.fromOffset(14, 10)
    tierTitle.BackgroundTransparency = 1
    tierTitle.Font = Enum.Font.GothamBlack
    tierTitle.TextSize = 18
    tierTitle.TextXAlignment = Enum.TextXAlignment.Left
    tierTitle.TextColor3 = UITheme.Colors.Green
    tierTitle.Text = string.format("🏛️ Tier %d: %s", currentTier.Tier, if lang == "tr" then currentTier.NameTR else currentTier.Name)
    tierTitle.Parent = tierCard

    local tierInfo = Instance.new("TextLabel")
    tierInfo.Size = UDim2.new(0.65, 0, 0, 50)
    tierInfo.Position = UDim2.fromOffset(14, 46)
    tierInfo.BackgroundTransparency = 1
    tierInfo.Font = Enum.Font.GothamMedium
    tierInfo.TextSize = 13
    tierInfo.TextWrapped = true
    tierInfo.TextXAlignment = Enum.TextXAlignment.Left
    tierInfo.TextColor3 = UITheme.Colors.TextMuted
    tierInfo.Text = string.format(
        "Pedestals: %d  |  Income Multiplier: %.2fx  |  Base Likes: ❤️ %d",
        currentTier.MaxPedestals,
        currentTier.IncomeMultiplier,
        profile.TotalBaseLikes
    )
    tierInfo.Parent = tierCard

    if nextTier then
        local upgBtn = UITheme.MakeButton({
            Text = string.format("%s\n(%s)", Localization.Get("UPGRADE_BASE", lang), Utils.FormatCash(nextTier.Cost)),
            Size = UDim2.fromOffset(195, 68),
            Position = UDim2.new(1, -210, 0, 20),
            Color = if profile.Cash >= nextTier.Cost then UITheme.Colors.Green else UITheme.Colors.BgHover,
            TextColor = if profile.Cash >= nextTier.Cost then Color3.fromRGB(14, 18, 28) else UITheme.Colors.TextMuted,
            Parent = tierCard,
            FontSize = 14,
        })
        upgBtn.MouseButton1Click:Connect(function()
            Remotes.GetEvent("RequestUpgradeBase"):FireServer()
        end)
    end

    -- Security Shield + High-Stakes 2x Raid Safe Card
    local safeCard = Instance.new("Frame")
    safeCard.Size = UDim2.new(1, -10, 0, 86)
    safeCard.BackgroundColor3 = UITheme.Colors.BgCard
    UITheme.AddCorner(safeCard, 10)
    UITheme.AddStroke(safeCard, if profile.HighStakesMode then UITheme.Colors.Red else UITheme.Colors.Cyan, 1.5)
    safeCard.Parent = bodyFrame

    local shieldActive = HUDController.CurrentShieldRemaining > 0
    local safeTitle = Instance.new("TextLabel")
    safeTitle.Size = UDim2.new(0.54, 0, 0, 30)
    safeTitle.Position = UDim2.fromOffset(14, 8)
    safeTitle.BackgroundTransparency = 1
    safeTitle.Font = Enum.Font.GothamBlack
    safeTitle.TextSize = 15
    safeTitle.TextXAlignment = Enum.TextXAlignment.Left
    safeTitle.TextColor3 = if profile.HighStakesMode then UITheme.Colors.Red else UITheme.Colors.Cyan
    safeTitle.Text = string.format(
        "🛡️ %s: %s   |   🔐 %s: %s",
        Localization.Get("BASE_SHIELD", lang),
        if shieldActive then (tostring(HUDController.CurrentShieldRemaining) .. "s") else "DOWN",
        Localization.Get("SAFE_CASH", lang),
        Utils.FormatCash(profile.UncollectedSafeCash or 0)
    )
    safeTitle.Parent = safeCard

    local safeHint = Instance.new("TextLabel")
    safeHint.Size = UDim2.new(0.54, 0, 0, 38)
    safeHint.Position = UDim2.fromOffset(14, 40)
    safeHint.BackgroundTransparency = 1
    safeHint.Font = Enum.Font.GothamMedium
    safeHint.TextSize = 12
    safeHint.TextWrapped = true
    safeHint.TextXAlignment = Enum.TextXAlignment.Left
    safeHint.TextColor3 = UITheme.Colors.TextMuted
    safeHint.Text = if profile.HighStakesMode
        then "🔥 High-Stakes 2x ACTIVE: Passive cash builds in your raidable Safe!"
        else "Standard Mode: Safe passive income. Turn on 2x Risk for double Safe Cash!"
    safeHint.Parent = safeCard

    local riskBtn = UITheme.MakeButton({
        Text = if profile.HighStakesMode then "🔥 2x ON" else ("⚡ " .. Localization.Get("HIGH_STAKES_MODE", lang)),
        Size = UDim2.fromOffset(130, 34),
        Position = UDim2.new(1, -415, 0, 26),
        Color = if profile.HighStakesMode then UITheme.Colors.Red else UITheme.Colors.BgHover,
        Parent = safeCard,
        FontSize = 12,
    })
    riskBtn.MouseButton1Click:Connect(function()
        Remotes.GetEvent("RequestToggleHighStakes"):FireServer()
    end)

    local collectBtn = UITheme.MakeButton({
        Text = "💰 " .. Localization.Get("COLLECT_SAFE", lang),
        Size = UDim2.fromOffset(132, 34),
        Position = UDim2.new(1, -278, 0, 26),
        Color = UITheme.Colors.Gold,
        TextColor = Color3.fromRGB(14, 18, 28),
        Parent = safeCard,
        FontSize = 12,
    })
    collectBtn.MouseButton1Click:Connect(function()
        Remotes.GetEvent("RequestCollectBaseSafe"):FireServer()
    end)

    local shieldBtn = UITheme.MakeButton({
        Text = "🛡️ " .. Localization.Get("RECHARGE_SHIELD", lang),
        Size = UDim2.fromOffset(132, 34),
        Position = UDim2.new(1, -142, 0, 26),
        Color = UITheme.Colors.Cyan,
        TextColor = Color3.fromRGB(14, 18, 28),
        Parent = safeCard,
        FontSize = 12,
    })
    shieldBtn.MouseButton1Click:Connect(function()
        Remotes.GetEvent("RequestRechargeShield"):FireServer()
    end)

    -- Vault & Showcase Pedestal Inventory List
    for idx, inst in ipairs(profile.VaultItems) do
        local def = ItemCatalog.Get(inst.ItemId)
        if def then
            local rarity = RarityConfig.Get(def.Rarity)
            local mutInfo = MutationConfig.Get(inst.Mutation)
            local totalMult = ItemCatalog.GetInstanceMultiplier(inst)
            local card = Instance.new("Frame")
            card.Size = UDim2.new(1, -10, 0, 74)
            card.BackgroundColor3 = UITheme.Colors.BgCard
            UITheme.AddCorner(card, 10)
            UITheme.AddStroke(card, if mutInfo.Id ~= "Normal" then mutInfo.Color else rarity.Color, 1.4)
            card.LayoutOrder = idx + 10
            card.Parent = bodyFrame

            local title = Instance.new("TextLabel")
            title.Size = UDim2.new(0.55, 0, 0, 28)
            title.Position = UDim2.fromOffset(12, 8)
            title.BackgroundTransparency = 1
            title.Font = Enum.Font.GothamBlack
            title.TextSize = 15
            title.TextXAlignment = Enum.TextXAlignment.Left
            title.TextColor3 = rarity.Color
            local itemName = if lang == "tr" then def.NameTR else def.Name
            local mutPrefix = if mutInfo.Id ~= "Normal" then ("[" .. string.upper(mutInfo.Prefix) .. "] ") else ""
            local hatchSuffix = if inst.HatchedCreature then (" [" .. inst.HatchedCreature .. "]") else ""
            title.Text = string.format("%s %s%s%s", def.Icon, mutPrefix, itemName, hatchSuffix)
            title.Parent = card

            local sub = Instance.new("TextLabel")
            sub.Size = UDim2.new(0.55, 0, 0, 26)
            sub.Position = UDim2.fromOffset(12, 38)
            sub.BackgroundTransparency = 1
            sub.Font = Enum.Font.GothamMedium
            sub.TextSize = 12
            sub.TextXAlignment = Enum.TextXAlignment.Left
            sub.TextColor3 = if mutInfo.Id ~= "Normal" then mutInfo.Color else UITheme.Colors.TextMuted
            local slotStr = if inst.PedestalSlot then ("Pedestal #" .. tostring(inst.PedestalSlot)) else "Vault Storage (35%)"
            local effectiveIncome = math.floor(def.PassiveIncomePerSec * totalMult)
            sub.Text = string.format("%s (%.2fx)  •  +%s/s  •  %s", rarity.DisplayName, totalMult, Utils.FormatCash(effectiveIncome), slotStr)
            sub.Parent = card

            -- Place on next available pedestal or remove
            local flexBtn = UITheme.MakeButton({
                Text = if inst.PedestalSlot then "Store" else Localization.Get("EQUIP_PEDESTAL", lang),
                Size = UDim2.fromOffset(145, 38),
                Position = UDim2.new(1, -158, 0, 18),
                Color = if inst.PedestalSlot then UITheme.Colors.BgHover else UITheme.Colors.Purple,
                Parent = card,
                FontSize = 12,
            })
            flexBtn.MouseButton1Click:Connect(function()
                if inst.PedestalSlot then
                    Remotes.GetEvent("RequestClearPedestal"):FireServer(inst.PedestalSlot)
                else
                    -- Pick first free slot or slot 1
                    local used: { [number]: boolean } = {}
                    for _, other in ipairs(profile.VaultItems) do
                        if other.PedestalSlot then
                            used[other.PedestalSlot] = true
                        end
                    end
                    local chosen = 1
                    for s = 1, currentTier.MaxPedestals do
                        if not used[s] then
                            chosen = s
                            break
                        end
                    end
                    Remotes.GetEvent("RequestAssignPedestal"):FireServer(inst.Uid, chosen)
                end
            end)

            -- Galaxy Egg Hatch Button ("İçinden rastgele galaksi yaratığı çıkan yumurta")
            if def.SpecialBehavior == "HatchableEgg" and not inst.HatchedCreature then
                local hatchBtn = UITheme.MakeButton({
                    Text = "🌌 " .. Localization.Get("HATCH_EGG", lang),
                    Size = UDim2.fromOffset(155, 38),
                    Position = UDim2.new(1, -322, 0, 18),
                    Color = UITheme.Colors.Gold,
                    TextColor = Color3.fromRGB(14, 18, 28),
                    Parent = card,
                    FontSize = 12,
                })
                hatchBtn.MouseButton1Click:Connect(function()
                    Remotes.GetEvent("RequestHatchGalaxyEgg"):FireServer(inst.Uid)
                end)
            end
        end
    end
end

function BaseManagerController.Init(rootGui: ScreenGui)
    local panel, body, closeBtn = UITheme.CreateModal("BaseManagerModal", "🏛️ BASE & VAULT MANAGER", rootGui, UITheme.Colors.Green)
    modalPanel = panel
    bodyFrame = body
    closeBtn.MouseButton1Click:Connect(function()
        modalPanel.Visible = false
    end)
    HUDController.RegisterModal("Base", modalPanel, BaseManagerController.Refresh)
end

return BaseManagerController
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000029">
  <Properties>
    <string name="Name">CodexIndexController</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Global Growth Feature #2: "SECRET COLLECTION (0.01%)" & Weekly Limited Codex

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local ItemCatalog = require(Shared.ItemCatalog)
local WeeklyItems = require(Shared.WeeklyItems)
local RarityConfig = require(Shared.RarityConfig)

local UITheme = require(script.Parent.UITheme)
local HUDController = require(script.Parent.HUDController)

local CodexIndexController = {}
local modalPanel: Frame
local bodyFrame: ScrollingFrame

local function clearChildren(parent: Instance)
    for _, ch in ipairs(parent:GetChildren()) do
        if ch:IsA("GuiObject") then
            ch:Destroy()
        end
    end
end

function CodexIndexController.Refresh()
    if not bodyFrame then
        return
    end
    clearChildren(bodyFrame)

    local profile = HUDController.CurrentProfile
    local lang = HUDController.GetLanguage()

    -- Header showing Weekly LiveOps Banner
    local weeklyBanner = Instance.new("TextLabel")
    weeklyBanner.Size = UDim2.new(1, -10, 0, 36)
    weeklyBanner.BackgroundColor3 = Color3.fromRGB(28, 22, 52)
    weeklyBanner.Font = Enum.Font.GothamBlack
    weeklyBanner.TextSize = 14
    weeklyBanner.TextColor3 = UITheme.Colors.Gold
    weeklyBanner.Text = "📅 WEEKLY DROP: " .. if lang == "tr" then WeeklyItems.ACTIVE_WEEK_TITLE_TR else WeeklyItems.ACTIVE_WEEK_TITLE
    UITheme.AddCorner(weeklyBanner, 8)
    weeklyBanner.LayoutOrder = 1
    weeklyBanner.Parent = bodyFrame

    local masteredCount = if profile then ItemCatalog.GetMasteredBiomeCount(profile.DiscoveredItems) else 0
    local masteryBanner = Instance.new("TextLabel")
    masteryBanner.Size = UDim2.new(1, -10, 0, 28)
    masteryBanner.BackgroundColor3 = UITheme.Colors.BgCard
    masteryBanner.Font = Enum.Font.GothamBold
    masteryBanner.TextSize = 13
    masteryBanner.TextColor3 = UITheme.Colors.Cyan
    masteryBanner.Text = string.format("🏆 BIOME MASTERY: %d/5 Biomes Complete (+%d%% Permanent Cash Bonus!)", masteredCount, masteredCount * 20)
    UITheme.AddCorner(masteryBanner, 8)
    masteryBanner.LayoutOrder = 2
    masteryBanner.Parent = bodyFrame

    -- Sort items with 0.01% Secrets & Impossible & Weekly first!
    local sorted = {}
    for _, def in ipairs(ItemCatalog.All) do
        table.insert(sorted, def)
    end
    table.sort(sorted, function(a, b)
        local ra = RarityConfig.Get(a.Rarity).Order
        local rb = RarityConfig.Get(b.Rarity).Order
        if ra ~= rb then
            return ra > rb
        end
        return a.BaseCashValue > b.BaseCashValue
    end)

    for idx, def in ipairs(sorted) do
        local rarity = RarityConfig.Get(def.Rarity)
        local foundCount = if profile then (profile.DiscoveredItems[def.Id] or 0) else 0
        local isSecretUndiscovered = (def.Rarity == "Secret" and foundCount == 0)

        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, -10, 0, 62)
        card.BackgroundColor3 = UITheme.Colors.BgCard
        UITheme.AddCorner(card, 9)
        UITheme.AddStroke(card, rarity.Color, if def.Rarity == "Secret" then 2 else 1.2)
        card.LayoutOrder = idx + 3
        card.Parent = bodyFrame

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0.7, 0, 0, 26)
        title.Position = UDim2.fromOffset(12, 6)
        title.BackgroundTransparency = 1
        title.Font = Enum.Font.GothamBlack
        title.TextSize = 15
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.TextColor3 = if foundCount > 0 then rarity.Color else UITheme.Colors.TextMuted
        local dispName = if isSecretUndiscovered then "??? [0.01% SECRET]" elseif lang == "tr" then def.NameTR else def.Name
        local weeklyPrefix = if def.IsWeekly then "[WEEKLY] " else ""
        title.Text = string.format("%s %s%s (%s)", if isSecretUndiscovered then "❓" else def.Icon, weeklyPrefix, dispName, rarity.DisplayName)
        title.Parent = card

        local sub = Instance.new("TextLabel")
        sub.Size = UDim2.new(0.95, 0, 0, 24)
        sub.Position = UDim2.fromOffset(12, 33)
        sub.BackgroundTransparency = 1
        sub.Font = Enum.Font.Gotham
        sub.TextSize = 12
        sub.TextXAlignment = Enum.TextXAlignment.Left
        sub.TextColor3 = UITheme.Colors.TextMuted
        sub.Text = if isSecretUndiscovered
            then "Biome: " .. def.BiomeId .. " — 0.01% Global Announcement on Discovery!"
            else (if lang == "tr" then def.DescriptionTR else def.Description)
        sub.Parent = card

        local status = Instance.new("TextLabel")
        status.Size = UDim2.fromOffset(115, 32)
        status.Position = UDim2.new(1, -125, 0, 14)
        status.BackgroundTransparency = 1
        status.Font = Enum.Font.GothamBold
        status.TextSize = 13
        status.TextXAlignment = Enum.TextXAlignment.Right
        status.TextColor3 = if foundCount > 0 then UITheme.Colors.Green else UITheme.Colors.TextMuted
        status.Text = if foundCount > 0 then ("Found ×" .. tostring(foundCount)) else "Undiscovered"
        status.Parent = card
    end
end

function CodexIndexController.Init(rootGui: ScreenGui)
    local panel, body, closeBtn = UITheme.CreateModal("CodexIndexModal", "✨ SECRET COLLECTION & ITEM CODEX", rootGui, UITheme.Colors.Cyan)
    modalPanel = panel
    bodyFrame = body
    closeBtn.MouseButton1Click:Connect(function()
        modalPanel.Visible = false
    end)
    HUDController.RegisterModal("Index", modalPanel, CodexIndexController.Refresh)
end

return CodexIndexController
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000002A">
  <Properties>
    <string name="Name">FlexVisitController</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Global Growth Feature #3: "FLEX YOUR BASE" Browser, Visit Teleport & Like System

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Remotes = require(Shared.Remotes)
local Localization = require(Shared.Localization)
local Utils = require(Shared.Utils)

local UITheme = require(script.Parent.UITheme)
local HUDController = require(script.Parent.HUDController)

local FlexVisitController = {}
local modalPanel: Frame
local bodyFrame: ScrollingFrame

local function clearChildren(parent: Instance)
    for _, ch in ipairs(parent:GetChildren()) do
        if ch:IsA("GuiObject") then
            ch:Destroy()
        end
    end
end

function FlexVisitController.Refresh()
    if not bodyFrame then
        return
    end
    clearChildren(bodyFrame)

    local lang = HUDController.GetLanguage()
    local ok, bases = pcall(function()
        return Remotes.GetFunction("GetServerBases"):InvokeServer()
    end)
    if not ok or type(bases) ~= "table" then
        return
    end

    for idx, b in ipairs(bases) do
        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, -10, 0, 96)
        card.BackgroundColor3 = UITheme.Colors.BgCard
        UITheme.AddCorner(card, 10)
        UITheme.AddStroke(card, if b.Vip then UITheme.Colors.Gold else UITheme.Colors.Purple, 1.5)
        card.LayoutOrder = idx
        card.Parent = bodyFrame

        local vipTag = if b.Vip then "👑 [VIP] " else ""
        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0.56, 0, 0, 30)
        title.Position = UDim2.fromOffset(14, 10)
        title.BackgroundTransparency = 1
        title.Font = Enum.Font.GothamBlack
        title.TextSize = 16
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.TextColor3 = if b.Vip then UITheme.Colors.Gold else UITheme.Colors.TextMain
        title.Text = string.format("%s%s  (Base #%d • Tier %d)", vipTag, tostring(b.PlayerName), b.Slot, b.BaseTier)
        title.Parent = card

        local sub = Instance.new("TextLabel")
        sub.Size = UDim2.new(0.56, 0, 0, 44)
        sub.Position = UDim2.fromOffset(14, 42)
        sub.BackgroundTransparency = 1
        sub.Font = Enum.Font.GothamMedium
        sub.TextSize = 13
        sub.TextWrapped = true
        sub.TextXAlignment = Enum.TextXAlignment.Left
        sub.TextColor3 = UITheme.Colors.TextMuted
        local shieldStr = if b.ShieldActive then "🛡️ Shielded" else "⚡ Unshielded"
        local riskStr = if b.HighStakesMode then string.format("  |  🔐 Safe: %s", Utils.FormatCash(b.UncollectedSafeCash or 0)) else ""
        sub.Text = string.format(
            "Net Worth: %s  |  Rarest: %s  |  ❤️ %d\n%s%s",
            Utils.FormatCash(b.NetWorth or 0),
            tostring(b.RarestItem or "None"),
            b.Likes or 0,
            shieldStr,
            riskStr
        )
        sub.Parent = card

        local visitBtn = UITheme.MakeButton({
            Text = Localization.Get("VISIT_BASE", lang),
            Size = UDim2.fromOffset(128, 38),
            Position = UDim2.new(1, -276, 0, 28),
            Color = UITheme.Colors.Cyan,
            TextColor = Color3.fromRGB(14, 18, 28),
            Parent = card,
            FontSize = 13,
        })
        visitBtn.MouseButton1Click:Connect(function()
            Remotes.GetEvent("RequestVisitBase"):FireServer(b.Slot)
            modalPanel.Visible = false
        end)

        local likeBtn = UITheme.MakeButton({
            Text = Localization.Get("LIKE_BASE", lang),
            Size = UDim2.fromOffset(128, 38),
            Position = UDim2.new(1, -138, 0, 28),
            Color = UITheme.Colors.Purple,
            Parent = card,
            FontSize = 13,
        })
        likeBtn.MouseButton1Click:Connect(function()
            Remotes.GetEvent("RequestLikeBase"):FireServer(b.UserId)
            task.delay(0.25, function()
                if modalPanel.Visible then
                    FlexVisitController.Refresh()
                end
            end)
        end)
    end
end

function FlexVisitController.Init(rootGui: ScreenGui)
    local panel, body, closeBtn = UITheme.CreateModal("FlexVisitModal", "✨ FLEX YOUR BASE — SERVER SHOWCASE", rootGui, UITheme.Colors.Purple)
    modalPanel = panel
    bodyFrame = body
    closeBtn.MouseButton1Click:Connect(function()
        modalPanel.Visible = false
    end)
    HUDController.RegisterModal("Flex", modalPanel, FlexVisitController.Refresh)
end

return FlexVisitController
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000002B">
  <Properties>
    <string name="Name">HUDController</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Primary Top HUD, Timers (15m Rift + 30m Apocalypse), Carry Banner, Bottom Navigation & Studio Test Panel

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Types = require(Shared.Types)
local BaseConfig = require(Shared.BaseConfig)
local MutationConfig = require(Shared.MutationConfig)
local Remotes = require(Shared.Remotes)
local Localization = require(Shared.Localization)
local Utils = require(Shared.Utils)

local UITheme = require(script.Parent.UITheme)
local SoundController = require(script.Parent.SoundController)

local HUDController = {}
HUDController._modals = {} :: { [string]: Frame }
HUDController._refreshHandlers = {} :: { [string]: () -> () }
HUDController._onLanguageChanged = {} :: { (Localization.LanguageCode) -> () }
HUDController.CurrentProfile = nil :: Types.PlayerProfile?
HUDController.CurrentNetWorth = 0
HUDController.CurrentIncomePerSec = 0
HUDController.CurrentBaseSlot = 1
HUDController.CurrentShieldRemaining = 0

local cashLbl: TextLabel
local incomeLbl: TextLabel
local worthLbl: TextLabel
local buffStripLbl: TextLabel
local riftTimerLbl: TextLabel
local worldTimerLbl: TextLabel
local carryBanner: Frame
local carryLabel: TextLabel
local carryCompassLbl: TextLabel
local langBtn: TextButton
local dockButtons: { [string]: { Btn: TextButton, Key: string } } = {}
local isCarryingNow = false
local carryingTitle = ""

function HUDController.GetLanguage(): Localization.LanguageCode
    if HUDController.CurrentProfile and HUDController.CurrentProfile.PreferredLanguage == "tr" then
        return "tr"
    end
    return "en"
end

function HUDController.RegisterModal(id: string, frame: Frame, onOpen: (() -> ())?)
    HUDController._modals[id] = frame
    if onOpen then
        HUDController._refreshHandlers[id] = onOpen
    end
end

function HUDController.ToggleModal(id: string)
    local target = HUDController._modals[id]
    if not target then
        return
    end
    local willOpen = not target.Visible
    for modalId, frame in pairs(HUDController._modals) do
        frame.Visible = (modalId == id and willOpen)
    end
    SoundController.Play("Click")
    if willOpen and HUDController._refreshHandlers[id] then
        HUDController._refreshHandlers[id]()
    end
end

function HUDController.CloseAllModals()
    for _, frame in pairs(HUDController._modals) do
        frame.Visible = false
    end
end

function HUDController.OnLanguageChange(cb: (Localization.LanguageCode) -> ())
    table.insert(HUDController._onLanguageChanged, cb)
end

local function refreshLabels()
    local lang = HUDController.GetLanguage()
    local p = HUDController.CurrentProfile
    if p then
        cashLbl.Text = string.format("💵 %s", Utils.FormatCash(p.Cash))
        incomeLbl.Text = string.format("+%s%s", Utils.FormatCash(HUDController.CurrentIncomePerSec), Localization.Get("INCOME_PER_SEC", lang))
        worthLbl.Text = string.format(
            "👑 %s: %s   |   ⚡ %s: %d",
            Localization.Get("NET_WORTH", lang),
            Utils.FormatCash(HUDController.CurrentNetWorth),
            Localization.Get("REBIRTH_COUNT", lang),
            p.Rebirths or 0
        )

        local buffs: { string } = {}
        local now = os.time()
        if (p.ActiveBuffs.LuckUntil or 0) > now then
            table.insert(buffs, string.format("🍀 2x Luck %s", Utils.FormatTime(p.ActiveBuffs.LuckUntil - now)))
        end
        if (p.ActiveBuffs.FeatherUntil or 0) > now then
            table.insert(buffs, string.format("🪶 Feather %s", Utils.FormatTime(p.ActiveBuffs.FeatherUntil - now)))
        end
        if (p.ActiveBuffs.ShadowCloakUntil or 0) > now then
            table.insert(buffs, string.format("🥷 Cloak %s", Utils.FormatTime(p.ActiveBuffs.ShadowCloakUntil - now)))
        end
        if HUDController.CurrentShieldRemaining > 0 then
            table.insert(buffs, string.format("🛡️ %ds", HUDController.CurrentShieldRemaining))
        end
        if p.HighStakesMode then
            table.insert(buffs, "🔥 2X SAFE RISK")
        end
        buffStripLbl.Text = if #buffs > 0 then table.concat(buffs, "  •  ") else ""
        buffStripLbl.Visible = #buffs > 0
    end
    langBtn.Text = if lang == "tr" then "🌐 TR" else "🌐 EN"

    for _, info in pairs(dockButtons) do
        info.Btn.Text = Localization.Get(info.Key, lang)
    end
end

function HUDController.ApplyState(payload: any)
    if type(payload) ~= "table" then
        return
    end
    if payload.Profile then
        HUDController.CurrentProfile = payload.Profile
    end
    if payload.NetWorth ~= nil then
        HUDController.CurrentNetWorth = payload.NetWorth
    end
    if payload.IncomePerSec ~= nil then
        HUDController.CurrentIncomePerSec = payload.IncomePerSec
    end
    if payload.BaseSlot ~= nil then
        HUDController.CurrentBaseSlot = payload.BaseSlot
    end
    if payload.ShieldRemaining ~= nil then
        HUDController.CurrentShieldRemaining = payload.ShieldRemaining
    end
    refreshLabels()

    for _, frame in pairs(HUDController._modals) do
        if frame.Visible then
            for id, f in pairs(HUDController._modals) do
                if f == frame and HUDController._refreshHandlers[id] then
                    HUDController._refreshHandlers[id]()
                end
            end
        end
    end
end

function HUDController.Init(rootGui: ScreenGui)
    -- Top Left Stats Pill
    local statsBar = Instance.new("Frame")
    statsBar.Name = "StatsBar"
    statsBar.Size = UDim2.new(0, 440, 0, 58)
    statsBar.Position = UDim2.fromOffset(14, 12)
    statsBar.BackgroundColor3 = UITheme.Colors.BgDark
    statsBar.BackgroundTransparency = 0.08
    statsBar.BorderSizePixel = 0
    UITheme.AddCorner(statsBar, 12)
    UITheme.AddStroke(statsBar, UITheme.Colors.Cyan, 1.6)
    statsBar.Parent = rootGui

    cashLbl = Instance.new("TextLabel")
    cashLbl.Size = UDim2.new(0.45, 0, 0.56, 0)
    cashLbl.Position = UDim2.fromOffset(12, 4)
    cashLbl.BackgroundTransparency = 1
    cashLbl.Font = Enum.Font.GothamBlack
    cashLbl.TextSize = 20
    cashLbl.TextXAlignment = Enum.TextXAlignment.Left
    cashLbl.TextColor3 = UITheme.Colors.Green
    cashLbl.Text = "💵 $250"
    cashLbl.Parent = statsBar

    incomeLbl = Instance.new("TextLabel")
    incomeLbl.Size = UDim2.new(0.48, 0, 0.45, 0)
    incomeLbl.Position = UDim2.new(0.48, 0, 0.08, 0)
    incomeLbl.BackgroundTransparency = 1
    incomeLbl.Font = Enum.Font.GothamBold
    incomeLbl.TextSize = 14
    incomeLbl.TextXAlignment = Enum.TextXAlignment.Right
    incomeLbl.TextColor3 = UITheme.Colors.Cyan
    incomeLbl.Text = "+$0/sec"
    incomeLbl.Parent = statsBar

    worthLbl = Instance.new("TextLabel")
    worthLbl.Size = UDim2.new(1, -24, 0.4, 0)
    worthLbl.Position = UDim2.fromOffset(12, 33)
    worthLbl.BackgroundTransparency = 1
    worthLbl.Font = Enum.Font.GothamBold
    worthLbl.TextSize = 13
    worthLbl.TextXAlignment = Enum.TextXAlignment.Left
    worthLbl.TextColor3 = UITheme.Colors.Gold
    worthLbl.Text = "👑 Net Worth: $250   |   ⚡ Rebirths: 0"
    worthLbl.Parent = statsBar

    buffStripLbl = Instance.new("TextLabel")
    buffStripLbl.Size = UDim2.new(0, 440, 0, 22)
    buffStripLbl.Position = UDim2.fromOffset(14, 73)
    buffStripLbl.BackgroundColor3 = UITheme.Colors.BgDark
    buffStripLbl.BackgroundTransparency = 0.15
    buffStripLbl.Font = Enum.Font.GothamBold
    buffStripLbl.TextSize = 11
    buffStripLbl.TextColor3 = UITheme.Colors.Cyan
    buffStripLbl.Visible = false
    UITheme.AddCorner(buffStripLbl, 8)
    buffStripLbl.Parent = rootGui

    -- Top Center Global Event Timers (15m Rift + 30m Apocalypse)
    local timerBar = Instance.new("Frame")
    timerBar.Name = "WorldTimersBar"
    timerBar.Size = UDim2.new(0, 420, 0, 54)
    timerBar.Position = UDim2.new(0.5, -210, 0, 12)
    timerBar.BackgroundColor3 = UITheme.Colors.BgDark
    timerBar.BackgroundTransparency = 0.08
    timerBar.BorderSizePixel = 0
    UITheme.AddCorner(timerBar, 12)
    UITheme.AddStroke(timerBar, UITheme.Colors.Purple, 1.5)
    timerBar.Parent = rootGui

    riftTimerLbl = Instance.new("TextLabel")
    riftTimerLbl.Size = UDim2.new(0.5, -10, 1, 0)
    riftTimerLbl.Position = UDim2.fromOffset(8, 0)
    riftTimerLbl.BackgroundTransparency = 1
    riftTimerLbl.Font = Enum.Font.GothamBold
    riftTimerLbl.TextSize = 13
    riftTimerLbl.TextWrapped = true
    riftTimerLbl.TextColor3 = UITheme.Colors.Cyan
    riftTimerLbl.Text = "🌀 RIFT IN 15:00"
    riftTimerLbl.Parent = timerBar

    worldTimerLbl = Instance.new("TextLabel")
    worldTimerLbl.Size = UDim2.new(0.5, -10, 1, 0)
    worldTimerLbl.Position = UDim2.new(0.5, 2, 0, 0)
    worldTimerLbl.BackgroundTransparency = 1
    worldTimerLbl.Font = Enum.Font.GothamBold
    worldTimerLbl.TextSize = 13
    worldTimerLbl.TextWrapped = true
    worldTimerLbl.TextColor3 = UITheme.Colors.Red
    worldTimerLbl.Text = "☄️ WORLD END 30:00"
    worldTimerLbl.Parent = timerBar

    -- Top Right EN/TR Language Toggle
    langBtn = UITheme.MakeButton({
        Text = "🌐 EN",
        Size = UDim2.fromOffset(86, 40),
        Position = UDim2.new(1, -100, 0, 16),
        Color = UITheme.Colors.BgCard,
        Parent = rootGui,
        FontSize = 14,
    })
    langBtn.MouseButton1Click:Connect(function()
        local nextLang: Localization.LanguageCode = if HUDController.GetLanguage() == "en" then "tr" else "en"
        Remotes.GetEvent("RequestSetLanguage"):FireServer(nextLang)
        if HUDController.CurrentProfile then
            HUDController.CurrentProfile.PreferredLanguage = nextLang
        end
        refreshLabels()
        for _, cb in ipairs(HUDController._onLanguageChanged) do
            cb(nextLang)
        end
    end)

    -- Carrying Relic Alert Banner + Live Waypoint Compass
    carryBanner = Instance.new("Frame")
    carryBanner.Name = "CarryAlertBanner"
    carryBanner.Size = UDim2.new(0.52, 0, 0, 56)
    carryBanner.Position = UDim2.fromScale(0.24, 0.78)
    carryBanner.BackgroundColor3 = Color3.fromRGB(28, 22, 12)
    carryBanner.Visible = false
    UITheme.AddCorner(carryBanner, 12)
    UITheme.AddStroke(carryBanner, UITheme.Colors.Gold, 2.2)
    carryBanner.Parent = rootGui

    carryLabel = Instance.new("TextLabel")
    carryLabel.Size = UDim2.new(1, -16, 0.56, 0)
    carryLabel.Position = UDim2.fromOffset(8, 2)
    carryLabel.BackgroundTransparency = 1
    carryLabel.Font = Enum.Font.GothamBlack
    carryLabel.TextScaled = true
    carryLabel.TextColor3 = UITheme.Colors.Gold
    carryLabel.Parent = carryBanner

    carryCompassLbl = Instance.new("TextLabel")
    carryCompassLbl.Size = UDim2.new(1, -16, 0.42, 0)
    carryCompassLbl.Position = UDim2.new(0, 8, 0.56, 0)
    carryCompassLbl.BackgroundTransparency = 1
    carryCompassLbl.Font = Enum.Font.GothamBold
    carryCompassLbl.TextSize = 13
    carryCompassLbl.TextColor3 = UITheme.Colors.Green
    carryCompassLbl.Text = "🧭 BASE COMPASS"
    carryCompassLbl.Parent = carryBanner

    -- Bottom Navigation Dock (8 Buttons including Quests/Codes/Rebirth & Trading!)
    local dock = Instance.new("Frame")
    dock.Name = "BottomNavDock"
    dock.Size = UDim2.new(0, 888, 0, 52)
    dock.Position = UDim2.new(0.5, -444, 1, -66)
    dock.BackgroundColor3 = UITheme.Colors.BgDark
    dock.BackgroundTransparency = 0.08
    dock.BorderSizePixel = 0
    UITheme.AddCorner(dock, 14)
    UITheme.AddStroke(dock, UITheme.Colors.Stroke, 1.5)
    dock.Parent = rootGui

    local dockLayout = Instance.new("UIListLayout")
    dockLayout.FillDirection = Enum.FillDirection.Horizontal
    dockLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    dockLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    dockLayout.Padding = UDim.new(0, 6)
    dockLayout.Parent = dock

    local navItems = {
        { Id = "Base", Key = "BASE_MENU", Color = UITheme.Colors.Green },
        { Id = "Flex", Key = "FLEX_MENU", Color = UITheme.Colors.Purple },
        { Id = "Quests", Key = "QUEST_MENU", Color = Color3.fromRGB(255, 110, 175) },
        { Id = "Trade", Key = "TRADE_MENU", Color = Color3.fromRGB(95, 220, 180) },
        { Id = "Shop", Key = "SHOP_MENU", Color = UITheme.Colors.Gold },
        { Id = "Index", Key = "INDEX_MENU", Color = UITheme.Colors.Cyan },
        { Id = "Squad", Key = "SQUAD_MENU", Color = Color3.fromRGB(255, 145, 55) },
        { Id = "Rank", Key = "RANK_MENU", Color = UITheme.Colors.BgHover },
    }
    for _, item in ipairs(navItems) do
        local btn = UITheme.MakeButton({
            Text = Localization.Get(item.Key, "en"),
            Size = UDim2.fromOffset(102, 38),
            Color = item.Color,
            TextColor = if item.Color == UITheme.Colors.Gold
                    or item.Color == UITheme.Colors.Cyan
                    or item.Color == UITheme.Colors.Green
                    or item.Color == Color3.fromRGB(95, 220, 180)
                then Color3.fromRGB(14, 18, 28)
                else UITheme.Colors.TextMain,
            Parent = dock,
            FontSize = 12,
        })
        btn.MouseButton1Click:Connect(function()
            HUDController.ToggleModal(item.Id)
        end)
        dockButtons[item.Id] = { Btn = btn, Key = item.Key }
    end

    -- Studio-Only Quick Test Toolbar so the creator can trigger every feature in 1 click during F5 Playtest!
    if RunService:IsStudio() then
        local testBar = Instance.new("Frame")
        testBar.Name = "StudioTestBar"
        testBar.Size = UDim2.fromOffset(168, 240)
        testBar.Position = UDim2.new(0, 14, 0, 102)
        testBar.BackgroundColor3 = UITheme.Colors.BgDark
        testBar.BackgroundTransparency = 0.15
        UITheme.AddCorner(testBar, 10)
        UITheme.AddStroke(testBar, UITheme.Colors.Gold, 1.2)
        testBar.Parent = rootGui

        local lay = Instance.new("UIListLayout")
        lay.Padding = UDim.new(0, 4)
        lay.HorizontalAlignment = Enum.HorizontalAlignment.Center
        lay.Parent = testBar

        local hdr = Instance.new("TextLabel")
        hdr.Size = UDim2.new(1, 0, 0, 22)
        hdr.BackgroundTransparency = 1
        hdr.Font = Enum.Font.GothamBlack
        hdr.TextSize = 11
        hdr.TextColor3 = UITheme.Colors.Gold
        hdr.Text = "STUDIO LIVE TEST"
        hdr.Parent = testBar

        local cmds = {
            { Label = "☄️ Test Meteor", Cmd = "/test meteor" },
            { Label = "🦖 Test Monster", Cmd = "/test monster" },
            { Label = "🪐 Test Zero-G", Cmd = "/test gravity" },
            { Label = "🌀 Open 15m Rift", Cmd = "/test rift" },
            { Label = "✨ Spawn 0.01% Secret", Cmd = "/test secret" },
            { Label = "🌟 Spawn Celestial", Cmd = "/test celestial" },
            { Label = "💵 +$100K Cash", Cmd = "/test cash 100000" },
        }
        for _, c in ipairs(cmds) do
            local tb = UITheme.MakeButton({
                Text = c.Label,
                Size = UDim2.fromOffset(148, 25),
                Color = UITheme.Colors.BgCard,
                Parent = testBar,
                FontSize = 11,
            })
            tb.MouseButton1Click:Connect(function()
                Remotes.GetEvent("RequestAdminCommand"):FireServer(c.Cmd)
            end)
        end
    end

    -- Listen to server timers & carry state
    Remotes.GetEvent("WorldTimerSync").OnClientEvent:Connect(function(timers)
        local lang = HUDController.GetLanguage()
        if timers.Rift then
            if timers.Rift.IsOpen then
                riftTimerLbl.Text = string.format("🌀 %s %s", Localization.Get("RIFT_ACTIVE", lang), Utils.FormatTime(timers.Rift.SecondsLeft))
            else
                riftTimerLbl.Text = string.format("🌀 %s %s", Localization.Get("RIFT_OPEN_IN", lang), Utils.FormatTime(timers.Rift.SecondsLeft))
            end
        end
        if timers.WorldEnding then
            if timers.WorldEnding.IsActive then
                worldTimerLbl.Text = string.format("🔥 %s (%s)", Localization.Get("WORLD_END_ACTIVE", lang), Utils.FormatTime(timers.WorldEnding.SecondsLeft))
            else
                worldTimerLbl.Text = string.format("☄️ %s %s", Localization.Get("WORLD_END_IN", lang), Utils.FormatTime(timers.WorldEnding.SecondsLeft))
            end
        end
    end)

    Remotes.GetEvent("CarryStateSync").OnClientEvent:Connect(function(info)
        local localPlayer = Players.LocalPlayer
        if info and info.UserId == localPlayer.UserId then
            if info.ItemId then
                isCarryingNow = true
                local lang = HUDController.GetLanguage()
                local name = if lang == "tr" and info.ItemNameTR then info.ItemNameTR else info.ItemName
                local mutPrefix = ""
                if info.Mutation and info.Mutation ~= "Normal" then
                    mutPrefix = "[" .. string.upper(MutationConfig.Get(info.Mutation).Prefix) .. "] "
                end
                carryingTitle = string.format("%s %s: %s%s — %s", tostring(info.Icon or "💎"), Localization.Get("CARRYING", lang), mutPrefix, tostring(name), Localization.Get("RUN_TO_BASE", lang))
                carryLabel.Text = carryingTitle
                carryBanner.Visible = true
            else
                isCarryingNow = false
                carryBanner.Visible = false
            end
        end
    end)

    -- Live Carry Compass distance update while carrying
    RunService.RenderStepped:Connect(function()
        if not isCarryingNow then
            return
        end
        local char = Players.LocalPlayer.Character
        local hrp = if char then char:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
        if hrp then
            local basePos = BaseConfig.GetSlotCFrame(HUDController.CurrentBaseSlot).Position
            local dist = math.floor((basePos - hrp.Position).Magnitude)
            local lang = HUDController.GetLanguage()
            carryCompassLbl.Text = string.format("🧭 %s: %d studs  (Base #%d)", Localization.Get("BASE_COMPASS", lang), dist, HUDController.CurrentBaseSlot)
        end
    end)

    -- Open Quests / Codes / Merchant / Rebirth modal when activating Plaza Kiosks
    ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
        if player ~= Players.LocalPlayer then
            return
        end
        local parent = prompt.Parent
        if parent and parent:GetAttribute("KioskPanel") then
            HUDController.ToggleModal("Quests")
        end
    end)

    Remotes.GetEvent("StateSync").OnClientEvent:Connect(HUDController.ApplyState)
end

return HUDController
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000002C">
  <Properties>
    <string name="Name">LeaderboardController</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Global Leaderboards UI (World Richest Net Worth, Most Stolen, 0.01% Secret Hunters)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Remotes = require(Shared.Remotes)
local Utils = require(Shared.Utils)

local UITheme = require(script.Parent.UITheme)
local HUDController = require(script.Parent.HUDController)

local LeaderboardController = {}
local modalPanel: Frame
local bodyFrame: ScrollingFrame
local activeCategory: "NetWorth" | "Steals" | "Secrets" = "NetWorth"

local function clearChildren(parent: Instance)
    for _, ch in ipairs(parent:GetChildren()) do
        if ch:IsA("GuiObject") then
            ch:Destroy()
        end
    end
end

function LeaderboardController.Refresh()
    if not bodyFrame then
        return
    end
    clearChildren(bodyFrame)

    -- Category Tab Bar
    local tabs = Instance.new("Frame")
    tabs.Size = UDim2.new(1, -10, 0, 42)
    tabs.BackgroundTransparency = 1
    tabs.LayoutOrder = 1
    tabs.Parent = bodyFrame

    local tl = Instance.new("UIListLayout")
    tl.FillDirection = Enum.FillDirection.Horizontal
    tl.Padding = UDim.new(0, 8)
    tl.Parent = tabs

    for _, tabDef in ipairs({
        { Key = "NetWorth", Label = "🏆 Richest (Net Worth)" },
        { Key = "Steals", Label = "⚡ Most Steals" },
        { Key = "Secrets", Label = "✨ Secret Hunters" },
    }) do
        local isSel = (activeCategory == tabDef.Key)
        local btn = UITheme.MakeButton({
            Text = tabDef.Label,
            Size = UDim2.fromOffset(180, 36),
            Color = if isSel then UITheme.Colors.Gold else UITheme.Colors.BgCard,
            TextColor = if isSel then Color3.fromRGB(14, 18, 28) else UITheme.Colors.TextMain,
            Parent = tabs,
            FontSize = 13,
        })
        btn.MouseButton1Click:Connect(function()
            activeCategory = tabDef.Key :: any
            LeaderboardController.Refresh()
        end)
    end

    local ok, data = pcall(function()
        return Remotes.GetFunction("GetLeaderboard"):InvokeServer()
    end)
    if not ok or type(data) ~= "table" then
        return
    end

    local rows = data[activeCategory] or {}
    for idx, entry in ipairs(rows) do
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -10, 0, 48)
        row.BackgroundColor3 = UITheme.Colors.BgCard
        UITheme.AddCorner(row, 9)
        UITheme.AddStroke(row, if entry.Rank == 1 then UITheme.Colors.Gold else UITheme.Colors.Stroke, 1.3)
        row.LayoutOrder = idx + 2
        row.Parent = bodyFrame

        local left = Instance.new("TextLabel")
        left.Size = UDim2.new(0.6, 0, 1, 0)
        left.Position = UDim2.fromOffset(14, 0)
        left.BackgroundTransparency = 1
        left.Font = Enum.Font.GothamBlack
        left.TextSize = 15
        left.TextXAlignment = Enum.TextXAlignment.Left
        left.TextColor3 = if entry.Rank <= 3 then UITheme.Colors.Gold else UITheme.Colors.TextMain
        left.Text = string.format("#%d   %s", entry.Rank, tostring(entry.Name))
        left.Parent = row

        local right = Instance.new("TextLabel")
        right.Size = UDim2.new(0.35, 0, 1, 0)
        right.Position = UDim2.new(0.62, 0, 0, 0)
        right.BackgroundTransparency = 1
        right.Font = Enum.Font.GothamBold
        right.TextSize = 15
        right.TextXAlignment = Enum.TextXAlignment.Right
        right.TextColor3 = UITheme.Colors.Cyan
        right.Text = if activeCategory == "NetWorth" then Utils.FormatCash(entry.Value) else tostring(entry.Value)
        right.Parent = row
    end
end

function LeaderboardController.Init(rootGui: ScreenGui)
    local panel, body, closeBtn = UITheme.CreateModal("LeaderboardModal", "🏆 GLOBAL LEADERBOARDS", rootGui, UITheme.Colors.Gold)
    modalPanel = panel
    bodyFrame = body
    closeBtn.MouseButton1Click:Connect(function()
        modalPanel.Visible = false
    end)
    HUDController.RegisterModal("Rank", modalPanel, LeaderboardController.Refresh)
end

return LeaderboardController
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000002D">
  <Properties>
    <string name="Name">NotificationController</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Live Feed Toasts, 0.01% Global Secret Announcement Banner & THE WORLD IS ENDING Warning Banner

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Remotes = require(Shared.Remotes)
local Localization = require(Shared.Localization)

local UITheme = require(script.Parent.UITheme)
local SoundController = require(script.Parent.SoundController)

local NotificationController = {}
NotificationController._feedFrame = nil :: Frame?
NotificationController._secretBanner = nil :: Frame?
NotificationController._worldBanner = nil :: Frame?
NotificationController._langGetter = function(): Localization.LanguageCode
    return "en"
end

function NotificationController.SetLanguageGetter(fn: () -> Localization.LanguageCode)
    NotificationController._langGetter = fn
end

function NotificationController.PushToast(text: string, accentColor: Color3?)
    local feed = NotificationController._feedFrame
    if not feed then
        return
    end

    local toast = Instance.new("Frame")
    toast.Size = UDim2.new(1, 0, 0, 34)
    toast.BackgroundColor3 = UITheme.Colors.BgDark
    toast.BackgroundTransparency = 0.14
    toast.BorderSizePixel = 0
    UITheme.AddCorner(toast, 8)
    UITheme.AddStroke(toast, accentColor or UITheme.Colors.Cyan, 1.5)
    toast.Parent = feed

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -14, 1, 0)
    lbl.Position = UDim2.fromOffset(7, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextTruncate = Enum.TextTruncate.AtEnd
    lbl.TextColor3 = UITheme.Colors.TextMain
    lbl.Text = text
    lbl.Parent = toast

    task.delay(4.5, function()
        if toast.Parent then
            local t = TweenService:Create(toast, TweenInfo.new(0.35), { BackgroundTransparency = 1 })
            t:Play()
            t.Completed:Wait()
            toast:Destroy()
        end
    end)
end

function NotificationController.ShowGlobalSecretBanner(payload: any)
    local banner = NotificationController._secretBanner
    if not banner then
        return
    end
    local lang = NotificationController._langGetter()
    local titleLbl = banner:FindFirstChild("Title") :: TextLabel?
    local msgLbl = banner:FindFirstChild("Msg") :: TextLabel?
    if titleLbl then
        titleLbl.Text = "✨ " .. Localization.Get("SECRET_BANNER_TITLE", lang) .. " ✨"
    end
    local itemName = if lang == "tr" and payload.ItemNameTR then payload.ItemNameTR else payload.ItemName
    if msgLbl then
        msgLbl.Text = string.format("%s  %s  →  %s", tostring(payload.Icon or "💎"), tostring(payload.PlayerName), tostring(itemName))
    end

    banner.Visible = true
    SoundController.Play("Secret")
    task.delay(7.0, function()
        if banner then
            banner.Visible = false
        end
    end)
end

function NotificationController.ShowWorldEndingBanner(active: boolean, eventType: string?)
    local wb = NotificationController._worldBanner
    if not wb then
        return
    end
    if not active then
        wb.Visible = false
        return
    end
    local lang = NotificationController._langGetter()
    local evKey = if eventType == "MeteorShower"
        then "EVENT_METEOR"
        elseif eventType == "GiantMonster" then "EVENT_MONSTER"
        else "EVENT_GRAVITY"
    local lbl = wb:FindFirstChild("Msg") :: TextLabel?
    if lbl then
        lbl.Text = "⚠️ " .. Localization.Get("WORLD_END_ACTIVE", lang) .. " — " .. Localization.Get(evKey, lang) .. " ⚠️"
    end
    wb.Visible = true
    SoundController.Play("Apocalypse")
end

function NotificationController.Init(rootGui: ScreenGui)
    -- Right-side live feed stack
    local feed = Instance.new("Frame")
    feed.Name = "LiveFeedStack"
    feed.Size = UDim2.new(0, 320, 0, 210)
    feed.Position = UDim2.new(1, -334, 0, 86)
    feed.BackgroundTransparency = 1
    feed.Parent = rootGui

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.VerticalAlignment = Enum.VerticalAlignment.Top
    layout.Parent = feed
    NotificationController._feedFrame = feed

    -- Dramatic Global Secret Announcement Banner
    local secret = Instance.new("Frame")
    secret.Name = "GlobalSecretBanner"
    secret.Size = UDim2.new(0.64, 0, 0, 84)
    secret.Position = UDim2.fromScale(0.18, 0.14)
    secret.BackgroundColor3 = Color3.fromRGB(14, 20, 34)
    secret.Visible = false
    secret.ZIndex = 45
    UITheme.AddCorner(secret, 14)
    UITheme.AddStroke(secret, UITheme.Colors.Gold, 3)
    secret.Parent = rootGui

    local sTitle = Instance.new("TextLabel")
    sTitle.Name = "Title"
    sTitle.Size = UDim2.new(1, -20, 0, 32)
    sTitle.Position = UDim2.fromOffset(10, 6)
    sTitle.BackgroundTransparency = 1
    sTitle.Font = Enum.Font.GothamBlack
    sTitle.TextScaled = true
    sTitle.TextColor3 = UITheme.Colors.Gold
    sTitle.ZIndex = 46
    sTitle.Parent = secret

    local sMsg = Instance.new("TextLabel")
    sMsg.Name = "Msg"
    sMsg.Size = UDim2.new(1, -20, 0, 38)
    sMsg.Position = UDim2.fromOffset(10, 40)
    sMsg.BackgroundTransparency = 1
    sMsg.Font = Enum.Font.GothamBlack
    sMsg.TextScaled = true
    sMsg.TextColor3 = UITheme.Colors.Cyan
    sMsg.ZIndex = 46
    sMsg.Parent = secret
    NotificationController._secretBanner = secret

    -- THE WORLD IS ENDING Warning Banner
    local worldBanner = Instance.new("Frame")
    worldBanner.Name = "WorldEndingBanner"
    worldBanner.Size = UDim2.new(0.54, 0, 0, 44)
    worldBanner.Position = UDim2.fromScale(0.23, 0.085)
    worldBanner.BackgroundColor3 = Color3.fromRGB(85, 12, 22)
    worldBanner.Visible = false
    worldBanner.ZIndex = 40
    UITheme.AddCorner(worldBanner, 10)
    UITheme.AddStroke(worldBanner, UITheme.Colors.Red, 2.2)
    worldBanner.Parent = rootGui

    local wMsg = Instance.new("TextLabel")
    wMsg.Name = "Msg"
    wMsg.Size = UDim2.new(1, -16, 1, 0)
    wMsg.Position = UDim2.fromOffset(8, 0)
    wMsg.BackgroundTransparency = 1
    wMsg.Font = Enum.Font.GothamBlack
    wMsg.TextScaled = true
    wMsg.TextColor3 = Color3.fromRGB(255, 235, 235)
    wMsg.ZIndex = 41
    wMsg.Parent = worldBanner
    NotificationController._worldBanner = worldBanner

    -- Listen to server broadcasts
    Remotes.GetEvent("GlobalSecretAnnouncement").OnClientEvent:Connect(function(payload)
        NotificationController.ShowGlobalSecretBanner(payload)
    end)

    Remotes.GetEvent("WorldEndingFX").OnClientEvent:Connect(function(payload)
        NotificationController.ShowWorldEndingBanner(payload.Active == true, payload.EventType)
    end)

    Remotes.GetEvent("FeedAnnouncement").OnClientEvent:Connect(function(ev)
        if type(ev) ~= "table" then
            return
        end
        local lang = NotificationController._langGetter()
        if ev.Type == "ItemStolenFromPlayer" then
            local iName = if lang == "tr" and ev.ItemNameTR then ev.ItemNameTR else ev.ItemName
            NotificationController.PushToast(string.format("%s %s STOLE %s from %s!", tostring(ev.Icon or "⚡"), ev.ThiefName, iName, ev.VictimName), UITheme.Colors.Red)
            SoundController.Play("Steal")
        elseif ev.Type == "ItemExtracted" then
            local iName = if lang == "tr" and ev.ItemNameTR then ev.ItemNameTR else ev.ItemName
            NotificationController.PushToast(string.format("%s %s secured %s!", tostring(ev.Icon or "✅"), ev.PlayerName, iName), UITheme.Colors.Green)
            SoundController.Play("Extract")
        elseif ev.Type == "HighRarityPickedUp" then
            local iName = if lang == "tr" and ev.ItemNameTR then ev.ItemNameTR else ev.ItemName
            NotificationController.PushToast(string.format("%s %s grabbed [%s] %s! CHASE THEM!", tostring(ev.Icon or "🔥"), ev.PlayerName, ev.Rarity, iName), UITheme.Colors.Gold)
            SoundController.Play("Pickup")
        elseif ev.Type == "SpecialRiftOpened" then
            local tName = if lang == "tr" and ev.ThemeNameTR then ev.ThemeNameTR else ev.ThemeName
            NotificationController.PushToast("🌀 15M SPECIAL RIFT OPEN: " .. tostring(tName) .. "!", UITheme.Colors.Cyan)
        elseif ev.Type == "HeistBreached" then
            NotificationController.PushToast(string.format("💰 BIG HEIST! %s & %s breached the Vault!", tostring(ev.PlayerA), tostring(ev.PlayerB)), UITheme.Colors.Gold)
        elseif ev.Type == "EggHatched" then
            local cName = if lang == "tr" and ev.CreatureNameTR then ev.CreatureNameTR else ev.CreatureName
            NotificationController.PushToast(string.format("%s %s hatched %s (%.2fx)!", tostring(ev.Icon or "🌌"), ev.PlayerName, cName, ev.Multiplier or 1), UITheme.Colors.Purple)
        elseif ev.Type == "BaseLiked" then
            NotificationController.PushToast(string.format("❤️ %s liked your Base! (+$%d)", tostring(ev.VisitorName), ev.Reward or 75), UITheme.Colors.Purple)
        elseif ev.Type == "BaseUpgrade" then
            NotificationController.PushToast(string.format("🏛️ %s upgraded Base to Tier %d!", tostring(ev.PlayerName), ev.Tier or 2), UITheme.Colors.Cyan)
        elseif ev.Type == "BaseRaided" then
            NotificationController.PushToast(string.format("🏴‍☠️ %s raided $%d from %s's Safe!", tostring(ev.RaiderName), ev.Amount or 0, tostring(ev.VictimName)), UITheme.Colors.Red)
        elseif ev.Type == "PlayerRebirth" then
            NotificationController.PushToast(string.format("⚡ %s ASCENDED to Rebirth %d!", tostring(ev.PlayerName), ev.Rebirths or 1), UITheme.Colors.Gold)
        end
    end)

    Remotes.GetEvent("ActionFeedback").OnClientEvent:Connect(function(res)
        if type(res) == "table" and res.Message then
            local color = if res.Success then UITheme.Colors.Green else UITheme.Colors.Red
            NotificationController.PushToast(tostring(res.Message), color)
            if res.Success then
                SoundController.Play("Extract")
            end
        end
    end)
end

return NotificationController
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000002E">
  <Properties>
    <string name="Name">QuestCodeController</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Daily Quests, Promo Code Terminal, Black-Market Merchant & Rebirth Ascension Modal UI

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local QuestAndCodeConfig = require(Shared.QuestAndCodeConfig)
local Remotes = require(Shared.Remotes)
local Localization = require(Shared.Localization)
local Utils = require(Shared.Utils)

local UITheme = require(script.Parent.UITheme)
local HUDController = require(script.Parent.HUDController)

local QuestCodeController = {}
local modalPanel: Frame
local bodyFrame: ScrollingFrame
local codeInputText = ""

local function clearChildren(parent: Instance)
    for _, ch in ipairs(parent:GetChildren()) do
        if ch:IsA("GuiObject") then
            ch:Destroy()
        end
    end
end

local function makeSectionHeader(text: string, color: Color3, order: number)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -10, 0, 26)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBlack
    lbl.TextSize = 15
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextColor3 = color
    lbl.Text = text
    lbl.LayoutOrder = order
    lbl.Parent = bodyFrame
end

function QuestCodeController.Refresh()
    if not bodyFrame then
        return
    end
    clearChildren(bodyFrame)

    local profile = HUDController.CurrentProfile
    local lang = HUDController.GetLanguage()
    if not profile then
        return
    end

    local order = 0
    local function nextOrder(): number
        order += 1
        return order
    end

    -- 1. PROMO CODE TERMINAL
    makeSectionHeader("🎟️ " .. Localization.Get("REDEEM_CODE", lang), UITheme.Colors.Gold, nextOrder())

    local codeCard = Instance.new("Frame")
    codeCard.Size = UDim2.new(1, -10, 0, 60)
    codeCard.BackgroundColor3 = UITheme.Colors.BgCard
    codeCard.LayoutOrder = nextOrder()
    UITheme.AddCorner(codeCard, 10)
    UITheme.AddStroke(codeCard, UITheme.Colors.Gold, 1.4)
    codeCard.Parent = bodyFrame

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0.66, -16, 0, 38)
    box.Position = UDim2.fromOffset(12, 11)
    box.BackgroundColor3 = UITheme.Colors.BgDark
    box.Font = Enum.Font.GothamBold
    box.TextSize = 15
    box.TextColor3 = UITheme.Colors.TextMain
    box.PlaceholderText = "IMPOSSIBLE / FROZENSUN / SECRET001..."
    box.Text = codeInputText
    box.ClearTextOnFocus = false
    UITheme.AddCorner(box, 8)
    box.Parent = codeCard
    box:GetPropertyChangedSignal("Text"):Connect(function()
        codeInputText = box.Text
    end)

    local redeemBtn = UITheme.MakeButton({
        Text = Localization.Get("REDEEM_CODE", lang),
        Size = UDim2.new(0.32, -8, 0, 38),
        Position = UDim2.new(0.68, 0, 0, 11),
        Color = UITheme.Colors.Gold,
        TextColor = Color3.fromRGB(14, 18, 28),
        Parent = codeCard,
        FontSize = 13,
    })
    redeemBtn.MouseButton1Click:Connect(function()
        if #box.Text > 0 then
            Remotes.GetEvent("RequestRedeemCode"):FireServer(box.Text)
            codeInputText = ""
            box.Text = ""
        end
    end)

    -- 2. DAILY QUESTS
    makeSectionHeader("🎯 " .. Localization.Get("DAILY_QUESTS", lang), Color3.fromRGB(255, 110, 175), nextOrder())

    for _, q in ipairs(QuestAndCodeConfig.DailyQuests) do
        local prog = (profile.QuestProgress :: any)[q.StatKey] or 0
        local claimed = profile.ClaimedQuests[q.Id] == true
        local ready = (not claimed) and prog >= q.Target

        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, -10, 0, 58)
        card.BackgroundColor3 = UITheme.Colors.BgCard
        card.LayoutOrder = nextOrder()
        UITheme.AddCorner(card, 10)
        UITheme.AddStroke(card, if claimed then UITheme.Colors.Green elseif ready then UITheme.Colors.Gold else UITheme.Colors.Stroke, 1.3)
        card.Parent = bodyFrame

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0.65, 0, 0, 26)
        title.Position = UDim2.fromOffset(12, 6)
        title.BackgroundTransparency = 1
        title.Font = Enum.Font.GothamBlack
        title.TextSize = 14
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.TextColor3 = UITheme.Colors.TextMain
        title.Text = string.format("%s  (%d/%d)", if lang == "tr" then q.TitleTR else q.Title, math.min(prog, q.Target), q.Target)
        title.Parent = card

        local sub = Instance.new("TextLabel")
        sub.Size = UDim2.new(0.65, 0, 0, 22)
        sub.Position = UDim2.fromOffset(12, 32)
        sub.BackgroundTransparency = 1
        sub.Font = Enum.Font.GothamMedium
        sub.TextSize = 12
        sub.TextXAlignment = Enum.TextXAlignment.Left
        sub.TextColor3 = UITheme.Colors.Green
        sub.Text = "Reward: +" .. Utils.FormatCash(q.RewardCash)
        sub.Parent = card

        local claimBtn = UITheme.MakeButton({
            Text = if claimed then Localization.Get("QUEST_CLAIMED", lang) elseif ready then Localization.Get("CLAIM_QUEST", lang) else string.format("%d/%d", prog, q.Target),
            Size = UDim2.fromOffset(145, 36),
            Position = UDim2.new(1, -158, 0, 11),
            Color = if claimed then UITheme.Colors.BgHover elseif ready then UITheme.Colors.Green else UITheme.Colors.BgDark,
            TextColor = if ready then Color3.fromRGB(14, 18, 28) else UITheme.Colors.TextMuted,
            Parent = card,
            FontSize = 12,
        })
        if ready then
            claimBtn.MouseButton1Click:Connect(function()
                Remotes.GetEvent("RequestClaimQuest"):FireServer(q.Id)
            end)
        end
    end

    -- 3. BLACK-MARKET MERCHANT
    makeSectionHeader("🧙 " .. Localization.Get("BLACK_MARKET", lang), UITheme.Colors.Purple, nextOrder())

    for _, item in ipairs(QuestAndCodeConfig.MerchantItems) do
        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, -10, 0, 62)
        card.BackgroundColor3 = UITheme.Colors.BgCard
        card.LayoutOrder = nextOrder()
        UITheme.AddCorner(card, 10)
        UITheme.AddStroke(card, UITheme.Colors.Purple, 1.3)
        card.Parent = bodyFrame

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0.66, 0, 0, 26)
        title.Position = UDim2.fromOffset(12, 6)
        title.BackgroundTransparency = 1
        title.Font = Enum.Font.GothamBlack
        title.TextSize = 14
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.TextColor3 = UITheme.Colors.Purple
        title.Text = string.format("%s %s", item.Icon, if lang == "tr" then item.NameTR else item.Name)
        title.Parent = card

        local desc = Instance.new("TextLabel")
        desc.Size = UDim2.new(0.66, 0, 0, 24)
        desc.Position = UDim2.fromOffset(12, 32)
        desc.BackgroundTransparency = 1
        desc.Font = Enum.Font.GothamMedium
        desc.TextSize = 12
        desc.TextXAlignment = Enum.TextXAlignment.Left
        desc.TextColor3 = UITheme.Colors.TextMuted
        desc.Text = if lang == "tr" then item.DescriptionTR else item.Description
        desc.Parent = card

        local canAfford = profile.Cash >= item.Cost
        local buyBtn = UITheme.MakeButton({
            Text = Utils.FormatCash(item.Cost),
            Size = UDim2.fromOffset(145, 36),
            Position = UDim2.new(1, -158, 0, 13),
            Color = if canAfford then UITheme.Colors.Purple else UITheme.Colors.BgHover,
            Parent = card,
            FontSize = 13,
        })
        buyBtn.MouseButton1Click:Connect(function()
            Remotes.GetEvent("RequestBuyMerchantItem"):FireServer(item.Id)
        end)
    end

    -- 4. REBIRTH / ASCENSION SHRINE
    local rebirths = profile.Rebirths or 0
    local rebirthCost = QuestAndCodeConfig.GetRebirthCost(rebirths)
    makeSectionHeader("⚡ " .. Localization.Get("REBIRTH_TITLE", lang), UITheme.Colors.Cyan, nextOrder())

    local rebCard = Instance.new("Frame")
    rebCard.Size = UDim2.new(1, -10, 0, 92)
    rebCard.BackgroundColor3 = UITheme.Colors.BgCard
    rebCard.LayoutOrder = nextOrder()
    UITheme.AddCorner(rebCard, 10)
    UITheme.AddStroke(rebCard, UITheme.Colors.Cyan, 1.8)
    rebCard.Parent = bodyFrame

    local rTitle = Instance.new("TextLabel")
    rTitle.Size = UDim2.new(0.62, 0, 0, 28)
    rTitle.Position = UDim2.fromOffset(12, 8)
    rTitle.BackgroundTransparency = 1
    rTitle.Font = Enum.Font.GothamBlack
    rTitle.TextSize = 16
    rTitle.TextXAlignment = Enum.TextXAlignment.Left
    rTitle.TextColor3 = UITheme.Colors.Cyan
    rTitle.Text = string.format("⚡ %s: %d  (+%d%% Income, +%d%% Luck)", Localization.Get("REBIRTH_COUNT", lang), rebirths, rebirths * 50, rebirths * 10)
    rTitle.Parent = rebCard

    local rDesc = Instance.new("TextLabel")
    rDesc.Size = UDim2.new(0.62, 0, 0, 48)
    rDesc.Position = UDim2.fromOffset(12, 38)
    rDesc.BackgroundTransparency = 1
    rDesc.Font = Enum.Font.GothamMedium
    rDesc.TextSize = 12
    rDesc.TextWrapped = true
    rDesc.TextXAlignment = Enum.TextXAlignment.Left
    rDesc.TextColor3 = UITheme.Colors.TextMuted
    rDesc.Text = Localization.Get("REBIRTH_DESC", lang)
    rDesc.Parent = rebCard

    local canRebirth = profile.Cash >= rebirthCost
    local rebBtn = UITheme.MakeButton({
        Text = string.format("⚡ %s\n(%s)", Localization.Get("REBIRTH_BUTTON", lang), Utils.FormatCash(rebirthCost)),
        Size = UDim2.fromOffset(180, 62),
        Position = UDim2.new(1, -194, 0, 15),
        Color = if canRebirth then UITheme.Colors.Cyan else UITheme.Colors.BgHover,
        TextColor = if canRebirth then Color3.fromRGB(14, 18, 28) else UITheme.Colors.TextMuted,
        Parent = rebCard,
        FontSize = 13,
    })
    rebBtn.MouseButton1Click:Connect(function()
        Remotes.GetEvent("RequestRebirth"):FireServer()
    end)
end

function QuestCodeController.Init(rootGui: ScreenGui)
    local panel, body, closeBtn = UITheme.CreateModal("QuestCodeModal", "🎯 QUESTS, CODES, MERCHANT & REBIRTH", rootGui, Color3.fromRGB(255, 110, 175))
    modalPanel = panel
    bodyFrame = body
    closeBtn.MouseButton1Click:Connect(function()
        modalPanel.Visible = false
    end)
    HUDController.RegisterModal("Quests", modalPanel, QuestCodeController.Refresh)
end

return QuestCodeController
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000002F">
  <Properties>
    <string name="Name">ShopCosmeticController</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Shop & Style Modal:
--   * 100% F2P Cash Upgrades & Gadgets
--   * Ethical Cosmetic-Only Robux Shop (99, 149, 49, 199, 79, 299 Robux)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local BaseConfig = require(Shared.BaseConfig)
local CosmeticCatalog = require(Shared.CosmeticCatalog)
local Remotes = require(Shared.Remotes)
local Localization = require(Shared.Localization)
local Utils = require(Shared.Utils)

local UITheme = require(script.Parent.UITheme)
local HUDController = require(script.Parent.HUDController)

local ShopCosmeticController = {}
local modalPanel: Frame
local bodyFrame: ScrollingFrame

local function clearChildren(parent: Instance)
    for _, ch in ipairs(parent:GetChildren()) do
        if ch:IsA("GuiObject") then
            ch:Destroy()
        end
    end
end

local function makeSectionHeader(text: string, color: Color3, order: number)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -10, 0, 30)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBlack
    lbl.TextSize = 15
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextColor3 = color
    lbl.Text = text
    lbl.LayoutOrder = order
    lbl.Parent = bodyFrame
end

function ShopCosmeticController.Refresh()
    if not bodyFrame then
        return
    end
    clearChildren(bodyFrame)

    local profile = HUDController.CurrentProfile
    local lang = HUDController.GetLanguage()
    if not profile then
        return
    end

    local order = 1

    -- Ethical Zero Pay-To-Win Banner
    makeSectionHeader("🛡️ " .. Localization.Get("NO_P2W_BADGE", lang), UITheme.Colors.Green, order)
    order += 1

    -- Section 1: F2P Cash Tech Upgrades
    makeSectionHeader("⚙️ CASH UPGRADES (EARNED IN-GAME)", UITheme.Colors.Cyan, order)
    order += 1

    for _, tech in ipairs(BaseConfig.TechUpgrades) do
        local lvl = profile.TechLevels[tech.Id] or 0
        local nextCost = BaseConfig.GetTechCost(tech.Id, lvl)

        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, -10, 0, 70)
        card.BackgroundColor3 = UITheme.Colors.BgCard
        UITheme.AddCorner(card, 10)
        UITheme.AddStroke(card, UITheme.Colors.Cyan, 1.3)
        card.LayoutOrder = order
        order += 1
        card.Parent = bodyFrame

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0.65, 0, 0, 26)
        title.Position = UDim2.fromOffset(12, 8)
        title.BackgroundTransparency = 1
        title.Font = Enum.Font.GothamBold
        title.TextSize = 15
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.TextColor3 = UITheme.Colors.TextMain
        title.Text = string.format("%s  [Lv %d/%d]", if lang == "tr" then tech.NameTR else tech.Name, lvl, tech.MaxLevel)
        title.Parent = card

        local desc = Instance.new("TextLabel")
        desc.Size = UDim2.new(0.65, 0, 0, 28)
        desc.Position = UDim2.fromOffset(12, 36)
        desc.BackgroundTransparency = 1
        desc.Font = Enum.Font.Gotham
        desc.TextSize = 12
        desc.TextWrapped = true
        desc.TextXAlignment = Enum.TextXAlignment.Left
        desc.TextColor3 = UITheme.Colors.TextMuted
        desc.Text = if lang == "tr" then tech.DescriptionTR else tech.Description
        desc.Parent = card

        local btnText = if nextCost then Utils.FormatCash(nextCost) else "MAX"
        local btn = UITheme.MakeButton({
            Text = btnText,
            Size = UDim2.fromOffset(135, 42),
            Position = UDim2.new(1, -148, 0, 14),
            Color = if nextCost and profile.Cash >= nextCost then UITheme.Colors.Cyan else UITheme.Colors.BgHover,
            TextColor = if nextCost and profile.Cash >= nextCost then Color3.fromRGB(14, 18, 28) else UITheme.Colors.TextMuted,
            Parent = card,
            FontSize = 14,
        })
        btn.MouseButton1Click:Connect(function()
            Remotes.GetEvent("RequestUpgradeTech"):FireServer(tech.Id)
        end)
    end

    -- Section 2: F2P Cash Gadgets
    makeSectionHeader("⚡ UTILITY GADGETS (CASH)", UITheme.Colors.Green, order)
    order += 1

    for _, gadget in ipairs(BaseConfig.Gadgets) do
        local owned = profile.OwnedGadgets[gadget.Id] == true
        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, -10, 0, 70)
        card.BackgroundColor3 = UITheme.Colors.BgCard
        UITheme.AddCorner(card, 10)
        UITheme.AddStroke(card, UITheme.Colors.Green, 1.3)
        card.LayoutOrder = order
        order += 1
        card.Parent = bodyFrame

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0.65, 0, 0, 26)
        title.Position = UDim2.fromOffset(12, 8)
        title.BackgroundTransparency = 1
        title.Font = Enum.Font.GothamBold
        title.TextSize = 15
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.TextColor3 = UITheme.Colors.TextMain
        title.Text = string.format("%s %s", gadget.Icon, if lang == "tr" then gadget.NameTR else gadget.Name)
        title.Parent = card

        local desc = Instance.new("TextLabel")
        desc.Size = UDim2.new(0.65, 0, 0, 28)
        desc.Position = UDim2.fromOffset(12, 36)
        desc.BackgroundTransparency = 1
        desc.Font = Enum.Font.Gotham
        desc.TextSize = 12
        desc.TextWrapped = true
        desc.TextXAlignment = Enum.TextXAlignment.Left
        desc.TextColor3 = UITheme.Colors.TextMuted
        desc.Text = if lang == "tr" then gadget.DescriptionTR else gadget.Description
        desc.Parent = card

        local btn = UITheme.MakeButton({
            Text = if owned then Localization.Get("OWNED", lang) else Utils.FormatCash(gadget.Cost),
            Size = UDim2.fromOffset(135, 42),
            Position = UDim2.new(1, -148, 0, 14),
            Color = if owned then UITheme.Colors.BgHover elseif profile.Cash >= gadget.Cost then UITheme.Colors.Green else UITheme.Colors.BgHover,
            TextColor = if not owned and profile.Cash >= gadget.Cost then Color3.fromRGB(14, 18, 28) else UITheme.Colors.TextMain,
            Parent = card,
            FontSize = 14,
        })
        btn.MouseButton1Click:Connect(function()
            if not owned then
                Remotes.GetEvent("RequestBuyGadget"):FireServer(gadget.Id)
            end
        end)
    end

    -- Section 3: Robux Cosmetic Storefront (99, 149, 49, 199, 79, 299 Robux)
    makeSectionHeader("💎 ROBUX COSMETICS (STYLE & FLEX ONLY)", UITheme.Colors.Gold, order)
    order += 1

    for _, prod in ipairs(CosmeticCatalog.Products) do
        local owned = profile.OwnedProducts[prod.Id] == true
        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, -10, 0, 78)
        card.BackgroundColor3 = UITheme.Colors.BgCard
        UITheme.AddCorner(card, 10)
        UITheme.AddStroke(card, prod.BadgeColor, 1.6)
        card.LayoutOrder = order
        order += 1
        card.Parent = bodyFrame

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0.65, 0, 0, 26)
        title.Position = UDim2.fromOffset(12, 8)
        title.BackgroundTransparency = 1
        title.Font = Enum.Font.GothamBlack
        title.TextSize = 15
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.TextColor3 = prod.BadgeColor
        title.Text = if lang == "tr" then prod.NameTR else prod.Name
        title.Parent = card

        local desc = Instance.new("TextLabel")
        desc.Size = UDim2.new(0.65, 0, 0, 34)
        desc.Position = UDim2.fromOffset(12, 36)
        desc.BackgroundTransparency = 1
        desc.Font = Enum.Font.Gotham
        desc.TextSize = 12
        desc.TextWrapped = true
        desc.TextXAlignment = Enum.TextXAlignment.Left
        desc.TextColor3 = UITheme.Colors.TextMuted
        desc.Text = if lang == "tr" then prod.DescriptionTR else prod.Description
        desc.Parent = card

        local buyBtn = UITheme.MakeButton({
            Text = if owned then ("✓ " .. Localization.Get("OWNED", lang)) else ("R$ " .. tostring(prod.RobuxPrice)),
            Size = UDim2.fromOffset(135, 44),
            Position = UDim2.new(1, -148, 0, 17),
            Color = if owned then UITheme.Colors.Green else UITheme.Colors.Gold,
            TextColor = Color3.fromRGB(14, 18, 28),
            Parent = card,
            FontSize = 15,
        })
        buyBtn.MouseButton1Click:Connect(function()
            if not owned then
                Remotes.GetEvent("RequestPromptProduct"):FireServer(prod.Id)
            end
        end)
    end

    -- Section 4: Equip Owned Cosmetics
    makeSectionHeader("🎨 EQUIP OWNED COSMETICS", UITheme.Colors.Purple, order)
    order += 1

    for _, asset in ipairs(CosmeticCatalog.Assets) do
        if CosmeticCatalog.PlayerOwnsAsset(profile.OwnedProducts, asset.Id) then
            local isEquipped =
                profile.EquippedCosmetics.CharacterSkin == asset.Id
                or profile.EquippedCosmetics.BaseDesign == asset.Id
                or profile.EquippedCosmetics.AnimationPack == asset.Id
                or profile.EquippedCosmetics.PetSkin == asset.Id
                or (asset.Category == "VipTag" and profile.EquippedCosmetics.VipTagEnabled)

            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, -10, 0, 52)
            row.BackgroundColor3 = UITheme.Colors.BgCard
            UITheme.AddCorner(row, 8)
            UITheme.AddStroke(row, asset.SecondaryColor, 1.2)
            row.LayoutOrder = order
            order += 1
            row.Parent = bodyFrame

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(0.68, 0, 1, 0)
            lbl.Position = UDim2.fromOffset(12, 0)
            lbl.BackgroundTransparency = 1
            lbl.Font = Enum.Font.GothamBold
            lbl.TextSize = 14
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.TextColor3 = UITheme.Colors.TextMain
            lbl.Text = string.format("[%s] %s", asset.Category, if lang == "tr" then asset.NameTR else asset.Name)
            lbl.Parent = row

            local eqBtn = UITheme.MakeButton({
                Text = if isEquipped then Localization.Get("EQUIPPED", lang) else Localization.Get("EQUIP", lang),
                Size = UDim2.fromOffset(118, 34),
                Position = UDim2.new(1, -130, 0, 9),
                Color = if isEquipped then UITheme.Colors.Purple else UITheme.Colors.BgHover,
                Parent = row,
                FontSize = 13,
            })
            eqBtn.MouseButton1Click:Connect(function()
                Remotes.GetEvent("RequestEquipCosmetic"):FireServer(asset.Id)
            end)
        end
    end
end

function ShopCosmeticController.Init(rootGui: ScreenGui)
    local panel, body, closeBtn = UITheme.CreateModal("ShopCosmeticModal", "🛒 SHOP & COSMETIC STYLE", rootGui, UITheme.Colors.Gold)
    modalPanel = panel
    bodyFrame = body
    closeBtn.MouseButton1Click:Connect(function()
        modalPanel.Visible = false
    end)
    HUDController.RegisterModal("Shop", modalPanel, ShopCosmeticController.Refresh)
end

return ShopCosmeticController
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000030">
  <Properties>
    <string name="Name">SoundController</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Client Sound Effects Controller (Zero external missing-asset errors: uses safe Roblox Sound instances)

local SoundService = game:GetService("SoundService")

local SoundController = {}

local SOUND_IDS = {
    Pickup = "rbxassetid://9120386436",
    Steal = "rbxassetid://9119713951",
    Extract = "rbxassetid://9125402735",
    Secret = "rbxassetid://9125402735",
    Apocalypse = "rbxassetid://9114221890",
    Click = "rbxassetid://9119713951",
}

local function playOneShot(soundId: string, volume: number, pitch: number?)
    local s = Instance.new("Sound")
    s.SoundId = soundId
    s.Volume = volume
    s.PlaybackSpeed = pitch or 1.0
    s.Parent = SoundService
    s:Play()
    s.Ended:Connect(function()
        s:Destroy()
    end)
    task.delay(4, function()
        if s.Parent then
            s:Destroy()
        end
    end)
end

function SoundController.Play(key: string)
    local id = SOUND_IDS[key]
    if not id then
        return
    end
    local vol = if key == "Secret" or key == "Apocalypse" then 0.65 else 0.4
    local pitch = if key == "Secret" then 1.15 elseif key == "Click" then 1.35 else 1.0
    pcall(function()
        playOneShot(id, vol, pitch)
    end)
end

return SoundController
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000031">
  <Properties>
    <string name="Name">SquadHeistController</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Squad / Team Party & Co-op Big Heist UI + Squad Invite Popup

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Remotes = require(Shared.Remotes)
local Localization = require(Shared.Localization)

local UITheme = require(script.Parent.UITheme)
local HUDController = require(script.Parent.HUDController)

local SquadHeistController = {}
local modalPanel: Frame
local bodyFrame: ScrollingFrame
local currentSquad: any = nil
local inviteBanner: Frame
local pendingSquadId: string? = nil

local function clearChildren(parent: Instance)
    for _, ch in ipairs(parent:GetChildren()) do
        if ch:IsA("GuiObject") then
            ch:Destroy()
        end
    end
end

function SquadHeistController.Refresh()
    if not bodyFrame then
        return
    end
    clearChildren(bodyFrame)

    local lang = HUDController.GetLanguage()

    -- Instructions for Big Heist Vault
    local info = Instance.new("TextLabel")
    info.Size = UDim2.new(1, -10, 0, 56)
    info.BackgroundColor3 = UITheme.Colors.BgCard
    info.Font = Enum.Font.GothamBold
    info.TextSize = 13
    info.TextWrapped = true
    info.TextColor3 = UITheme.Colors.Gold
    info.Text = "💰 BIG HEIST VAULT: Team up with 2–4 friends, head to the Vault behind Plaza, and stand on BOTH glowing Lock Plates simultaneously to crack the Titan Bank Core!"
    UITheme.AddCorner(info, 8)
    info.LayoutOrder = 1
    info.Parent = bodyFrame

    if not currentSquad then
        local createBtn = UITheme.MakeButton({
            Text = "🤝 " .. Localization.Get("CREATE_SQUAD", lang),
            Size = UDim2.new(1, -10, 0, 44),
            Color = UITheme.Colors.Green,
            TextColor = Color3.fromRGB(14, 18, 28),
            Parent = bodyFrame,
            FontSize = 15,
        })
        createBtn.LayoutOrder = 2
        createBtn.MouseButton1Click:Connect(function()
            Remotes.GetEvent("RequestCreateSquad"):FireServer()
        end)
    else
        local leaveBtn = UITheme.MakeButton({
            Text = Localization.Get("LEAVE_SQUAD", lang),
            Size = UDim2.new(1, -10, 0, 38),
            Color = UITheme.Colors.Red,
            Parent = bodyFrame,
            FontSize = 14,
        })
        leaveBtn.LayoutOrder = 2
        leaveBtn.MouseButton1Click:Connect(function()
            Remotes.GetEvent("RequestLeaveSquad"):FireServer()
        end)

        for idx, member in ipairs(currentSquad.Members or {}) do
            local row = Instance.new("TextLabel")
            row.Size = UDim2.new(1, -10, 0, 34)
            row.BackgroundColor3 = UITheme.Colors.BgCard
            row.Font = Enum.Font.GothamBold
            row.TextSize = 14
            row.TextColor3 = if member.IsLeader then UITheme.Colors.Gold else UITheme.Colors.TextMain
            row.Text = string.format("   %s %s", if member.IsLeader then "👑" else "🛡️", tostring(member.Name))
            row.TextXAlignment = Enum.TextXAlignment.Left
            UITheme.AddCorner(row, 8)
            row.LayoutOrder = 10 + idx
            row.Parent = bodyFrame
        end
    end

    -- Online players list to invite
    local order = 30
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Players.LocalPlayer then
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, -10, 0, 46)
            row.BackgroundColor3 = UITheme.Colors.BgCard
            UITheme.AddCorner(row, 8)
            row.LayoutOrder = order
            order += 1
            row.Parent = bodyFrame

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(0.65, 0, 1, 0)
            nameLbl.Position = UDim2.fromOffset(12, 0)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Font = Enum.Font.GothamBold
            nameLbl.TextSize = 14
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.TextColor3 = UITheme.Colors.TextMain
            nameLbl.Text = plr.Name
            nameLbl.Parent = row

            local invBtn = UITheme.MakeButton({
                Text = Localization.Get("INVITE", lang),
                Size = UDim2.fromOffset(110, 32),
                Position = UDim2.new(1, -122, 0, 7),
                Color = UITheme.Colors.Cyan,
                TextColor = Color3.fromRGB(14, 18, 28),
                Parent = row,
                FontSize = 13,
            })
            invBtn.MouseButton1Click:Connect(function()
                Remotes.GetEvent("RequestInviteSquad"):FireServer(plr.UserId)
            end)
        end
    end
end

function SquadHeistController.Init(rootGui: ScreenGui)
    local panel, body, closeBtn = UITheme.CreateModal("SquadHeistModal", "🤝 SQUAD & CO-OP BIG HEIST", rootGui, Color3.fromRGB(255, 145, 55))
    modalPanel = panel
    bodyFrame = body
    closeBtn.MouseButton1Click:Connect(function()
        modalPanel.Visible = false
    end)
    HUDController.RegisterModal("Squad", modalPanel, SquadHeistController.Refresh)

    -- Incoming Squad Invite Popup
    inviteBanner = Instance.new("Frame")
    inviteBanner.Name = "SquadInvitePopup"
    inviteBanner.Size = UDim2.fromOffset(310, 88)
    inviteBanner.Position = UDim2.new(0.5, -155, 0, 74)
    inviteBanner.BackgroundColor3 = UITheme.Colors.BgDark
    inviteBanner.Visible = false
    inviteBanner.ZIndex = 35
    UITheme.AddCorner(inviteBanner, 12)
    UITheme.AddStroke(inviteBanner, UITheme.Colors.Green, 2)
    inviteBanner.Parent = rootGui

    local invTitle = Instance.new("TextLabel")
    invTitle.Name = "Title"
    invTitle.Size = UDim2.new(1, -16, 0, 34)
    invTitle.Position = UDim2.fromOffset(8, 6)
    invTitle.BackgroundTransparency = 1
    invTitle.Font = Enum.Font.GothamBold
    invTitle.TextSize = 14
    invTitle.TextColor3 = UITheme.Colors.TextMain
    invTitle.ZIndex = 36
    invTitle.Parent = inviteBanner

    local accBtn = UITheme.MakeButton({
        Text = "✓ Accept",
        Size = UDim2.fromOffset(130, 34),
        Position = UDim2.fromOffset(14, 46),
        Color = UITheme.Colors.Green,
        TextColor = Color3.fromRGB(14, 18, 28),
        Parent = inviteBanner,
        FontSize = 13,
    })
    accBtn.ZIndex = 36
    accBtn.MouseButton1Click:Connect(function()
        if pendingSquadId then
            Remotes.GetEvent("RequestAcceptSquad"):FireServer(pendingSquadId)
        end
        inviteBanner.Visible = false
    end)

    local decBtn = UITheme.MakeButton({
        Text = "✕ Decline",
        Size = UDim2.fromOffset(130, 34),
        Position = UDim2.fromOffset(162, 46),
        Color = UITheme.Colors.Red,
        Parent = inviteBanner,
        FontSize = 13,
    })
    decBtn.ZIndex = 36
    decBtn.MouseButton1Click:Connect(function()
        inviteBanner.Visible = false
    end)

    Remotes.GetEvent("SquadStateSync").OnClientEvent:Connect(function(sq)
        currentSquad = sq
        if modalPanel.Visible then
            SquadHeistController.Refresh()
        end
    end)

    Remotes.GetEvent("SquadInvitePrompt").OnClientEvent:Connect(function(payload)
        if type(payload) ~= "table" then
            return
        end
        pendingSquadId = payload.SquadId
        invTitle.Text = string.format("🤝 %s invited you to Squad!", tostring(payload.LeaderName))
        inviteBanner.Visible = true
    end)
end

return SquadHeistController
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000032">
  <Properties>
    <string name="Name">TradeController</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Atomic P2P Safe Trading UI Controller

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local ItemCatalog = require(Shared.ItemCatalog)
local MutationConfig = require(Shared.MutationConfig)
local Remotes = require(Shared.Remotes)
local Localization = require(Shared.Localization)
local Utils = require(Shared.Utils)

local UITheme = require(script.Parent.UITheme)
local HUDController = require(script.Parent.HUDController)

local TradeController = {}
local modalPanel: Frame
local bodyFrame: ScrollingFrame
local currentTrade: any = nil
local pendingInvite: { FromUserId: number, FromName: string }? = nil
local selectedUids: { [string]: boolean } = {}
local offerCashValue = 0

local function clearChildren(parent: Instance)
    for _, ch in ipairs(parent:GetChildren()) do
        if ch:IsA("GuiObject") then
            ch:Destroy()
        end
    end
end

local function pushOfferUpdate()
    local list: { string } = {}
    for uid, on in pairs(selectedUids) do
        if on then
            table.insert(list, uid)
        end
    end
    Remotes.GetEvent("RequestUpdateTradeOffer"):FireServer(list, offerCashValue)
end

function TradeController.Refresh()
    if not bodyFrame then
        return
    end
    clearChildren(bodyFrame)

    local lang = HUDController.GetLanguage()
    local profile = HUDController.CurrentProfile
    local localUserId = Players.LocalPlayer.UserId

    -- Pending incoming invite banner inside Trade modal
    if pendingInvite and not currentTrade then
        local invCard = Instance.new("Frame")
        invCard.Size = UDim2.new(1, -10, 0, 62)
        invCard.BackgroundColor3 = UITheme.Colors.BgCard
        UITheme.AddCorner(invCard, 10)
        UITheme.AddStroke(invCard, UITheme.Colors.Gold, 1.8)
        invCard.Parent = bodyFrame

        local invLbl = Instance.new("TextLabel")
        invLbl.Size = UDim2.new(0.58, 0, 1, 0)
        invLbl.Position = UDim2.fromOffset(12, 0)
        invLbl.BackgroundTransparency = 1
        invLbl.Font = Enum.Font.GothamBlack
        invLbl.TextSize = 14
        invLbl.TextXAlignment = Enum.TextXAlignment.Left
        invLbl.TextColor3 = UITheme.Colors.Gold
        invLbl.Text = string.format("🤝 %s invited you to Trade!", pendingInvite.FromName)
        invLbl.Parent = invCard

        local fromId = pendingInvite.FromUserId
        local accBtn = UITheme.MakeButton({
            Text = "Accept",
            Size = UDim2.fromOffset(105, 36),
            Position = UDim2.new(1, -222, 0, 13),
            Color = UITheme.Colors.Green,
            TextColor = Color3.fromRGB(14, 18, 28),
            Parent = invCard,
            FontSize = 13,
        })
        accBtn.MouseButton1Click:Connect(function()
            pendingInvite = nil
            Remotes.GetEvent("RequestRespondTrade"):FireServer(fromId, true)
        end)

        local decBtn = UITheme.MakeButton({
            Text = "Decline",
            Size = UDim2.fromOffset(100, 36),
            Position = UDim2.new(1, -112, 0, 13),
            Color = UITheme.Colors.Red,
            Parent = invCard,
            FontSize = 13,
        })
        decBtn.MouseButton1Click:Connect(function()
            pendingInvite = nil
            Remotes.GetEvent("RequestRespondTrade"):FireServer(fromId, false)
            TradeController.Refresh()
        end)
    end

    if not currentTrade then
        -- Player Picker to send Trade Requests
        local hint = Instance.new("TextLabel")
        hint.Size = UDim2.new(1, -10, 0, 28)
        hint.BackgroundTransparency = 1
        hint.Font = Enum.Font.GothamBold
        hint.TextSize = 14
        hint.TextXAlignment = Enum.TextXAlignment.Left
        hint.TextColor3 = UITheme.Colors.Cyan
        hint.Text = "🤝 " .. Localization.Get("SEND_TRADE", lang)
        hint.Parent = bodyFrame

        for _, p in ipairs(Players:GetPlayers()) do
            if p.UserId ~= localUserId then
                local row = Instance.new("Frame")
                row.Size = UDim2.new(1, -10, 0, 52)
                row.BackgroundColor3 = UITheme.Colors.BgCard
                UITheme.AddCorner(row, 10)
                UITheme.AddStroke(row, UITheme.Colors.Stroke, 1.2)
                row.Parent = bodyFrame

                local nameLbl = Instance.new("TextLabel")
                nameLbl.Size = UDim2.new(0.65, 0, 1, 0)
                nameLbl.Position = UDim2.fromOffset(12, 0)
                nameLbl.BackgroundTransparency = 1
                nameLbl.Font = Enum.Font.GothamBlack
                nameLbl.TextSize = 15
                nameLbl.TextXAlignment = Enum.TextXAlignment.Left
                nameLbl.TextColor3 = UITheme.Colors.TextMain
                nameLbl.Text = "👤 " .. p.DisplayName .. " (@" .. p.Name .. ")"
                nameLbl.Parent = row

                local sendBtn = UITheme.MakeButton({
                    Text = Localization.Get("SEND_TRADE", lang),
                    Size = UDim2.fromOffset(150, 34),
                    Position = UDim2.new(1, -162, 0, 9),
                    Color = UITheme.Colors.Cyan,
                    TextColor = Color3.fromRGB(14, 18, 28),
                    Parent = row,
                    FontSize = 12,
                })
                sendBtn.MouseButton1Click:Connect(function()
                    Remotes.GetEvent("RequestSendTrade"):FireServer(p.UserId)
                end)
            end
        end
        return
    end

    -- ACTIVE TRADE VIEW
    local mySide = if currentTrade.SideA.UserId == localUserId then currentTrade.SideA else currentTrade.SideB
    local partnerSide = if currentTrade.SideA.UserId == localUserId then currentTrade.SideB else currentTrade.SideA

    local summaryCard = Instance.new("Frame")
    summaryCard.Size = UDim2.new(1, -10, 0, 130)
    summaryCard.BackgroundColor3 = UITheme.Colors.BgCard
    UITheme.AddCorner(summaryCard, 10)
    UITheme.AddStroke(summaryCard, UITheme.Colors.Cyan, 1.6)
    summaryCard.Parent = bodyFrame

    local partnerItemsText = {}
    for _, it in ipairs(partnerSide.Items or {}) do
        local def = ItemCatalog.Get(it.ItemId)
        local mut = MutationConfig.Get(it.Mutation)
        if def then
            table.insert(partnerItemsText, string.format("%s [%s] %s", def.Icon, mut.Prefix, def.Name))
        end
    end

    local statusLbl = Instance.new("TextLabel")
    statusLbl.Size = UDim2.new(0.65, 0, 0, 114)
    statusLbl.Position = UDim2.fromOffset(12, 8)
    statusLbl.BackgroundTransparency = 1
    statusLbl.Font = Enum.Font.GothamBold
    statusLbl.TextSize = 13
    statusLbl.TextWrapped = true
    statusLbl.TextXAlignment = Enum.TextXAlignment.Left
    statusLbl.TextYAlignment = Enum.TextYAlignment.Top
    statusLbl.TextColor3 = UITheme.Colors.TextMain
    statusLbl.Text = string.format(
        "YOU (%s): %d items + %s\nPARTNER %s (%s): %d items + %s\nPartner Offers: %s",
        if mySide.Confirmed then "✅ READY" else "EDITING",
        #(mySide.ItemUids or mySide.Items or {}),
        Utils.FormatCash(mySide.Cash or 0),
        partnerSide.PlayerName,
        if partnerSide.Confirmed then "✅ READY" else "EDITING",
        #(partnerSide.Items or {}),
        Utils.FormatCash(partnerSide.Cash or 0),
        if #partnerItemsText > 0 then table.concat(partnerItemsText, ", ") else "None"
    )
    statusLbl.Parent = summaryCard

    local confBtn = UITheme.MakeButton({
        Text = if mySide.Confirmed then "✅ CONFIRMED" else ("🤝 " .. Localization.Get("TRADE_CONFIRM", lang)),
        Size = UDim2.fromOffset(180, 40),
        Position = UDim2.new(1, -194, 0, 14),
        Color = if mySide.Confirmed then UITheme.Colors.Green else UITheme.Colors.Gold,
        TextColor = Color3.fromRGB(14, 18, 28),
        Parent = summaryCard,
        FontSize = 13,
    })
    confBtn.MouseButton1Click:Connect(function()
        Remotes.GetEvent("RequestConfirmTrade"):FireServer()
    end)

    local cancelBtn = UITheme.MakeButton({
        Text = "❌ Cancel Trade",
        Size = UDim2.fromOffset(180, 36),
        Position = UDim2.new(1, -194, 0, 66),
        Color = UITheme.Colors.Red,
        Parent = summaryCard,
        FontSize = 12,
    })
    cancelBtn.MouseButton1Click:Connect(function()
        Remotes.GetEvent("RequestCancelTrade"):FireServer()
    end)

    -- Cash Offer Quick Controls
    local cashBar = Instance.new("Frame")
    cashBar.Size = UDim2.new(1, -10, 0, 48)
    cashBar.BackgroundColor3 = UITheme.Colors.BgCard
    UITheme.AddCorner(cashBar, 8)
    cashBar.Parent = bodyFrame

    local cashLbl = Instance.new("TextLabel")
    cashLbl.Size = UDim2.new(0.42, 0, 1, 0)
    cashLbl.Position = UDim2.fromOffset(12, 0)
    cashLbl.BackgroundTransparency = 1
    cashLbl.Font = Enum.Font.GothamBold
    cashLbl.TextSize = 14
    cashLbl.TextXAlignment = Enum.TextXAlignment.Left
    cashLbl.TextColor3 = UITheme.Colors.Gold
    cashLbl.Text = "Offer Cash: " .. Utils.FormatCash(offerCashValue)
    cashLbl.Parent = cashBar

    local cashAmounts = { 500, 2500, 10000 }
    for i, amt in ipairs(cashAmounts) do
        local b = UITheme.MakeButton({
            Text = "+" .. Utils.FormatCash(amt),
            Size = UDim2.fromOffset(88, 32),
            Position = UDim2.new(0.45 + (i - 1) * 0.14, 0, 0, 8),
            Color = UITheme.Colors.BgHover,
            Parent = cashBar,
            FontSize = 12,
        })
        b.MouseButton1Click:Connect(function()
            local maxCash = if profile then profile.Cash else 0
            offerCashValue = math.min(maxCash, offerCashValue + amt)
            pushOfferUpdate()
        end)
    end
    local clrCashBtn = UITheme.MakeButton({
        Text = "Reset $0",
        Size = UDim2.fromOffset(82, 32),
        Position = UDim2.new(0.87, 0, 0, 8),
        Color = UITheme.Colors.Red,
        Parent = cashBar,
        FontSize = 11,
    })
    clrCashBtn.MouseButton1Click:Connect(function()
        offerCashValue = 0
        pushOfferUpdate()
    end)

    -- My Vault Items to toggle into Trade
    if profile then
        for _, inst in ipairs(profile.VaultItems) do
            local def = ItemCatalog.Get(inst.ItemId)
            if def then
                local mut = MutationConfig.Get(inst.Mutation)
                local selected = selectedUids[inst.Uid] == true
                local row = Instance.new("Frame")
                row.Size = UDim2.new(1, -10, 0, 48)
                row.BackgroundColor3 = UITheme.Colors.BgCard
                UITheme.AddCorner(row, 8)
                UITheme.AddStroke(row, if selected then UITheme.Colors.Green else mut.Color, 1.2)
                row.Parent = bodyFrame

                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(0.68, 0, 1, 0)
                lbl.Position = UDim2.fromOffset(10, 0)
                lbl.BackgroundTransparency = 1
                lbl.Font = Enum.Font.GothamBold
                lbl.TextSize = 13
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.TextColor3 = UITheme.Colors.TextMain
                lbl.Text = string.format("%s [%s] %s", def.Icon, mut.Prefix, def.Name)
                lbl.Parent = row

                local togBtn = UITheme.MakeButton({
                    Text = if selected then "✓ OFFERING" else "+ ADD TO TRADE",
                    Size = UDim2.fromOffset(145, 32),
                    Position = UDim2.new(1, -156, 0, 8),
                    Color = if selected then UITheme.Colors.Green else UITheme.Colors.BgHover,
                    TextColor = if selected then Color3.fromRGB(14, 18, 28) else UITheme.Colors.TextMain,
                    Parent = row,
                    FontSize = 12,
                })
                togBtn.MouseButton1Click:Connect(function()
                    selectedUids[inst.Uid] = not selected
                    pushOfferUpdate()
                end)
            end
        end
    end
end

function TradeController.Init(rootGui: ScreenGui)
    local panel, body, closeBtn = UITheme.CreateModal("TradeModal", "🤝 SAFE PLAYER TRADING", rootGui, Color3.fromRGB(95, 220, 180))
    modalPanel = panel
    bodyFrame = body
    closeBtn.MouseButton1Click:Connect(function()
        modalPanel.Visible = false
    end)
    HUDController.RegisterModal("Trade", modalPanel, TradeController.Refresh)

    Remotes.GetEvent("TradeInvitePrompt").OnClientEvent:Connect(function(info)
        if type(info) == "table" then
            pendingInvite = info
            if modalPanel.Visible then
                TradeController.Refresh()
            end
        end
    end)

    Remotes.GetEvent("TradeStateSync").OnClientEvent:Connect(function(trade)
        currentTrade = trade
        if not trade then
            selectedUids = {}
            offerCashValue = 0
        end
        if modalPanel.Visible then
            TradeController.Refresh()
        end
    end)
end

return TradeController
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000033">
  <Properties>
    <string name="Name">UITheme</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Shared UI Styling & Reusable Component Builders

local UITheme = {}

UITheme.Colors = {
    BgDark = Color3.fromRGB(14, 17, 28),
    BgCard = Color3.fromRGB(22, 27, 44),
    BgHover = Color3.fromRGB(32, 39, 64),
    Stroke = Color3.fromRGB(64, 78, 120),
    Cyan = Color3.fromRGB(0, 235, 255),
    Gold = Color3.fromRGB(255, 205, 55),
    Green = Color3.fromRGB(48, 225, 138),
    Red = Color3.fromRGB(255, 72, 88),
    Purple = Color3.fromRGB(185, 85, 255),
    TextMain = Color3.fromRGB(245, 248, 255),
    TextMuted = Color3.fromRGB(165, 178, 208),
}

function UITheme.AddCorner(inst: GuiObject, radius: number?)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 10)
    c.Parent = inst
end

function UITheme.AddStroke(inst: GuiObject, color: Color3?, thickness: number?)
    local s = Instance.new("UIStroke")
    s.Color = color or UITheme.Colors.Stroke
    s.Thickness = thickness or 1.5
    s.Parent = inst
    return s
end

function UITheme.MakeButton(props: {
    Text: string,
    Size: UDim2,
    Position: UDim2?,
    Color: Color3?,
    TextColor: Color3?,
    Parent: Instance,
    FontSize: number?,
}): TextButton
    local btn = Instance.new("TextButton")
    btn.Size = props.Size
    btn.Position = props.Position or UDim2.fromOffset(0, 0)
    btn.BackgroundColor3 = props.Color or UITheme.Colors.BgCard
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = true
    btn.Font = Enum.Font.GothamBold
    btn.TextColor3 = props.TextColor or UITheme.Colors.TextMain
    btn.TextSize = props.FontSize or 15
    btn.Text = props.Text
    btn.TextWrapped = true
    UITheme.AddCorner(btn, 9)
    UITheme.AddStroke(btn, UITheme.Colors.Stroke, 1.4)
    btn.Parent = props.Parent
    return btn
end

function UITheme.CreateModal(name: string, titleText: string, parent: Instance, accentColor: Color3?): (Frame, ScrollingFrame, TextButton, TextLabel)
    local panel = Instance.new("Frame")
    panel.Name = name
    panel.Size = UDim2.fromScale(0.68, 0.72)
    panel.Position = UDim2.fromScale(0.16, 0.14)
    panel.BackgroundColor3 = UITheme.Colors.BgDark
    panel.BackgroundTransparency = 0.04
    panel.BorderSizePixel = 0
    panel.Visible = false
    panel.ZIndex = 20
    UITheme.AddCorner(panel, 14)
    UITheme.AddStroke(panel, accentColor or UITheme.Colors.Cyan, 2)
    panel.Parent = parent

    local sizeConstraint = Instance.new("UISizeConstraint")
    sizeConstraint.MinSize = Vector2.new(420, 320)
    sizeConstraint.MaxSize = Vector2.new(980, 720)
    sizeConstraint.Parent = panel

    local header = Instance.new("Frame")
    header.Name = "Header"
    header.Size = UDim2.new(1, 0, 0, 52)
    header.BackgroundColor3 = UITheme.Colors.BgCard
    header.BorderSizePixel = 0
    header.ZIndex = 21
    UITheme.AddCorner(header, 14)
    header.Parent = panel

    local title = Instance.new("TextLabel")
    title.Name = "TitleLabel"
    title.Size = UDim2.new(1, -64, 1, 0)
    title.Position = UDim2.fromOffset(18, 0)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.GothamBlack
    title.TextSize = 21
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextColor3 = accentColor or UITheme.Colors.Cyan
    title.Text = titleText
    title.ZIndex = 22
    title.Parent = header

    local closeBtn = UITheme.MakeButton({
        Text = "✕",
        Size = UDim2.fromOffset(38, 38),
        Position = UDim2.new(1, -46, 0, 7),
        Color = UITheme.Colors.Red,
        Parent = header,
        FontSize = 18,
    })
    closeBtn.ZIndex = 22

    local body = Instance.new("ScrollingFrame")
    body.Name = "Body"
    body.Size = UDim2.new(1, -24, 1, -66)
    body.Position = UDim2.fromOffset(12, 58)
    body.BackgroundTransparency = 1
    body.BorderSizePixel = 0
    body.ScrollBarThickness = 6
    body.CanvasSize = UDim2.fromOffset(0, 0)
    body.AutomaticCanvasSize = Enum.AutomaticSize.Y
    body.ZIndex = 21
    body.Parent = panel

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 10)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = body

    return panel, body, closeBtn, title
end

return UITheme
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000034">
  <Properties>
    <string name="Name">WorldEventFXController</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Client Camera Shake for THE WORLD IS ENDING & 3D Magnet Radar Ping Visuals

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Remotes = require(Shared.Remotes)

local NotificationController = require(script.Parent.NotificationController)

local WorldEventFXController = {}
local activeWorldEvent = false

local function pulseCameraShake(intensity: number, duration: number)
    local cam = Workspace.CurrentCamera
    local char = Players.LocalPlayer.Character
    local hum = if char then char:FindFirstChildOfClass("Humanoid") else nil
    if not cam or not hum then
        return
    end
    task.spawn(function()
        local stopAt = os.clock() + duration
        while os.clock() < stopAt do
            hum.CameraOffset = Vector3.new(
                (math.random() - 0.5) * intensity,
                (math.random() - 0.5) * intensity,
                (math.random() - 0.5) * intensity
            )
            task.wait(0.05)
        end
        hum.CameraOffset = Vector3.zero
    end)
end

local function spawnRadarBeacon(targetPos: Vector3, itemName: string, rarity: string)
    local char = Players.LocalPlayer.Character
    local hrp = if char then char:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
    if not hrp then
        return
    end

    NotificationController.PushToast(string.format("📡 RADAR LOCKED: [%s] %s!", rarity, itemName), Color3.fromRGB(0, 235, 255))

    local dist = (targetPos - hrp.Position).Magnitude
    local beamPart = Instance.new("Part")
    beamPart.Name = "ClientRadarRay"
    beamPart.Size = Vector3.new(0.8, 0.8, dist)
    beamPart.Color = Color3.fromRGB(0, 255, 225)
    beamPart.Material = Enum.Material.Neon
    beamPart.Transparency = 0.35
    beamPart.Anchored = true
    beamPart.CanCollide = false
    beamPart.CFrame = CFrame.lookAt((hrp.Position + targetPos) * 0.5, targetPos)
    beamPart.Parent = Workspace

    task.delay(3.5, function()
        if beamPart.Parent then
            beamPart:Destroy()
        end
    end)
end

function WorldEventFXController.Init()
    Remotes.GetEvent("WorldEndingFX").OnClientEvent:Connect(function(payload)
        activeWorldEvent = (payload.Active == true)
        if activeWorldEvent and (payload.EventType == "MeteorShower" or payload.EventType == "GiantMonster") then
            task.spawn(function()
                while activeWorldEvent do
                    pulseCameraShake(0.65, 0.45)
                    task.wait(2.8)
                end
            end)
        end
    end)

    Remotes.GetEvent("CosmeticFXBurst").OnClientEvent:Connect(function(payload)
        if type(payload) ~= "table" then
            return
        end
        if payload.Type == "magnet_radar" and payload.TargetPos then
            spawnRadarBeacon(payload.TargetPos, tostring(payload.ItemName), tostring(payload.Rarity))
        end
    end)
end

return WorldEventFXController
]]></ProtectedString>
  </Properties>
</Item>
</Item>
<Item class="LocalScript" referent="RBX00000036">
  <Properties>
    <string name="Name">Init</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Client Bootstrapper for STEAL THE IMPOSSIBLE

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Remotes = require(Shared.Remotes)

local Controllers = script.Parent:WaitForChild("Controllers")
local NotificationController = require(Controllers.NotificationController)
local HUDController = require(Controllers.HUDController)
local ActionController = require(Controllers.ActionController)
local BaseManagerController = require(Controllers.BaseManagerController)
local FlexVisitController = require(Controllers.FlexVisitController)
local ShopCosmeticController = require(Controllers.ShopCosmeticController)
local CodexIndexController = require(Controllers.CodexIndexController)
local SquadHeistController = require(Controllers.SquadHeistController)
local LeaderboardController = require(Controllers.LeaderboardController)
local QuestCodeController = require(Controllers.QuestCodeController)
local TradeController = require(Controllers.TradeController)
local WorldEventFXController = require(Controllers.WorldEventFXController)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Root Game UI ScreenGui
local rootGui = Instance.new("ScreenGui")
rootGui.Name = "StealTheImpossibleUI"
rootGui.ResetOnSpawn = false
rootGui.IgnoreGuiInset = false
rootGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
rootGui.Parent = playerGui

-- Mobile & Small-Screen Responsive Auto-Scaler (keeps HUD & 8-button Dock crisp on phones!)
local uiScale = Instance.new("UIScale")
uiScale.Name = "ResponsiveMobileScale"
uiScale.Scale = 1
uiScale.Parent = rootGui

local function updateResponsiveScale()
    local cam = Workspace.CurrentCamera
    if not cam then
        return
    end
    local vp = cam.ViewportSize
    if vp.X <= 0 or vp.Y <= 0 then
        return
    end
    uiScale.Scale = math.clamp(math.min(vp.X / 1280, vp.Y / 720), 0.48, 1.0)
end

updateResponsiveScale()
task.spawn(function()
    while true do
        local cam = Workspace.CurrentCamera
        if cam then
            updateResponsiveScale()
            cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateResponsiveScale)
            break
        end
        task.wait(0.2)
    end
end)

-- Mount all Controllers cleanly
NotificationController.SetLanguageGetter(HUDController.GetLanguage)
NotificationController.Init(rootGui)
HUDController.Init(rootGui)
ActionController.Init(rootGui)
BaseManagerController.Init(rootGui)
FlexVisitController.Init(rootGui)
ShopCosmeticController.Init(rootGui)
CodexIndexController.Init(rootGui)
SquadHeistController.Init(rootGui)
LeaderboardController.Init(rootGui)
QuestCodeController.Init(rootGui)
TradeController.Init(rootGui)
WorldEventFXController.Init()

-- Hydrate initial server profile immediately
task.spawn(function()
    local ok, initData = pcall(function()
        return Remotes.GetFunction("GetInitialProfile"):InvokeServer()
    end)
    if ok and initData then
        HUDController.ApplyState(initData)
    end
end)
]]></ProtectedString>
  </Properties>
</Item>
</Item>
</Item>
</Item>
