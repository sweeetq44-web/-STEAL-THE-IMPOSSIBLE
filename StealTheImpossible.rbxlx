<Item class="ModuleScript" referent="RBX00000003">
  <Properties>
    <string name="Name">BaseConfig</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- 8 Personal Base Configurations, Tier 1-5 Upgrades, Tech Upgrades, and Cash Gadgets

local Types = require(script.Parent.Types)
local GameConfig = require(script.Parent.GameConfig)

local UpgradeTiers: { Types.BaseUpgradeTier } = {
    {
        Tier = 1,
        Name = "Starter Vault",
        NameTR = "Başlangıç Üssü",
        Cost = 0,
        MaxPedestals = 4,
        IncomeMultiplier = 1.0,
        ShieldDuration = 20,
        CarryPenaltyReduction = 0.0,
        FloorSize = Vector3.new(54, 2, 54),
        AccentHeight = 14,
    },
    {
        Tier = 2,
        Name = "Reinforced Bunker",
        NameTR = "Güçlendirilmiş Sığınak",
        Cost = 3500,
        MaxPedestals = 8,
        IncomeMultiplier = 1.30,
        ShieldDuration = 28,
        CarryPenaltyReduction = 0.15,
        FloorSize = Vector3.new(60, 2, 60),
        AccentHeight = 18,
    },
    {
        Tier = 3,
        Name = "Sky Spire Wing",
        NameTR = "Gökyüzü Kulesi",
        Cost = 22000,
        MaxPedestals = 12,
        IncomeMultiplier = 1.65,
        ShieldDuration = 36,
        CarryPenaltyReduction = 0.30,
        FloorSize = Vector3.new(66, 2, 66),
        AccentHeight = 23,
    },
    {
        Tier = 4,
        Name = "Obsidian Citadel",
        NameTR = "Obsidyen Kale",
        Cost = 140000,
        MaxPedestals = 16,
        IncomeMultiplier = 2.15,
        ShieldDuration = 45,
        CarryPenaltyReduction = 0.45,
        FloorSize = Vector3.new(72, 2, 72),
        AccentHeight = 28,
    },
    {
        Tier = 5,
        Name = "Impossible Palace",
        NameTR = "İmkânsız Saray",
        Cost = 850000,
        MaxPedestals = 24,
        IncomeMultiplier = 3.0,
        ShieldDuration = 60,
        CarryPenaltyReduction = 0.60,
        FloorSize = Vector3.new(78, 2, 78),
        AccentHeight = 36,
    },
}

local TechUpgrades: { Types.TechUpgradeDef } = {
    {
        Id = "carry_boots",
        Name = "Antigrav Carry Boots",
        NameTR = "Ağırlıksız Taşıma Botu",
        Description = "Reduces walkspeed slowdown while carrying heavy rare items (+4% per level).",
        DescriptionTR = "Ağır nadir eşyaları taşırken hız cezasını azaltır (seviye başına +%4).",
        MaxLevel = 8,
        BaseCost = 1200,
        CostMultiplier = 2.1,
        EffectPerLevel = 0.04,
    },
    {
        Id = "tackle_reach",
        Name = "Magnetic Snatch Gloves",
        NameTR = "Manyetik Kapma Eldiveni",
        Description = "Shaves 0.2s off Tackle/Steal cooldown per level.",
        DescriptionTR = "Çalma/Saldırı bekleme süresini seviye başına 0.2 sn azaltır.",
        MaxLevel = 6,
        BaseCost = 2000,
        CostMultiplier = 2.25,
        EffectPerLevel = 0.2,
    },
    {
        Id = "vault_multiplier",
        Name = "Vault Compounder",
        NameTR = "Kasa Çoğaltıcı",
        Description = "+10% Cash bonus on every successful extraction per level.",
        DescriptionTR = "Her başarılı eşya teslimatında +%10 ekstra nakit kazandırır.",
        MaxLevel = 10,
        BaseCost = 1800,
        CostMultiplier = 2.15,
        EffectPerLevel = 0.10,
    },
}

local Gadgets: { Types.GadgetDef } = {
    {
        Id = "speed_coil",
        Name = "Kinetic Speed Coil",
        NameTR = "Kinetik Hız Bobini",
        Description = "100% Free-to-Play Cash gadget! Temporary +12 speed surge for chasing or escaping.",
        DescriptionTR = "Tamamen oyun içi parayla! Kovalamaca veya kaçış için geçici +12 hız patlaması.",
        Cost = 2500,
        Cooldown = 14,
        Icon = "⚡",
    },
    {
        Id = "magnet_radar",
        Name = "Impossible Radar",
        NameTR = "İmkânsız Radar",
        Description = "Pulses a 3D beam pointing toward the rarest active item on the map.",
        DescriptionTR = "Haritadaki en nadir aktif eşyaya doğru ışık huzmesi gönderir.",
        Cost = 6500,
        Cooldown = 18,
        Icon = "📡",
    },
    {
        Id = "phase_dash",
        Name = "Phase Blink Dash",
        NameTR = "Işınlanma Atılımı",
        Description = "Forward impulse burst to dodge rival interceptors or close the gap.",
        DescriptionTR = "Rakiplerden kaçmak veya mesafeyi kapatmak için ileri atılım.",
        Cost = 14000,
        Cooldown = 10,
        Icon = "💨",
    },
    {
        Id = "frost_bolas",
        Name = "Cryo Snare",
        NameTR = "Buz Kapanı",
        Description = "Briefly slows nearby fleeing item carriers within 24 studs.",
        DescriptionTR = "24 birim içindeki kaçan eşya taşıyıcılarını kısa süreliğine yavaşlatır.",
        Cost = 28000,
        Cooldown = 16,
        Icon = "🧊",
    },
}

local TechById: { [string]: Types.TechUpgradeDef } = {}
for _, t in ipairs(TechUpgrades) do
    TechById[t.Id] = t
end

local GadgetById: { [string]: Types.GadgetDef } = {}
for _, g in ipairs(Gadgets) do
    GadgetById[g.Id] = g
end

local BaseConfig = {
    UpgradeTiers = table.freeze(UpgradeTiers),
    TechUpgrades = table.freeze(TechUpgrades),
    TechById = table.freeze(TechById),
    Gadgets = table.freeze(Gadgets),
    GadgetById = table.freeze(GadgetById),
}

function BaseConfig.GetTier(tier: number): Types.BaseUpgradeTier
    local clamped = math.clamp(math.floor(tier), 1, #UpgradeTiers)
    return UpgradeTiers[clamped]
end

function BaseConfig.GetTechCost(techId: string, currentLevel: number): number?
    local def = TechById[techId]
    if not def or currentLevel >= def.MaxLevel then
        return nil
    end
    return math.floor(def.BaseCost * (def.CostMultiplier ^ currentLevel))
end

-- Returns world CFrame of Base slot 1..8 arranged symmetrically around the Central Plaza
function BaseConfig.GetSlotCFrame(slotIndex: number): CFrame
    local angle = ((slotIndex - 1) / GameConfig.MAX_PLAYERS) * math.pi * 2
    local r = GameConfig.BASE_RING_RADIUS
    local pos = Vector3.new(math.cos(angle) * r, 4, math.sin(angle) * r)
    -- Face toward Central Plaza (0, 4, 0)
    return CFrame.lookAt(pos, Vector3.new(0, 4, 0))
end

return table.freeze(BaseConfig)
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000004">
  <Properties>
    <string name="Name">BiomeConfig</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- World Biomes, 15-Minute Rotating Special Rift Dimensions, and Co-op Heist Vault

export type BiomeDef = {
    Id: string,
    Name: string,
    NameTR: string,
    Description: string,
    DescriptionTR: string,
    AngleDegrees: number,
    Radius: number,
    PlatformSize: Vector3,
    PrimaryColor: Color3,
    AccentColor: Color3,
    FloorMaterial: Enum.Material,
    LuckMultiplier: number,
    SignatureItemId: string,
}

export type SpecialRiftTheme = {
    Id: string,
    Name: string,
    NameTR: string,
    PrimaryColor: Color3,
    AccentColor: Color3,
    LuckMultiplier: number,
}

local Biomes: { BiomeDef } = {
    {
        Id = "FrostCitadel",
        Name = "Frost Citadel",
        NameTR = "Buzul Kalesi",
        Description = "Frozen glacial spires guarding the legendary Frozen Sun.",
        DescriptionTR = "Efsanevi Buzdan Güneş'i koruyan donmuş buzul kuleleri.",
        AngleDegrees = 0,
        Radius = 325,
        PlatformSize = Vector3.new(125, 8, 125),
        PrimaryColor = Color3.fromRGB(115, 205, 245),
        AccentColor = Color3.fromRGB(225, 250, 255),
        FloorMaterial = Enum.Material.Ice,
        LuckMultiplier = 1.0,
        SignatureItemId = "frozen_sun",
    },
    {
        Id = "AbyssalCaldera",
        Name = "Abyssal Caldera",
        NameTR = "Cehennem Krateri",
        Description = "Scorching basalt craters where Mini Apocalypse stalks the rim.",
        DescriptionTR = "Mini Kıyamet'in dolaştığı yakıcı bazalt kraterleri.",
        AngleDegrees = 72,
        Radius = 325,
        PlatformSize = Vector3.new(125, 8, 125),
        PrimaryColor = Color3.fromRGB(55, 38, 42),
        AccentColor = Color3.fromRGB(255, 85, 35),
        FloorMaterial = Enum.Material.Basalt,
        LuckMultiplier = 1.05,
        SignatureItemId = "mini_apocalypse",
    },
    {
        Id = "ChronosRuins",
        Name = "Chronos Ruins",
        NameTR = "Zaman Harabeleri",
        Description = "Ancient floating gears echoing with the ticking Time Eater.",
        DescriptionTR = "Zaman Yiyen'in tik taklarıyla yankılanan antik dişliler.",
        AngleDegrees = 144,
        Radius = 325,
        PlatformSize = Vector3.new(125, 8, 125),
        PrimaryColor = Color3.fromRGB(185, 155, 95),
        AccentColor = Color3.fromRGB(95, 225, 255),
        FloorMaterial = Enum.Material.Marble,
        LuckMultiplier = 1.1,
        SignatureItemId = "time_eater",
    },
    {
        Id = "WatchersSanctum",
        Name = "Watchers' Sanctum",
        NameTR = "Gözcülerin Tapınağı",
        Description = "Shadowed obelisks watched over by The Last Eye.",
        DescriptionTR = "Son Göz tarafından izlenen gölgeli dikilitaşlar.",
        AngleDegrees = 216,
        Radius = 325,
        PlatformSize = Vector3.new(125, 8, 125),
        PrimaryColor = Color3.fromRGB(45, 28, 72),
        AccentColor = Color3.fromRGB(205, 75, 255),
        FloorMaterial = Enum.Material.Slate,
        LuckMultiplier = 1.15,
        SignatureItemId = "the_last_eye",
    },
    {
        Id = "AstralVoid",
        Name = "Astral Void",
        NameTR = "Astral Boşluk",
        Description = "Starlit cosmos floating above the horizon, cradle of Galaxy Eggs.",
        DescriptionTR = "Galaksi Yumurtalarının doğduğu yıldızlı kozmik platform.",
        AngleDegrees = 288,
        Radius = 325,
        PlatformSize = Vector3.new(125, 8, 125),
        PrimaryColor = Color3.fromRGB(24, 28, 62),
        AccentColor = Color3.fromRGB(255, 115, 235),
        FloorMaterial = Enum.Material.SmoothPlastic,
        LuckMultiplier = 1.2,
        SignatureItemId = "galaxy_egg",
    },
}

local SpecialRiftThemes: { SpecialRiftTheme } = {
    {
        Id = "GlitchMatrix",
        Name = "Glitch Matrix",
        NameTR = "Glitch Matrisi",
        PrimaryColor = Color3.fromRGB(18, 28, 34),
        AccentColor = Color3.fromRGB(0, 255, 185),
        LuckMultiplier = 2.5,
    },
    {
        Id = "SunkenAtlantis",
        Name = "Sunken Atlantis",
        NameTR = "Batık Atlantis",
        PrimaryColor = Color3.fromRGB(22, 65, 95),
        AccentColor = Color3.fromRGB(65, 245, 255),
        LuckMultiplier = 2.5,
    },
    {
        Id = "MirrorMirage",
        Name = "Mirror Mirage",
        NameTR = "Ayna Serabı",
        PrimaryColor = Color3.fromRGB(195, 180, 225),
        AccentColor = Color3.fromRGB(255, 105, 215),
        LuckMultiplier = 2.6,
    },
    {
        Id = "QuantumAnomaly",
        Name = "Quantum Anomaly",
        NameTR = "Kuantum Anomalisi",
        PrimaryColor = Color3.fromRGB(32, 18, 52),
        AccentColor = Color3.fromRGB(255, 215, 65),
        LuckMultiplier = 2.8,
    },
}

local ById: { [string]: BiomeDef } = {}
for _, b in ipairs(Biomes) do
    ById[b.Id] = b
end

local BiomeConfig = {
    Biomes = table.freeze(Biomes),
    ById = table.freeze(ById),
    SpecialRiftThemes = table.freeze(SpecialRiftThemes),
}

function BiomeConfig.GetBiomePosition(biome: BiomeDef): Vector3
    local rad = math.rad(biome.AngleDegrees)
    return Vector3.new(math.cos(rad) * biome.Radius, 8, math.sin(rad) * biome.Radius)
end

return table.freeze(BiomeConfig)
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000005">
  <Properties>
    <string name="Name">CosmeticCatalog</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Cosmetic-First Robux Monetization Catalog
-- Prices match exact design specification (customizable per live A/B test):
--   Custom Character Skins: 99 Robux
--   Custom Base Designs: 149 Robux
--   Custom Animations: 49 Robux
--   VIP Name Tag: 199 Robux
--   Custom Pet Appearances: 79 Robux
--   Extra Cosmetic Pack: 299 Robux
-- 100% Ethical: ZERO gameplay power or pay-to-win advantages.

local Types = require(script.Parent.Types)

local Products: { Types.RobuxProductDef } = {
    {
        Id = "prod_custom_skins",
        Category = "CharacterSkin",
        Name = "Custom Character Skins",
        NameTR = "Özel Karakter Skinleri",
