<Item class="ServerScriptService" referent="RBX00000026">
  <Properties>
    <string name="Name">ServerScriptService</string>
  </Properties>
<Item class="Folder" referent="RBX00000025">
  <Properties>
    <string name="Name">Server</string>
  </Properties>
<Item class="Script" referent="RBX00000012">
  <Properties>
    <string name="Name">Init</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Server Bootstrapper for STEAL THE IMPOSSIBLE (8-Player Server)

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)

local Services = script.Parent:WaitForChild("Services")
local DataService = require(Services.DataService)
local WorldBuilder = require(Services.WorldBuilder)
local SecretService = require(Services.SecretService)
local BaseService = require(Services.BaseService)
local ItemSpawnService = require(Services.ItemSpawnService)
local CarryStealService = require(Services.CarryStealService)
local SpecialZoneService = require(Services.SpecialZoneService)
local WorldEventService = require(Services.WorldEventService)
local SquadService = require(Services.SquadService)
local HeistService = require(Services.HeistService)
local ShopService = require(Services.ShopService)
local MonetizationService = require(Services.MonetizationService)
local LeaderboardService = require(Services.LeaderboardService)
local QuestCodeService = require(Services.QuestCodeService)
local TradeService = require(Services.TradeService)
local AdminTestService = require(Services.AdminTestService)

-- 1. Ensure Remotes & 3D World Architecture exist before players load
Remotes.EnsureFolder()
WorldBuilder.BuildIfMissing()

-- 2. Start Services in dependency-safe order
DataService.Start()
SecretService.Start()
BaseService.Start()
ItemSpawnService.Start()
CarryStealService.Start()
SpecialZoneService.Start()
WorldEventService.Start()
SquadService.Start()
HeistService.Start()
ShopService.Start()
MonetizationService.Start()
LeaderboardService.Start()
QuestCodeService.Start()
TradeService.Start()
AdminTestService.Start()

-- Wire JumpPads across biomes to launch explorers back toward Plaza
for _, pad in ipairs(CollectionService:GetTagged("JumpPad")) do
    if pad:IsA("BasePart") then
        local cd: { [number]: number } = {}
        pad.Touched:Connect(function(hit)
            local char = hit.Parent
            local player = if char then Players:GetPlayerFromCharacter(char) else nil
            local hrp = if char then char:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
            if not player or not hrp then
                return
            end
            local now = os.clock()
            if cd[player.UserId] and (now - cd[player.UserId]) < 1.2 then
                return
            end
            cd[player.UserId] = now
            local dirToCenter = (Vector3.new(0, 12, 0) - hrp.Position)
            local flatDir = Vector3.new(dirToCenter.X, 0, dirToCenter.Z)
            local unit = if flatDir.Magnitude > 1 then flatDir.Unit else Vector3.new(0, 0, -1)
            hrp.AssemblyLinearVelocity = unit * 95 + Vector3.new(0, 72, 0)
        end)
    end
end

-- Wire BaseRaidSafe ProximityPrompts (Owner collects cash, Rivals raid when shield is down!)
for _, safePart in ipairs(CollectionService:GetTagged("BaseRaidSafe")) do
    local prompt = safePart:FindFirstChildOfClass("ProximityPrompt")
    if prompt then
        local slotNum = safePart:GetAttribute("BaseSlot") :: number?
        prompt.Triggered:Connect(function(player)
            if not slotNum then
                return
            end
            local mySlot = BaseService.GetPlayerSlot(player)
            if mySlot == slotNum then
                local ok, amt = BaseService.CollectBaseSafe(player)
                Remotes.GetEvent("ActionFeedback"):FireClient(player, {
                    Success = ok,
                    Message = if ok then ("Collected +" .. tostring(amt) .. " Cash from Safe!") else "Safe is empty!",
                })
            else
                local ok, msg, amt = BaseService.RaidBaseSafe(player, slotNum)
                Remotes.GetEvent("ActionFeedback"):FireClient(player, {
                    Success = ok,
                    Message = if ok then ("RAIDED +" .. tostring(amt) .. " Cash!") else msg,
                })
            end
        end)
    end
end

-- 3. Player Lifecycle (8-player Base assignment + Profile hydration)
local function onPlayerAdded(player: Player)
    if #Players:GetPlayers() > GameConfig.MAX_PLAYERS then
        player:Kick("Server is full (8/8 players).")
        return
    end

    DataService.LoadPlayer(player)
    MonetizationService.SyncMarketplaceOwnership(player)
    BaseService.ClaimBaseForPlayer(player)
    BaseService.SyncProfileToClient(player)
end

local function onPlayerRemoving(player: Player)
    BaseService.ReleaseBaseForPlayer(player)
    DataService.UnloadPlayer(player)
end

for _, existing in ipairs(Players:GetPlayers()) do
    task.spawn(onPlayerAdded, existing)
end
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

-- 4. Master Scheduler Tick (15-min Special Zone + 30-min THE WORLD IS ENDING)
task.spawn(function()
    local timerSyncEvent = Remotes.GetEvent("WorldTimerSync")
    while true do
        local now = os.time()
        SpecialZoneService.Step(now)
        WorldEventService.Step(now)

        timerSyncEvent:FireAllClients({
            Rift = SpecialZoneService.GetTimerState(now),
            WorldEnding = WorldEventService.GetTimerState(now),
        })

        task.wait(1.0)
    end
end)
]]></ProtectedString>
  </Properties>
</Item>
<Item class="Folder" referent="RBX00000024">
  <Properties>
    <string name="Name">Services</string>
  </Properties>
<Item class="ModuleScript" referent="RBX00000013">
  <Properties>
    <string name="Name">AdminTestService</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Studio / Creator Live-Testing Commands (/test meteor, /test monster, /test gravity, /test rift, /test secret, /test cash)
-- Strictly gated to RunService:IsStudio() or GameConfig.CREATOR_USER_IDS.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local GameConfig = require(Shared.GameConfig)
local ItemCatalog = require(Shared.ItemCatalog)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local BaseService = require(script.Parent.BaseService)
local ItemSpawnService = require(script.Parent.ItemSpawnService)
local SpecialZoneService = require(script.Parent.SpecialZoneService)
local WorldEventService = require(script.Parent.WorldEventService)

local AdminTestService = {}

local function isAuthorized(player: Player): boolean
    if RunService:IsStudio() then
        return true
    end
    for _, uid in ipairs(GameConfig.CREATOR_USER_IDS) do
        if uid == player.UserId then
            return true
        end
    end
    return false
end

function AdminTestService.ExecuteCommand(player: Player, rawCommand: string)
    if not isAuthorized(player) then
        return
    end
    local parts = string.split(string.lower(rawCommand), " ")
    if parts[1] ~= "/test" then
        return
    end

    local cmd = parts[2] or ""
    local arg = parts[3]

    if cmd == "meteor" then
        WorldEventService.TriggerWorldEnding("MeteorShower", 35)
    elseif cmd == "monster" then
        WorldEventService.TriggerWorldEnding("GiantMonster", 35)
    elseif cmd == "gravity" then
        WorldEventService.TriggerWorldEnding("GravityLoss", 35)
    elseif cmd == "rift" then
        SpecialZoneService.OpenRift(90)
    elseif cmd == "cash" then
        local amt = tonumber(arg) or 100000
        DataService.AddCash(player, amt)
        BaseService.SyncProfileToClient(player)
    elseif cmd == "secret" or cmd == "item" or cmd == "celestial" then
        local itemId = if cmd == "secret" then "secret_zero_singularity" else (arg or "frozen_sun")
        local forcedMut: any = if cmd == "celestial" then "Celestial" else nil
        local def = ItemCatalog.Get(itemId)
        local char = player.Character
        local hrp = if char then char:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
        if def and hrp then
            ItemSpawnService.SpawnSpecificItemAt(def, hrp.Position + hrp.CFrame.LookVector * 8, def.BiomeId, false, forcedMut)
        end
    elseif cmd == "rebirth" then
        DataService.AddCash(player, 1000000)
        BaseService.SyncProfileToClient(player)
    elseif cmd == "endworld" then
        WorldEventService.EndWorldEnding()
    end
end

function AdminTestService.Start()
    Players.PlayerAdded:Connect(function(player)
        player.Chatted:Connect(function(msg)
            if string.sub(msg, 1, 5) == "/test" then
                AdminTestService.ExecuteCommand(player, msg)
            end
        end)
    end)

    Remotes.GetEvent("RequestAdminCommand").OnServerEvent:Connect(function(player, command)
        if type(command) == "string" then
            AdminTestService.ExecuteCommand(player, command)
        end
    end)
end

return AdminTestService
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000014">
  <Properties>
    <string name="Name">BaseService</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- 8 Personal Player Bases, Tier 1-5 Growth, Showcase Pedestals, Passive Income & FLEX YOUR BASE

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Types = require(Shared.Types)
local GameConfig = require(Shared.GameConfig)
local BaseConfig = require(Shared.BaseConfig)
local ItemCatalog = require(Shared.ItemCatalog)
local MutationConfig = require(Shared.MutationConfig)
local CosmeticCatalog = require(Shared.CosmeticCatalog)
local Remotes = require(Shared.Remotes)
local Utils = require(Shared.Utils)

local DataService = require(script.Parent.DataService)
local WorldBuilder = require(script.Parent.WorldBuilder)
local ItemVisualBuilder = require(script.Parent.ItemVisualBuilder)
local SecretService = require(script.Parent.SecretService)

local BaseService = {}

-- SlotIndex (1..8) -> UserId (or nil if unclaimed)
BaseService._slotOwners = {} :: { [number]: number? }
BaseService._playerSlots = {} :: { [number]: number }
BaseService._shieldUntil = {} :: { [number]: number }
BaseService._shieldCooldownUntil = {} :: { [number]: number }
BaseService._rateLimiter = Utils.CreateRateLimiter()
BaseService._carryCheckFn = nil :: ((player: Player) -> boolean)?

function BaseService.SetCarryCheck(fn: (player: Player) -> boolean)
    BaseService._carryCheckFn = fn
end

function BaseService.GetPlayerSlot(player: Player): number?
    return BaseService._playerSlots[player.UserId]
end

function BaseService.GetSlotOwnerUserId(slotIndex: number): number?
    return BaseService._slotOwners[slotIndex]
end

function BaseService.GetBaseCFrame(slotIndex: number): CFrame
    return BaseConfig.GetSlotCFrame(slotIndex)
end

function BaseService.IsBaseShieldActive(slotIndex: number): boolean
    return (BaseService._shieldUntil[slotIndex] or 0) > os.time()
end

function BaseService.ActivateBaseShield(player: Player): (boolean, string)
    local slot = BaseService._playerSlots[player.UserId]
    local profile = DataService.GetProfile(player)
    if not slot or not profile then
        return false, "No base"
    end
    local now = os.time()
    local cdUntil = BaseService._shieldCooldownUntil[player.UserId]
    if cdUntil ~= nil and now < cdUntil then
        return false, "Shield recharging"
    end
    local tierDef = BaseConfig.GetTier(profile.BaseTier)
    BaseService._shieldUntil[slot] = now + tierDef.ShieldDuration
    BaseService._shieldCooldownUntil[player.UserId] = now + tierDef.ShieldDuration + 15
    BaseService.RefreshBaseVisuals(slot)
    BaseService.SyncProfileToClient(player)
    return true, "Shield Active!"
end

function BaseService.ClaimBaseForPlayer(player: Player): number?
    local existing = BaseService._playerSlots[player.UserId]
    if existing then
        return existing
    end
    for slot = 1, GameConfig.MAX_PLAYERS do
        if BaseService._slotOwners[slot] == nil then
            BaseService._slotOwners[slot] = player.UserId
            BaseService._playerSlots[player.UserId] = slot
            local profile = DataService.GetProfile(player)
            local tierDef = BaseConfig.GetTier(if profile then profile.BaseTier else 1)
            BaseService._shieldUntil[slot] = os.time() + tierDef.ShieldDuration
            player:SetAttribute("BaseSlot", slot)
            BaseService.RefreshBaseVisuals(slot)
            return slot
        end
    end
    return nil
end

function BaseService.ReleaseBaseForPlayer(player: Player)
    local slot = BaseService._playerSlots[player.UserId]
    if not slot then
        return
    end
    BaseService._slotOwners[slot] = nil
    BaseService._playerSlots[player.UserId] = nil
    BaseService._rateLimiter:ClearPlayer(player.UserId)
    BaseService.RefreshBaseVisuals(slot)
end

local function updateSignText(folder: Folder, text: string, color: Color3)
    local sign = folder:FindFirstChild("OwnerSign")
    if not sign then
        return
    end
    local gui = sign:FindFirstChild("WorldSign")
    if not gui then
        return
    end
    local frame = gui:FindFirstChildOfClass("Frame")
    if not frame then
        return
    end
    local stroke = frame:FindFirstChildOfClass("UIStroke")
    if stroke then
        stroke.Color = color
    end
    local label = frame:FindFirstChildOfClass("TextLabel")
    if label then
        label.Text = text
    end
end

function BaseService.RefreshBaseVisuals(slotIndex: number)
    local folder = WorldBuilder.BaseFolders[slotIndex]
    if not folder then
        return
    end

    local ownerUserId = BaseService._slotOwners[slotIndex]
    local ownerPlayer = if ownerUserId then Players:GetPlayerByUserId(ownerUserId) else nil
    local profile = if ownerUserId then DataService.GetProfileByUserId(ownerUserId) else nil

    -- Default visuals
    local primaryColor = Color3.fromRGB(24, 28, 42)
    local accentColor = Color3.fromRGB(95, 185, 255)
    local floorMaterial = Enum.Material.SmoothPlastic
    local maxPedestals = 4
    local signTitle = "BASE #" .. tostring(slotIndex) .. "\nUNCLAIMED"

    if ownerPlayer and profile then
        local tierDef = BaseConfig.GetTier(profile.BaseTier)
        maxPedestals = tierDef.MaxPedestals
        local worth = DataService.ComputeNetWorth(profile)
        local vipPrefix = if profile.EquippedCosmetics.VipTagEnabled then "[VIP] " else ""
        signTitle = string.format("%s%s's BASE (T%d)\n%s  |  ❤️ %d", vipPrefix, ownerPlayer.Name, profile.BaseTier, Utils.FormatCash(worth), profile.TotalBaseLikes)

        local designId = profile.EquippedCosmetics.BaseDesign
        if designId then
            local asset = CosmeticCatalog.GetAsset(designId)
            if asset then
                primaryColor = asset.PrimaryColor
                accentColor = asset.SecondaryColor
                floorMaterial = asset.Material or Enum.Material.SmoothPlastic
            end
        end
    end

    local floorPart = folder:FindFirstChild("BaseFloor") :: BasePart?
    if floorPart then
        floorPart.Color = primaryColor
        floorPart.Material = floorMaterial
    end

    local gatePart = folder:FindFirstChild("SecurityGate") :: BasePart?
    if gatePart then
        local shielded = BaseService.IsBaseShieldActive(slotIndex)
        gatePart.Color = if shielded then accentColor else Color3.fromRGB(255, 75, 85)
        gatePart.Transparency = if shielded then 0.55 else 0.88
    end

    local safePart = folder:FindFirstChild("RaidSafe") :: BasePart?
    if safePart then
        local safeGui = safePart:FindFirstChild("WorldSign")
        local safeFrame = if safeGui then safeGui:FindFirstChildOfClass("Frame") else nil
        local safeLbl = if safeFrame then safeFrame:FindFirstChildOfClass("TextLabel") else nil
        if safeLbl then
            local safeCash = if profile then math.floor(profile.UncollectedSafeCash or 0) else 0
            local shieldTxt = if BaseService.IsBaseShieldActive(slotIndex) then "🛡️ SHIELDED" else "🔓 VULNERABLE"
            safeLbl.Text = string.format("VAULT SAFE: %s\n%s", Utils.FormatCash(safeCash), shieldTxt)
        end
    end

    updateSignText(folder, signTitle, accentColor)

    -- Refresh pedestals & render flexed 3D models
    local pedestalsFolder = folder:FindFirstChild("Pedestals")
    if not pedestalsFolder then
        return
    end

    local slotToItem: { [number]: Types.OwnedItemInstance } = {}
    if profile then
        for _, inst in ipairs(profile.VaultItems) do
            if inst.PedestalSlot ~= nil then
                slotToItem[inst.PedestalSlot] = inst
            end
        end
    end

    for _, child in ipairs(pedestalsFolder:GetChildren()) do
        if child:IsA("BasePart") then
            local pIdx = child:GetAttribute("PedestalIndex") :: number?
            if pIdx then
                local unlocked = (ownerPlayer ~= nil) and (pIdx <= maxPedestals)
                child.Transparency = if unlocked then 0 else 1
                child.CanCollide = unlocked
                child.Color = if unlocked then primaryColor else Color3.fromRGB(38, 44, 66)

                -- Clear previous showcase model
                local oldDisplay = child:FindFirstChild("FlexDisplay")
                if oldDisplay then
                    oldDisplay:Destroy()
                end

                local itemInst = slotToItem[pIdx]
                if unlocked and itemInst then
                    local itemDef = ItemCatalog.Get(itemInst.ItemId)
                    if itemDef then
                        local customLabel: string? = nil
                        if itemInst.HatchedCreature then
                            for _, c in ipairs(ItemCatalog.GalaxyCreatures) do
                                if c.Id == itemInst.HatchedCreature then
                                    customLabel = c.Icon .. " " .. c.Name .. " (" .. itemDef.Name .. ")"
                                    break
                                end
                            end
                        end
                        local model = ItemVisualBuilder.BuildItemModel(
                            itemDef,
                            child.CFrame * CFrame.new(0, 3.2, 0),
                            { Scale = 1.05, ShowBillboard = true, CustomLabel = customLabel, Mutation = itemInst.Mutation }
                        )
                        model.Name = "FlexDisplay"
                        model.Parent = child
                    end
                end
            end
        end
    end
end

function BaseService.AutoPlaceItemIfFreePedestal(player: Player, inst: Types.OwnedItemInstance)
    local profile = DataService.GetProfile(player)
    if not profile then
        return
    end
    local tierDef = BaseConfig.GetTier(profile.BaseTier)
    local used: { [number]: boolean } = {}
    for _, existing in ipairs(profile.VaultItems) do
        if existing.PedestalSlot then
            used[existing.PedestalSlot] = true
        end
    end
    for idx = 1, tierDef.MaxPedestals do
        if not used[idx] then
            inst.PedestalSlot = idx
            return
        end
    end
end

function BaseService.AddExtractedItemToBase(
    player: Player,
    itemDef: Types.ItemDefinition,
    obtainedFrom: string,
    mutation: Types.MutationId?
): (boolean, Types.OwnedItemInstance?)
    local profile = DataService.GetProfile(player)
    if not profile then
        return false, nil
    end

    local mut: Types.MutationId = mutation or "Normal"
    local mutMult = MutationConfig.Get(mut).ValueMultiplier
    local techLvl = profile.TechLevels.vault_multiplier or 0
    local rebirthMult = DataService.GetRebirthIncomeMultiplier(profile)

    if #profile.VaultItems >= GameConfig.MAX_VAULT_INVENTORY then
        local bonus = math.floor(itemDef.BaseCashValue * mutMult * (1 + techLvl * 0.10) * rebirthMult)
        DataService.AddCash(player, bonus)
        return true, nil
    end

    local inst: Types.OwnedItemInstance = {
        Uid = Utils.GenerateUid("relic"),
        ItemId = itemDef.Id,
        Mutation = mut,
        ObtainedAt = os.time(),
        ObtainedFrom = obtainedFrom,
        PedestalSlot = nil,
        HatchedCreature = nil,
    }
    table.insert(profile.VaultItems, inst)
    profile.TotalExtracted += 1
    DataService.EnsureDailyQuestReset(profile)
    profile.QuestProgress.Extracted += 1
    profile.DiscoveredItems[itemDef.Id] = (profile.DiscoveredItems[itemDef.Id] or 0) + 1

    BaseService.AutoPlaceItemIfFreePedestal(player, inst)

    -- Extraction cash reward boosted by Mutation, Vault Compounder tech & Rebirths
    local extractionBonus = math.floor(itemDef.BaseCashValue * 0.25 * mutMult * (1 + techLvl * 0.10) * rebirthMult)
    DataService.AddCash(player, extractionBonus)
    DataService.MarkDirty(player)

    local slot = BaseService._playerSlots[player.UserId]
    if slot then
        local tierDef = BaseConfig.GetTier(profile.BaseTier)
        BaseService._shieldUntil[slot] = os.time() + tierDef.ShieldDuration
        BaseService.RefreshBaseVisuals(slot)
    end

    if itemDef.IsSecret or itemDef.Rarity == "Secret" then
        SecretService.PublishSecretDiscovery(player, itemDef)
    end

    return true, inst
end

function BaseService.UpgradeBase(player: Player): (boolean, string)
    local profile = DataService.GetProfile(player)
    if not profile then
        return false, "Profile unavailable"
    end
    local nextTier = profile.BaseTier + 1
    if nextTier > #BaseConfig.UpgradeTiers then
        return false, "Already at Max Tier!"
    end
    local nextDef = BaseConfig.GetTier(nextTier)
    if profile.Cash < nextDef.Cost then
        return false, "Not enough Cash"
    end

    profile.Cash -= nextDef.Cost
    profile.BaseTier = nextTier
    DataService.MarkDirty(player)

    local slot = BaseService._playerSlots[player.UserId]
    if slot then
        BaseService.RefreshBaseVisuals(slot)
    end

    Remotes.GetEvent("FeedAnnouncement"):FireAllClients({
        Type = "BaseUpgrade",
        PlayerName = player.Name,
        Tier = nextTier,
        TierName = nextDef.Name,
    })

    return true, nextDef.Name
end

function BaseService.AssignPedestal(player: Player, itemUid: string, pedestalSlot: number): (boolean, string)
    local profile = DataService.GetProfile(player)
    if not profile then
        return false, "Profile unavailable"
    end
    local tierDef = BaseConfig.GetTier(profile.BaseTier)
    local cleanSlot = math.floor(pedestalSlot)
    if cleanSlot < 1 or cleanSlot > tierDef.MaxPedestals then
        return false, "Pedestal slot locked or invalid"
    end

    local targetItem: Types.OwnedItemInstance? = nil
    for _, inst in ipairs(profile.VaultItems) do
        if inst.Uid == itemUid then
            targetItem = inst
        elseif inst.PedestalSlot == cleanSlot then
            inst.PedestalSlot = nil
        end
    end

    if not targetItem then
        return false, "Item not found"
    end

    targetItem.PedestalSlot = cleanSlot
    DataService.MarkDirty(player)
    local slot = BaseService._playerSlots[player.UserId]
    if slot then
        BaseService.RefreshBaseVisuals(slot)
    end
    return true, "Equipped"
end

function BaseService.ClearPedestal(player: Player, pedestalSlot: number): boolean
    local profile = DataService.GetProfile(player)
    if not profile then
        return false
    end
    for _, inst in ipairs(profile.VaultItems) do
        if inst.PedestalSlot == pedestalSlot then
            inst.PedestalSlot = nil
        end
    end
    DataService.MarkDirty(player)
    local slot = BaseService._playerSlots[player.UserId]
    if slot then
        BaseService.RefreshBaseVisuals(slot)
    end
    return true
end

function BaseService.GetServerBasesSnapshot(): { any }
    local list = {}
    for slot = 1, GameConfig.MAX_PLAYERS do
        local ownerId = BaseService._slotOwners[slot]
        if ownerId then
            local p = Players:GetPlayerByUserId(ownerId)
            local profile = DataService.GetProfileByUserId(ownerId)
            if p and profile then
                local rarestLabel = "None"
                local bestWorth = -1
                local flexedItems = {}
                for _, inst in ipairs(profile.VaultItems) do
                    local def = ItemCatalog.Get(inst.ItemId)
                    if def then
                        if inst.PedestalSlot ~= nil then
                            table.insert(flexedItems, {
                                Name = def.Name,
                                NameTR = def.NameTR,
                                Rarity = def.Rarity,
                                Icon = def.Icon,
                                Slot = inst.PedestalSlot,
                                HatchedCreature = inst.HatchedCreature,
                            })
                        end
                        if def.BaseCashValue > bestWorth then
                            bestWorth = def.BaseCashValue
                            rarestLabel = def.Icon .. " " .. def.Name
                        end
                    end
                end
                table.insert(list, {
                    Slot = slot,
                    UserId = ownerId,
                    PlayerName = p.Name,
                    DisplayName = p.DisplayName,
                    BaseTier = profile.BaseTier,
                    NetWorth = DataService.ComputeNetWorth(profile),
                    Likes = profile.TotalBaseLikes,
                    RarestItem = rarestLabel,
                    Vip = profile.EquippedCosmetics.VipTagEnabled,
                    HighStakesMode = profile.HighStakesMode,
                    UncollectedSafeCash = math.floor(profile.UncollectedSafeCash or 0),
                    ShieldActive = BaseService.IsBaseShieldActive(slot),
                    FlexedItems = flexedItems,
                })
            end
        end
    end
    table.sort(list, function(a, b)
        return a.NetWorth > b.NetWorth
    end)
    return list
end

function BaseService.TeleportToBase(visitor: Player, targetSlot: number): (boolean, string)
    if BaseService._carryCheckFn and BaseService._carryCheckFn(visitor) then
        return false, "Drop or extract your carried item before teleporting!"
    end
    local ownerId = BaseService._slotOwners[targetSlot]
    if not ownerId then
        return false, "Base slot is unclaimed"
    end
    local char = visitor.Character
    local hrp = if char then char:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
    if not hrp then
        return false, "Character unavailable"
    end
    local baseCF = BaseConfig.GetSlotCFrame(targetSlot)
    -- Place visitor right in front of the showcase entrance
    hrp.CFrame = baseCF * CFrame.new(0, 4.5, -20)
    return true, "Teleported"
end

function BaseService.LikeBase(visitor: Player, targetUserId: number): (boolean, string)
    if visitor.UserId == targetUserId then
        return false, "Cannot like your own base"
    end
    local visitorProfile = DataService.GetProfile(visitor)
    local targetProfile = DataService.GetProfileByUserId(targetUserId)
    local targetPlayer = Players:GetPlayerByUserId(targetUserId)
    if not visitorProfile or not targetProfile or not targetPlayer then
        return false, "Base owner offline"
    end

    local key = tostring(targetUserId)
    if visitorProfile.LikedPlayerTargets[key] then
        return false, "Already liked this player's base!"
    end

    visitorProfile.LikedPlayerTargets[key] = true
    DataService.EnsureDailyQuestReset(visitorProfile)
    visitorProfile.QuestProgress.Likes += 1
    targetProfile.TotalBaseLikes += 1
    DataService.AddCash(targetPlayer, GameConfig.BASE_LIKE_REWARD_CASH)
    DataService.MarkDirty(visitor)
    DataService.MarkDirty(targetPlayer)

    local targetSlot = BaseService._playerSlots[targetUserId]
    if targetSlot then
        BaseService.RefreshBaseVisuals(targetSlot)
    end

    Remotes.GetEvent("FeedAnnouncement"):FireClient(targetPlayer, {
        Type = "BaseLiked",
        VisitorName = visitor.Name,
        Reward = GameConfig.BASE_LIKE_REWARD_CASH,
    })

    return true, "Liked!"
end

function BaseService.ToggleHighStakes(player: Player): (boolean, boolean)
    local profile = DataService.GetProfile(player)
    if not profile then
        return false, false
    end
    -- Collect any pending safe cash automatically when turning off High Stakes
    if profile.HighStakesMode and (profile.UncollectedSafeCash or 0) > 0 then
        DataService.AddCash(player, profile.UncollectedSafeCash)
        profile.UncollectedSafeCash = 0
    end
    profile.HighStakesMode = not profile.HighStakesMode
    DataService.MarkDirty(player)
    local slot = BaseService._playerSlots[player.UserId]
    if slot then
        BaseService.RefreshBaseVisuals(slot)
    end
    BaseService.SyncProfileToClient(player)
    return true, profile.HighStakesMode
end

function BaseService.CollectBaseSafe(player: Player): (boolean, number)
    local profile = DataService.GetProfile(player)
    if not profile then
        return false, 0
    end
    local amount = math.floor(profile.UncollectedSafeCash or 0)
    if amount <= 0 then
        return false, 0
    end
    profile.UncollectedSafeCash = 0
    DataService.AddCash(player, amount)
    DataService.MarkDirty(player)
    local slot = BaseService._playerSlots[player.UserId]
    if slot then
        BaseService.RefreshBaseVisuals(slot)
    end
    BaseService.SyncProfileToClient(player)
    return true, amount
end

function BaseService.RaidBaseSafe(raider: Player, targetSlot: number): (boolean, string, number)
    local ownerId = BaseService._slotOwners[targetSlot]
    if not ownerId then
        return false, "Unclaimed base", 0
    end
    if ownerId == raider.UserId then
        return false, "Cannot raid your own base", 0
    end
    if BaseService.IsBaseShieldActive(targetSlot) then
        return false, "Base Laser Shield is active!", 0
    end
    local targetPlayer = Players:GetPlayerByUserId(ownerId)
    local targetProfile = DataService.GetProfileByUserId(ownerId)
    if not targetPlayer or not targetProfile then
        return false, "Target offline", 0
    end

    -- Verify raider distance to the Raid Safe
    local rChar = raider.Character
    local rRoot = if rChar then rChar:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
    local baseCF = BaseConfig.GetSlotCFrame(targetSlot)
    local safeWorldPos = (baseCF * CFrame.new(-19, 4, -17)).Position
    if rRoot and (rRoot.Position - safeWorldPos).Magnitude > 16 then
        return false, "Get closer to the Vault Safe!", 0
    end

    local safeCash = math.floor(targetProfile.UncollectedSafeCash or 0)
    if safeCash < 50 then
        return false, "Vault Safe is empty!", 0
    end

    local stolenAmount = math.max(25, math.floor(safeCash * 0.35))
    targetProfile.UncollectedSafeCash = math.max(0, safeCash - stolenAmount)
    DataService.AddCash(raider, stolenAmount)
    DataService.MarkDirty(targetPlayer)
    BaseService.RefreshBaseVisuals(targetSlot)
    BaseService.SyncProfileToClient(raider)
    BaseService.SyncProfileToClient(targetPlayer)

    Remotes.GetEvent("FeedAnnouncement"):FireAllClients({
        Type = "BaseRaided",
        RaiderName = raider.Name,
        VictimName = targetPlayer.Name,
        Amount = stolenAmount,
    })

    return true, "Raided!", stolenAmount
end

function BaseService.SyncProfileToClient(player: Player)
    local profile = DataService.GetProfile(player)
    if not profile then
        return
    end
    local slot = BaseService._playerSlots[player.UserId]
    Remotes.GetEvent("StateSync"):FireClient(player, {
        Profile = profile,
        NetWorth = DataService.ComputeNetWorth(profile),
        IncomePerSec = DataService.ComputePassiveIncomePerSec(profile),
        BaseSlot = slot,
        ShieldRemaining = if slot then math.max(0, (BaseService._shieldUntil[slot] or 0) - os.time()) else 0,
    })
end

function BaseService.Start()
    -- Wire Client Remote handlers with strict validation
    Remotes.GetEvent("RequestUpgradeBase").OnServerEvent:Connect(function(player)
        if not BaseService._rateLimiter:Check(player.UserId, "UpgradeBase", 0.5) then
            return
        end
        local ok = BaseService.UpgradeBase(player)
        if ok then
            BaseService.SyncProfileToClient(player)
        end
    end)

    Remotes.GetEvent("RequestAssignPedestal").OnServerEvent:Connect(function(player, itemUid, slotNum)
        if type(itemUid) ~= "string" or type(slotNum) ~= "number" then
            return
        end
        if not BaseService._rateLimiter:Check(player.UserId, "AssignPedestal", 0.25) then
            return
        end
        local ok = BaseService.AssignPedestal(player, itemUid, slotNum)
        if ok then
            BaseService.SyncProfileToClient(player)
        end
    end)

    Remotes.GetEvent("RequestClearPedestal").OnServerEvent:Connect(function(player, slotNum)
        if type(slotNum) ~= "number" then
            return
        end
        if BaseService.ClearPedestal(player, slotNum) then
            BaseService.SyncProfileToClient(player)
        end
    end)

    Remotes.GetEvent("RequestHatchGalaxyEgg").OnServerEvent:Connect(function(player, itemUid)
        if type(itemUid) ~= "string" then
            return
        end
        if not BaseService._rateLimiter:Check(player.UserId, "HatchEgg", 0.6) then
            return
        end
        local ok = SecretService.HatchGalaxyEgg(player, itemUid)
        if ok then
            local slot = BaseService._playerSlots[player.UserId]
            if slot then
                BaseService.RefreshBaseVisuals(slot)
            end
            BaseService.SyncProfileToClient(player)
        end
    end)

    Remotes.GetEvent("RequestVisitBase").OnServerEvent:Connect(function(player, targetSlot)
        if type(targetSlot) ~= "number" then
            return
        end
        if not BaseService._rateLimiter:Check(player.UserId, "VisitBase", 1.0) then
            return
        end
        BaseService.TeleportToBase(player, math.floor(targetSlot))
    end)

    Remotes.GetEvent("RequestLikeBase").OnServerEvent:Connect(function(player, targetUserId)
        if type(targetUserId) ~= "number" then
            return
        end
        if not BaseService._rateLimiter:Check(player.UserId, "LikeBase", 1.0) then
            return
        end
        local ok = BaseService.LikeBase(player, math.floor(targetUserId))
        if ok then
            BaseService.SyncProfileToClient(player)
            local target = Players:GetPlayerByUserId(math.floor(targetUserId))
            if target then
                BaseService.SyncProfileToClient(target)
            end
        end
    end)

    Remotes.GetEvent("RequestReturnHome").OnServerEvent:Connect(function(player)
        if not BaseService._rateLimiter:Check(player.UserId, "ReturnHome", 1.0) then
            return
        end
        local slot = BaseService._playerSlots[player.UserId]
        if slot then
            BaseService.TeleportToBase(player, slot)
        end
    end)

    Remotes.GetEvent("RequestToggleHighStakes").OnServerEvent:Connect(function(player)
        if not BaseService._rateLimiter:Check(player.UserId, "HighStakes", 0.5) then
            return
        end
        BaseService.ToggleHighStakes(player)
    end)

    Remotes.GetEvent("RequestCollectBaseSafe").OnServerEvent:Connect(function(player)
        if not BaseService._rateLimiter:Check(player.UserId, "CollectSafe", 0.5) then
            return
        end
        BaseService.CollectBaseSafe(player)
    end)

    Remotes.GetEvent("RequestRechargeShield").OnServerEvent:Connect(function(player)
        if not BaseService._rateLimiter:Check(player.UserId, "RechargeShield", 1.0) then
            return
        end
        BaseService.ActivateBaseShield(player)
    end)

    Remotes.GetEvent("RequestRaidBaseSafe").OnServerEvent:Connect(function(player, targetSlot)
        if type(targetSlot) ~= "number" then
            return
        end
        if not BaseService._rateLimiter:Check(player.UserId, "RaidSafe", 1.0) then
            return
        end
        BaseService.RaidBaseSafe(player, math.floor(targetSlot))
    end)

    Remotes.GetFunction("GetServerBases").OnServerInvoke = function(_player)
        return BaseService.GetServerBasesSnapshot()
    end

    Remotes.GetFunction("GetInitialProfile").OnServerInvoke = function(player)
        local profile = DataService.GetProfile(player)
        if not profile then
            return nil
        end
        local slot = BaseService._playerSlots[player.UserId]
        return {
            Profile = profile,
            NetWorth = DataService.ComputeNetWorth(profile),
            IncomePerSec = DataService.ComputePassiveIncomePerSec(profile),
            BaseSlot = slot,
            ShieldRemaining = if slot then math.max(0, (BaseService._shieldUntil[slot] or 0) - os.time()) else 0,
        }
    end

    -- Passive Cash/sec loop (High-Stakes 2x goes into Raidable Safe; Standard goes directly to Cash!)
    task.spawn(function()
        while true do
            task.wait(GameConfig.PASSIVE_INCOME_INTERVAL)
            for _, player in ipairs(Players:GetPlayers()) do
                local profile = DataService.GetProfile(player)
                if profile then
                    local income = DataService.ComputePassiveIncomePerSec(profile)
                    if income > 0 then
                        if profile.HighStakesMode then
                            profile.UncollectedSafeCash = (profile.UncollectedSafeCash or 0) + income
                            DataService.MarkDirty(player)
                        else
                            DataService.AddCash(player, income)
                        end
                        BaseService.SyncProfileToClient(player)
                    end
                end
            end
        end
    end)
end

return BaseService
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000015">
  <Properties>
    <string name="Name">CarryStealService</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Addictive Core Mechanic: Carry -> Chase -> Tackle/Steal -> Base Deposit Extraction
-- Strictly server-authoritative with anti-exploit distance, rate limits & immunity windows.

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Types = require(Shared.Types)
local GameConfig = require(Shared.GameConfig)
local RarityConfig = require(Shared.RarityConfig)
local BaseConfig = require(Shared.BaseConfig)
local Remotes = require(Shared.Remotes)
local Utils = require(Shared.Utils)

local DataService = require(script.Parent.DataService)
local BaseService = require(script.Parent.BaseService)
local ItemSpawnService = require(script.Parent.ItemSpawnService)
local ItemVisualBuilder = require(script.Parent.ItemVisualBuilder)

export type CarryRecord = {
    ItemDef: Types.ItemDefinition,
    Mutation: Types.MutationId,
    ObtainedFrom: string,
    PickedUpAt: number,
    ImmunityUntil: number,
    CarryModel: Model?,
    BeaconBeamPart: Part?,
}

local CarryStealService = {}
CarryStealService._carriers = {} :: { [number]: CarryRecord }
CarryStealService._tackleCooldowns = {} :: { [number]: number }
CarryStealService._pickupCooldowns = {} :: { [number]: number }
CarryStealService._rateLimiter = Utils.CreateRateLimiter()

function CarryStealService.IsCarrying(player: Player): boolean
    return CarryStealService._carriers[player.UserId] ~= nil
end

function CarryStealService.GetCarryRecord(player: Player): CarryRecord?
    return CarryStealService._carriers[player.UserId]
end

function CarryStealService.ApplyCarrierWalkSpeed(player: Player)
    local char = player.Character
    local hum = if char then char:FindFirstChildOfClass("Humanoid") else nil
    if not hum then
        return
    end

    local record = CarryStealService._carriers[player.UserId]
    if not record then
        local speedBoost = player:GetAttribute("GadgetSpeedBoost") :: number?
        hum.WalkSpeed = GameConfig.DEFAULT_WALKSPEED + (speedBoost or 0)
        return
    end

    local rarityInfo = RarityConfig.Get(record.ItemDef.Rarity)
    local penalty = rarityInfo.CarrySpeedPenalty
    local profile = DataService.GetProfile(player)
    if profile then
        -- Featherweight Charm eliminates carry speed penalty completely!
        if (profile.ActiveBuffs.FeatherUntil or 0) > os.time() then
            penalty = 0
        else
            local tierDef = BaseConfig.GetTier(profile.BaseTier)
            local techLvl = profile.TechLevels.carry_boots or 0
            local reduction = math.min(0.85, tierDef.CarryPenaltyReduction + techLvl * 0.04)
            penalty = penalty * (1 - reduction)
        end
    end
    local speedBoost = player:GetAttribute("GadgetSpeedBoost") :: number?
    hum.WalkSpeed = math.max(10, GameConfig.DEFAULT_WALKSPEED * (1 - penalty)) + (speedBoost or 0)
end

local function clearCarryVisuals(record: CarryRecord)
    if record.CarryModel then
        record.CarryModel:Destroy()
        record.CarryModel = nil
    end
    if record.BeaconBeamPart then
        record.BeaconBeamPart:Destroy()
        record.BeaconBeamPart = nil
    end
end

local function attachCarryVisuals(player: Player, record: CarryRecord)
    clearCarryVisuals(record)
    local char = player.Character
    local hrp = if char then char:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
    if not char or not hrp then
        return
    end

    local carryCF = hrp.CFrame * CFrame.new(0, 1.8, 1.8)
    local model = ItemVisualBuilder.BuildItemModel(record.ItemDef, carryCF, { Scale = 0.85, ShowBillboard = true, Mutation = record.Mutation })
    model.Name = "CarriedRelic_" .. player.Name

    local primary = model.PrimaryPart
    if primary then
        for _, desc in ipairs(model:GetDescendants()) do
            if desc:IsA("BasePart") then
                desc.Anchored = false
                desc.CanCollide = false
                if desc ~= primary then
                    local weld = Instance.new("WeldConstraint")
                    weld.Part0 = primary
                    weld.Part1 = desc
                    weld.Parent = desc
                end
            end
        end

        local attachWeld = Instance.new("WeldConstraint")
        attachWeld.Part0 = hrp
        attachWeld.Part1 = primary
        attachWeld.Parent = primary
    end
    model.Parent = char
    record.CarryModel = model

    -- Add tall Sky Beacon so rivals can spot and chase carriers of Rare+ items (unless Shadow Cloak active!)
    local profile = DataService.GetProfile(player)
    local cloakActive = profile ~= nil and (profile.ActiveBuffs.ShadowCloakUntil or 0) > os.time()
    local rarityInfo = RarityConfig.Get(record.ItemDef.Rarity)
    if rarityInfo.BeaconEnabled and not cloakActive then
        local beacon = Instance.new("Part")
        beacon.Name = "CarrySkyBeacon"
        beacon.Size = Vector3.new(95, 1.4, 1.4)
        beacon.Shape = Enum.PartType.Cylinder
        beacon.Color = rarityInfo.Color
        beacon.Material = Enum.Material.Neon
        beacon.Transparency = 0.62
        beacon.CanCollide = false
        beacon.CastShadow = false
        beacon.Massless = true
        beacon.CFrame = hrp.CFrame * CFrame.new(0, 48, 0) * CFrame.Angles(0, 0, math.rad(90))
        beacon.Parent = char

        local bWeld = Instance.new("WeldConstraint")
        bWeld.Part0 = hrp
        bWeld.Part1 = beacon
        bWeld.Parent = beacon

        record.BeaconBeamPart = beacon
    end
end

local function syncCarryState(player: Player)
    local record = CarryStealService._carriers[player.UserId]
    player:SetAttribute("CarryingItemId", if record then record.ItemDef.Id else "")
    player:SetAttribute("CarryingRarity", if record then record.ItemDef.Rarity else "")

    Remotes.GetEvent("CarryStateSync"):FireAllClients({
        UserId = player.UserId,
        PlayerName = player.Name,
        ItemId = if record then record.ItemDef.Id else nil,
        ItemName = if record then record.ItemDef.Name else nil,
        ItemNameTR = if record then record.ItemDef.NameTR else nil,
        Mutation = if record then record.Mutation else nil,
        Rarity = if record then record.ItemDef.Rarity else nil,
        Icon = if record then record.ItemDef.Icon else nil,
    })
end

function CarryStealService.GiveCarryItem(
    player: Player,
    itemDef: Types.ItemDefinition,
    obtainedFrom: string,
    mutation: Types.MutationId?
): boolean
    if CarryStealService._carriers[player.UserId] ~= nil then
        return false
    end

    local now = os.clock()
    local record: CarryRecord = {
        ItemDef = itemDef,
        Mutation = mutation or "Normal",
        ObtainedFrom = obtainedFrom,
        PickedUpAt = now,
        ImmunityUntil = now + GameConfig.STEAL_IMMUNITY_DURATION,
        CarryModel = nil,
        BeaconBeamPart = nil,
    }
    CarryStealService._carriers[player.UserId] = record
    attachCarryVisuals(player, record)
    CarryStealService.ApplyCarrierWalkSpeed(player)
    syncCarryState(player)

    local rarityInfo = RarityConfig.Get(itemDef.Rarity)
    if rarityInfo.Order >= 4 then
        Remotes.GetEvent("FeedAnnouncement"):FireAllClients({
            Type = "HighRarityPickedUp",
            PlayerName = player.Name,
            ItemName = itemDef.Name,
            ItemNameTR = itemDef.NameTR,
            Rarity = itemDef.Rarity,
            Icon = itemDef.Icon,
        })
    end

    return true
end

function CarryStealService.TryPickupWorldNode(player: Player, node: ItemSpawnService.WorldSpawnNode): boolean
    if CarryStealService._carriers[player.UserId] ~= nil then
        return false
    end

    local now = os.clock()
    local lastPickup = CarryStealService._pickupCooldowns[player.UserId]
    if lastPickup ~= nil and (now - lastPickup) < GameConfig.PICKUP_COOLDOWN then
        return false
    end

    -- Server-side distance verification
    local char = player.Character
    local hrp = if char then char:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
    if hrp then
        if (hrp.Position - node.Position).Magnitude > 18 then
            return false
        end
    end

    CarryStealService._pickupCooldowns[player.UserId] = now
    local itemDef = node.ItemDef
    local biomeId = node.BiomeId
    local mut = node.Mutation
    ItemSpawnService.RemoveWorldNode(node.Uid)

    return CarryStealService.GiveCarryItem(player, itemDef, biomeId, mut)
end

-- Core Addictive Steal / Tackle Mechanic
function CarryStealService.AttemptSteal(thief: Player, targetPlayer: Player): (boolean, string)
    if thief == targetPlayer then
        return false, "Cannot steal from yourself"
    end
    if CarryStealService._carriers[thief.UserId] ~= nil then
        return false, "Already carrying an item"
    end

    local targetRecord = CarryStealService._carriers[targetPlayer.UserId]
    if not targetRecord then
        return false, "Target is not carrying an item"
    end

    local now = os.clock()
    if now < targetRecord.ImmunityUntil then
        return false, "Target has brief steal immunity"
    end

    -- Tackle cooldown scaled down by Magnetic Snatch Gloves tech
    local profile = DataService.GetProfile(thief)
    local techLvl = if profile then (profile.TechLevels.tackle_reach or 0) else 0
    local effectiveCd = math.max(1.5, GameConfig.TACKLE_COOLDOWN - techLvl * 0.2)
    local lastTackle = CarryStealService._tackleCooldowns[thief.UserId]
    if lastTackle ~= nil and (now - lastTackle) < effectiveCd then
        return false, "Tackle on cooldown"
    end

    -- Distance validation (Server-Authoritative!)
    local thiefChar = thief.Character
    local targetChar = targetPlayer.Character
    local thiefRoot = if thiefChar then thiefChar:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
    local targetRoot = if targetChar then targetChar:FindFirstChild("HumanoidRootPart") :: BasePart? else nil

    if thiefRoot and targetRoot then
        local dist = (thiefRoot.Position - targetRoot.Position).Magnitude
        if dist > GameConfig.STEAL_REACH_STUDS then
            return false, "Too far away"
        end
    end

    -- Cannot steal once target is already safely inside their own Base Extraction Zone
    local targetSlot = BaseService.GetPlayerSlot(targetPlayer)
    if targetSlot and targetRoot then
        local baseCF = BaseService.GetBaseCFrame(targetSlot)
        local localPos = baseCF:PointToObjectSpace(targetRoot.Position)
        if math.abs(localPos.X) <= 22 and localPos.Z >= -24 and localPos.Z <= 24 then
            return false, "Target reached their Base Shield!"
        end
    end

    -- Execute Clean Steal Transfer!
    CarryStealService._tackleCooldowns[thief.UserId] = now
    clearCarryVisuals(targetRecord)
    CarryStealService._carriers[targetPlayer.UserId] = nil
    CarryStealService.ApplyCarrierWalkSpeed(targetPlayer)
    syncCarryState(targetPlayer)

    -- Brief stumble slow on previous carrier
    local targetHum = if targetChar then targetChar:FindFirstChildOfClass("Humanoid") else nil
    if targetHum then
        targetHum.WalkSpeed = 7
        task.delay(GameConfig.STUN_DURATION_ON_STOLEN, function()
            if targetPlayer.Parent then
                CarryStealService.ApplyCarrierWalkSpeed(targetPlayer)
            end
        end)
    end

    -- Award thief steal stats & small steal bonus
    if profile then
        profile.TotalSteals += 1
        DataService.EnsureDailyQuestReset(profile)
        profile.QuestProgress.Steals += 1
        local stealBonus = math.max(25, math.floor(targetRecord.ItemDef.BaseCashValue * GameConfig.STEAL_THIEF_CASH_BONUS))
        DataService.AddCash(thief, stealBonus)
        BaseService.SyncProfileToClient(thief)
    end

    CarryStealService.GiveCarryItem(thief, targetRecord.ItemDef, targetRecord.ObtainedFrom, targetRecord.Mutation)

    Remotes.GetEvent("FeedAnnouncement"):FireAllClients({
        Type = "ItemStolenFromPlayer",
        ThiefName = thief.Name,
        VictimName = targetPlayer.Name,
        ItemName = targetRecord.ItemDef.Name,
        ItemNameTR = targetRecord.ItemDef.NameTR,
        Rarity = targetRecord.ItemDef.Rarity,
        Icon = targetRecord.ItemDef.Icon,
    })

    return true, "STOLEN!"
end

-- Helper used by Tackle button (finds closest carrier within reach automatically)
function CarryStealService.TackleNearestCarrier(attacker: Player): (boolean, string)
    local now = os.clock()
    local profile = DataService.GetProfile(attacker)
    local techLvl = if profile then (profile.TechLevels.tackle_reach or 0) else 0
    local effectiveCd = math.max(1.5, GameConfig.TACKLE_COOLDOWN - techLvl * 0.2)
    local lastTackle = CarryStealService._tackleCooldowns[attacker.UserId]
    if lastTackle ~= nil and (now - lastTackle) < effectiveCd then
        return false, "Cooldown"
    end

    local char = attacker.Character
    local root = if char then char:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
    if not root then
        return false, "No character"
    end

    local bestTarget: Player? = nil
    local bestDist = GameConfig.STEAL_REACH_STUDS
    for carrierId, _ in pairs(CarryStealService._carriers) do
        if carrierId ~= attacker.UserId then
            local p = Players:GetPlayerByUserId(carrierId)
            local tChar = if p then p.Character else nil
            local tRoot = if tChar then tChar:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
            if p and tRoot then
                local d = (root.Position - tRoot.Position).Magnitude
                if d <= bestDist then
                    bestDist = d
                    bestTarget = p
                end
            end
        end
    end

    if bestTarget then
        return CarryStealService.AttemptSteal(attacker, bestTarget)
    end

    -- Missed lunge still records cooldown
    CarryStealService._tackleCooldowns[attacker.UserId] = now
    return false, "No carrier in reach"
end

function CarryStealService.DepositCarriedItem(player: Player): boolean
    local record = CarryStealService._carriers[player.UserId]
    if not record then
        return false
    end

    clearCarryVisuals(record)
    CarryStealService._carriers[player.UserId] = nil
    CarryStealService.ApplyCarrierWalkSpeed(player)
    syncCarryState(player)

    local ok = BaseService.AddExtractedItemToBase(player, record.ItemDef, record.ObtainedFrom, record.Mutation)
    if ok then
        BaseService.SyncProfileToClient(player)
        Remotes.GetEvent("FeedAnnouncement"):FireAllClients({
            Type = "ItemExtracted",
            PlayerName = player.Name,
            ItemName = record.ItemDef.Name,
            ItemNameTR = record.ItemDef.NameTR,
            Rarity = record.ItemDef.Rarity,
            Icon = record.ItemDef.Icon,
        })
    end
    return ok
end

function CarryStealService.DropCarriedItemToWorld(player: Player)
    local record = CarryStealService._carriers[player.UserId]
    if not record then
        return
    end
    local dropPos = Vector3.new(0, 8, 0)
    local char = player.Character
    local hrp = if char then char:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
    if hrp then
        dropPos = hrp.Position + Vector3.new(0, 1.5, 0)
    end

    clearCarryVisuals(record)
    CarryStealService._carriers[player.UserId] = nil
    CarryStealService.ApplyCarrierWalkSpeed(player)
    syncCarryState(player)

    ItemSpawnService.SpawnSpecificItemAt(record.ItemDef, dropPos, record.ObtainedFrom, true, record.Mutation)
end

function CarryStealService.Start()
    BaseService.SetCarryCheck(CarryStealService.IsCarrying)
    ItemSpawnService.SetPickupCallback(function(player, node)
        CarryStealService.TryPickupWorldNode(player, node)
    end)

    -- Bind Base Deposit Pads
    for _, pad in ipairs(CollectionService:GetTagged("BaseDepositPad")) do
        if pad:IsA("BasePart") then
            pad.Touched:Connect(function(hit: BasePart)
                local model = hit:FindFirstAncestorOfClass("Model")
                local player = if model then Players:GetPlayerFromCharacter(model) else nil
                if not player then
                    return
                end
                local padSlot = pad:GetAttribute("BaseSlot") :: number?
                local playerSlot = BaseService.GetPlayerSlot(player)
                if padSlot and playerSlot == padSlot and CarryStealService.IsCarrying(player) then
                    CarryStealService.DepositCarriedItem(player)
                end
            end)
        end
    end

    -- Bind Tackle/Steal Request
    Remotes.GetEvent("RequestTackleSteal").OnServerEvent:Connect(function(player, targetUserId)
        if not CarryStealService._rateLimiter:Check(player.UserId, "Tackle", 0.35) then
            return
        end
        if type(targetUserId) == "number" then
            local target = Players:GetPlayerByUserId(math.floor(targetUserId))
            if target then
                CarryStealService.AttemptSteal(player, target)
                return
            end
        end
        CarryStealService.TackleNearestCarrier(player)
    end)

    -- Drop carried item on death or disconnect
    Players.PlayerAdded:Connect(function(player: Player)
        player.CharacterAdded:Connect(function(char: Model)
            local hum = char:WaitForChild("Humanoid", 5) :: Humanoid?
            if hum then
                hum.Died:Connect(function()
                    if CarryStealService.IsCarrying(player) then
                        CarryStealService.DropCarriedItemToWorld(player)
                    end
                end)
                CarryStealService.ApplyCarrierWalkSpeed(player)
            end
        end)
    end)

    Players.PlayerRemoving:Connect(function(player: Player)
        if CarryStealService.IsCarrying(player) then
            CarryStealService.DropCarriedItemToWorld(player)
        end
        CarryStealService._tackleCooldowns[player.UserId] = nil
        CarryStealService._pickupCooldowns[player.UserId] = nil
        CarryStealService._rateLimiter:ClearPlayer(player.UserId)
    end)
end

return CarryStealService
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000016">
  <Properties>
    <string name="Name">DataService</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Persistent Player Profile Management (DataStoreService + Retry + BindToClose + Leaderstats)

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Types = require(Shared.Types)
local GameConfig = require(Shared.GameConfig)
local ItemCatalog = require(Shared.ItemCatalog)
local BaseConfig = require(Shared.BaseConfig)
local QuestAndCodeConfig = require(Shared.QuestAndCodeConfig)
local Utils = require(Shared.Utils)

local DataService = {}
DataService._profiles = {} :: { [number]: Types.PlayerProfile }
DataService._dirty = {} :: { [number]: boolean }
DataService._saving = {} :: { [number]: boolean }
DataService._store = nil :: any

local PROFILE_VERSION = 2

local function currentDayKey(): number
    return math.floor(os.time() / 86400)
end

function DataService.CreateDefaultProfile(): Types.PlayerProfile
    return {
        Version = PROFILE_VERSION,
        Cash = GameConfig.STARTING_CASH,
        TotalEarned = GameConfig.STARTING_CASH,
        TotalSteals = 0,
        TotalExtracted = 0,
        SecretCount = 0,
        Rebirths = 0,
        BaseTier = 1,
        HighStakesMode = false,
        UncollectedSafeCash = 0,
        TechLevels = {
            carry_boots = 0,
            tackle_reach = 0,
            vault_multiplier = 0,
        },
        OwnedGadgets = {},
        VaultItems = {},
        DiscoveredItems = {},
        DiscoveredSecrets = {},
        OwnedProducts = {},
        RedeemedCodes = {},
        QuestDayKey = currentDayKey(),
        QuestProgress = {
            Extracted = 0,
            Steals = 0,
            Likes = 0,
            Heists = 0,
        },
        ClaimedQuests = {},
        ActiveBuffs = {
            LuckUntil = 0,
            FeatherUntil = 0,
            ShadowCloakUntil = 0,
        },
        EquippedCosmetics = {
            CharacterSkin = nil,
            BaseDesign = nil,
            AnimationPack = nil,
            PetSkin = nil,
            VipTagEnabled = false,
        },
        TotalBaseLikes = 0,
        LikedPlayerTargets = {},
        PreferredLanguage = "en",
        LastSavedAt = os.time(),
    }
end

function DataService.EnsureDailyQuestReset(profile: Types.PlayerProfile)
    local today = currentDayKey()
    if profile.QuestDayKey ~= today then
        profile.QuestDayKey = today
        profile.QuestProgress = {
            Extracted = 0,
            Steals = 0,
            Likes = 0,
            Heists = 0,
        }
        profile.ClaimedQuests = {}
    end
end

local function reconcileProfile(raw: any): Types.PlayerProfile
    local defaults = DataService.CreateDefaultProfile()
    if type(raw) ~= "table" then
        return defaults
    end
    for k, v in pairs(defaults :: any) do
        if raw[k] == nil then
            raw[k] = Utils.DeepCopy(v)
        elseif type(v) == "table" and type(raw[k]) == "table" and k ~= "VaultItems" then
            for subK, subV in pairs(v) do
                if raw[k][subK] == nil then
                    raw[k][subK] = Utils.DeepCopy(subV)
                end
            end
        end
    end
    raw.Version = PROFILE_VERSION
    DataService.EnsureDailyQuestReset(raw)
    return raw :: Types.PlayerProfile
end

function DataService.GetRebirthIncomeMultiplier(profile: Types.PlayerProfile): number
    return 1 + (profile.Rebirths or 0) * QuestAndCodeConfig.REBIRTH_INCOME_BONUS_PER_LEVEL
end

function DataService.GetBiomeMasteryMultiplier(profile: Types.PlayerProfile): number
    local mastered = ItemCatalog.GetMasteredBiomeCount(profile.DiscoveredItems)
    return 1 + mastered * 0.15
end

function DataService.GetPlayerLuckMultiplier(player: Player): number
    local profile = DataService._profiles[player.UserId]
    if not profile then
        return 1.0
    end
    local mult = 1.0 + (profile.Rebirths or 0) * QuestAndCodeConfig.REBIRTH_LUCK_BONUS_PER_LEVEL
    mult += ItemCatalog.GetMasteredBiomeCount(profile.DiscoveredItems) * 0.15
    if (profile.ActiveBuffs.LuckUntil or 0) > os.time() then
        mult = mult * 2.0
    end
    return mult
end

function DataService.ComputeNetWorth(profile: Types.PlayerProfile): number
    local total = math.floor(profile.Cash + (profile.UncollectedSafeCash or 0))
    for _, inst in ipairs(profile.VaultItems) do
        local def = ItemCatalog.Get(inst.ItemId)
        if def then
            local mult = ItemCatalog.GetInstanceMultiplier(inst)
            total += math.floor(def.BaseCashValue * mult)
        end
    end
    return total
end

function DataService.ComputePassiveIncomePerSec(profile: Types.PlayerProfile): number
    local tierDef = BaseConfig.GetTier(profile.BaseTier)
    local baseSum = 0
    for _, inst in ipairs(profile.VaultItems) do
        local def = ItemCatalog.Get(inst.ItemId)
        if def then
            -- Flexed pedestal items generate 100% passive income; vault storage items generate 35%
            local slotFactor = if inst.PedestalSlot ~= nil then 1.0 else 0.35
            local mult = ItemCatalog.GetInstanceMultiplier(inst)
            baseSum += def.PassiveIncomePerSec * slotFactor * mult
        end
    end
    local rebirthMult = DataService.GetRebirthIncomeMultiplier(profile)
    local masteryMult = DataService.GetBiomeMasteryMultiplier(profile)
    local highStakesMult = if profile.HighStakesMode then 2.0 else 1.0
    return math.floor(baseSum * tierDef.IncomeMultiplier * rebirthMult * masteryMult * highStakesMult)
end

local function getStore(): any
    if DataService._store ~= nil then
        return DataService._store
    end
    local ok, ds = pcall(function()
        return DataStoreService:GetDataStore(GameConfig.DATASTORE_NAME)
    end)
    if ok then
        DataService._store = ds
        return ds
    end
    return nil
end

function DataService.LoadPlayer(player: Player): Types.PlayerProfile
    local userId = player.UserId
    local key = "player_" .. tostring(userId)
    local profile: Types.PlayerProfile? = nil

    local store = getStore()
    if store ~= nil then
        for attempt = 1, 3 do
            local ok, res = pcall(function()
                return store:GetAsync(key)
            end)
            if ok then
                profile = reconcileProfile(res)
                break
            else
                if RunService:IsStudio() then
                    break
                end
                task.wait(0.5 * attempt)
            end
        end
    end

    if not profile then
        profile = DataService.CreateDefaultProfile()
    end

    local resolved = profile :: Types.PlayerProfile
    DataService._profiles[userId] = resolved
    DataService._dirty[userId] = false
    DataService.SyncLeaderstats(player)
    return resolved
end

function DataService.GetProfile(player: Player): Types.PlayerProfile?
    return DataService._profiles[player.UserId]
end

function DataService.GetProfileByUserId(userId: number): Types.PlayerProfile?
    return DataService._profiles[userId]
end

function DataService.MarkDirty(player: Player)
    DataService._dirty[player.UserId] = true
    DataService.SyncLeaderstats(player)
end

function DataService.SyncLeaderstats(player: Player)
    local profile = DataService._profiles[player.UserId]
    if not profile then
        return
    end
    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then
        leaderstats = Instance.new("Folder")
        leaderstats.Name = "leaderstats"
        leaderstats.Parent = player

        local cashVal = Instance.new("NumberValue")
        cashVal.Name = "Cash"
        cashVal.Parent = leaderstats

        local worthVal = Instance.new("NumberValue")
        worthVal.Name = "NetWorth"
        worthVal.Parent = leaderstats

        local stealsVal = Instance.new("IntValue")
        stealsVal.Name = "Steals"
        stealsVal.Parent = leaderstats

        local rebirthVal = Instance.new("IntValue")
        rebirthVal.Name = "Rebirths"
        rebirthVal.Parent = leaderstats
    end

    local cashObj = leaderstats:FindFirstChild("Cash") :: NumberValue?
    local worthObj = leaderstats:FindFirstChild("NetWorth") :: NumberValue?
    local stealsObj = leaderstats:FindFirstChild("Steals") :: IntValue?
    local rebirthObj = leaderstats:FindFirstChild("Rebirths") :: IntValue?
    if cashObj then
        cashObj.Value = math.floor(profile.Cash)
    end
    if worthObj then
        worthObj.Value = DataService.ComputeNetWorth(profile)
    end
    if stealsObj then
        stealsObj.Value = profile.TotalSteals
    end
    if rebirthObj then
        rebirthObj.Value = profile.Rebirths or 0
    end
end

function DataService.AddCash(player: Player, amount: number)
    local profile = DataService._profiles[player.UserId]
    if not profile or amount == 0 then
        return
    end
    profile.Cash = math.max(0, profile.Cash + amount)
    if amount > 0 then
        profile.TotalEarned += amount
    end
    DataService.MarkDirty(player)
end

function DataService.SavePlayer(player: Player, force: boolean?): boolean
    local userId = player.UserId
    local profile = DataService._profiles[userId]
    if not profile then
        return true
    end
    if not force and not DataService._dirty[userId] then
        return true
    end
    if DataService._saving[userId] then
        return false
    end

    DataService._saving[userId] = true
    profile.LastSavedAt = os.time()

    local store = getStore()
    local savedOk = false
    if store ~= nil then
        local key = "player_" .. tostring(userId)
        for attempt = 1, 3 do
            local ok, err = pcall(function()
                store:SetAsync(key, profile)
            end)
            if ok then
                savedOk = true
                DataService._dirty[userId] = false
                break
            else
                if RunService:IsStudio() then
                    -- Unpublished Studio places cannot write DataStore; keep in-memory clean
                    savedOk = true
                    break
                end
                warn(string.format("[DataService] Save attempt %d failed for %s: %s", attempt, player.Name, tostring(err)))
                task.wait(0.4 * attempt)
            end
        end
    else
        savedOk = true
    end

    DataService._saving[userId] = nil
    return savedOk
end

function DataService.UnloadPlayer(player: Player)
    DataService.SavePlayer(player, true)
    DataService._profiles[player.UserId] = nil
    DataService._dirty[player.UserId] = nil
    DataService._saving[player.UserId] = nil
end

function DataService.SaveAll()
    for _, player in ipairs(Players:GetPlayers()) do
        DataService.SavePlayer(player, true)
    end
end

function DataService.Start()
    task.spawn(function()
        while true do
            task.wait(GameConfig.AUTOSAVE_INTERVAL_SECONDS)
            for _, player in ipairs(Players:GetPlayers()) do
                if DataService._dirty[player.UserId] then
                    DataService.SavePlayer(player, false)
                end
            end
        end
    end)

    game:BindToClose(function()
        DataService.SaveAll()
        task.wait(1.0)
    end)
end

return DataService
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000017">
  <Properties>
    <string name="Name">HeistService</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Co-op Big Heist Facility ("THE IMPOSSIBLE VAULT")
-- Two+ squadmates step onto synchronized Vault Lock Plates to crack the Titan Bank Core!

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local GameConfig = require(Shared.GameConfig)
local ItemCatalog = require(Shared.ItemCatalog)
local MutationConfig = require(Shared.MutationConfig)
local Remotes = require(Shared.Remotes)

local WorldBuilder = require(script.Parent.WorldBuilder)
local SquadService = require(script.Parent.SquadService)
local CarryStealService = require(script.Parent.CarryStealService)
local DataService = require(script.Parent.DataService)
local BaseService = require(script.Parent.BaseService)

local HeistService = {}
HeistService.VaultCooldownUntil = 0
HeistService.IsVaultOpen = false
HeistService._plateOccupants = {} :: { [number]: Player? }

local function setVaultDoorState(open: boolean)
    HeistService.IsVaultOpen = open
    local door = WorldBuilder.HeistVaultDoor
    if door then
        door.CanCollide = not open
        door.Transparency = if open then 0.78 else 0
        door.Color = if open then Color3.fromRGB(45, 255, 145) else Color3.fromRGB(255, 185, 45)
    end
end

function HeistService.CheckAndTriggerCoopHeist(playersOnPlates: { Player }): (boolean, string)
    local now = os.time()
    if HeistService.IsVaultOpen or now < HeistService.VaultCooldownUntil then
        return false, "Vault on cooldown"
    end
    if #playersOnPlates < GameConfig.HEIST_MIN_PLAYERS then
        return false, "Need at least 2 players on synchronized plates"
    end

    -- Check if players share a Squad (gives extra Squad Multiplier) or cooperative team
    local p1 = playersOnPlates[1]
    local p2 = playersOnPlates[2]
    local sq1 = SquadService.GetPlayerSquad(p1)
    local sq2 = SquadService.GetPlayerSquad(p2)
    local sameSquad = (sq1 ~= nil and sq2 ~= nil and sq1.SquadId == sq2.SquadId)

    setVaultDoorState(true)
    HeistService.VaultCooldownUntil = now + GameConfig.HEIST_COOLDOWN_SECONDS

    -- Award high-tier heist loot & Cash to each participating raider!
    local vaultCore = ItemCatalog.Get("heist_vault_core")
    local cashBonus = if sameSquad then 5000 else 2500

    local participantList = {}
    if sameSquad and sq1 then
        participantList = SquadService.GetSquadMembersPlayers(sq1.SquadId)
    else
        participantList = playersOnPlates
    end

    for _, raider in ipairs(participantList) do
        local rProfile = DataService.GetProfile(raider)
        if rProfile then
            DataService.EnsureDailyQuestReset(rProfile)
            rProfile.QuestProgress.Heists += 1
        end
        DataService.AddCash(raider, cashBonus)
        BaseService.SyncProfileToClient(raider)
        if vaultCore and not CarryStealService.IsCarrying(raider) then
            local mut = MutationConfig.RollMutation(DataService.GetPlayerLuckMultiplier(raider))
            CarryStealService.GiveCarryItem(raider, vaultCore, "BigHeistVault", mut)
        end
    end

    Remotes.GetEvent("HeistStateSync"):FireAllClients({
        Breached = true,
        SameSquad = sameSquad,
        RaiderNames = { p1.Name, p2.Name },
        CooldownSeconds = GameConfig.HEIST_COOLDOWN_SECONDS,
    })

    Remotes.GetEvent("FeedAnnouncement"):FireAllClients({
        Type = "HeistBreached",
        PlayerA = p1.Name,
        PlayerB = p2.Name,
        SameSquad = sameSquad,
    })

    -- Close vault gate automatically after 25s escape window
    task.delay(25, function()
        setVaultDoorState(false)
    end)

    return true, "VAULT BREACHED!"
end

function HeistService.Start()
    setVaultDoorState(false)

    -- Monitor synchronized plates via proximity polling
    task.spawn(function()
        while true do
            task.wait(0.4)
            local plates = WorldBuilder.HeistLockPlates
            if #plates >= 2 and not HeistService.IsVaultOpen and os.time() >= HeistService.VaultCooldownUntil then
                local found: { Player } = {}
                local usedUsers: { [number]: boolean } = {}

                for plateIdx, plate in ipairs(plates) do
                    local occupiedBy: Player? = nil
                    for _, player in ipairs(Players:GetPlayers()) do
                        if not usedUsers[player.UserId] then
                            local char = player.Character
                            local hrp = if char then char:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
                            if hrp and (hrp.Position - plate.Position).Magnitude <= 8.5 then
                                occupiedBy = player
                                usedUsers[player.UserId] = true
                                break
                            end
                        end
                    end
                    plate.Color = if occupiedBy then Color3.fromRGB(45, 255, 145) else Color3.fromRGB(255, 65, 75)
                    HeistService._plateOccupants[plateIdx] = occupiedBy
                    if occupiedBy then
                        table.insert(found, occupiedBy)
                    end
                end

                if #found >= GameConfig.HEIST_MIN_PLAYERS then
                    HeistService.CheckAndTriggerCoopHeist(found)
                end
            end
        end
    end)
end

return HeistService
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000018">
  <Properties>
    <string name="Name">ItemSpawnService</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Weighted Item Spawning Service (Biomes, 15m Special Rift, World Ending Bonus & 0.01% Secrets)

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Types = require(Shared.Types)
local GameConfig = require(Shared.GameConfig)
local RarityConfig = require(Shared.RarityConfig)
local MutationConfig = require(Shared.MutationConfig)
local ItemCatalog = require(Shared.ItemCatalog)
local BiomeConfig = require(Shared.BiomeConfig)
local Utils = require(Shared.Utils)

local WorldBuilder = require(script.Parent.WorldBuilder)
local ItemVisualBuilder = require(script.Parent.ItemVisualBuilder)

export type WorldSpawnNode = {
    Uid: string,
    ItemDef: Types.ItemDefinition,
    Mutation: Types.MutationId,
    BiomeId: string,
    Position: Vector3,
    Model: Model?,
    SpawnedAt: number,
    IsDropped: boolean,
}

local ItemSpawnService = {}
ItemSpawnService._activeNodes = {} :: { [string]: WorldSpawnNode }
ItemSpawnService._rng = Random.new()
ItemSpawnService._onPickupCallback = nil :: ((player: Player, node: WorldSpawnNode) -> ())?
ItemSpawnService._riftOpenCheck = nil :: (() -> (boolean, number))?
ItemSpawnService._worldEventLuckBonus = 1.0

function ItemSpawnService.SetPickupCallback(cb: (player: Player, node: WorldSpawnNode) -> ())
    ItemSpawnService._onPickupCallback = cb
end

function ItemSpawnService.SetRiftCheck(fn: () -> (boolean, number))
    ItemSpawnService._riftOpenCheck = fn
end

function ItemSpawnService.SetWorldEventLuckBonus(mult: number)
    ItemSpawnService._worldEventLuckBonus = math.max(1.0, mult)
end

function ItemSpawnService.GetActiveNodes(): { [string]: WorldSpawnNode }
    return ItemSpawnService._activeNodes
end

function ItemSpawnService.GetRarestActiveNode(): WorldSpawnNode?
    local best: WorldSpawnNode? = nil
    local bestOrder = -1
    local bestValue = -1
    for _, node in pairs(ItemSpawnService._activeNodes) do
        local order = RarityConfig.Get(node.ItemDef.Rarity).Order
        if order > bestOrder or (order == bestOrder and node.ItemDef.BaseCashValue > bestValue) then
            bestOrder = order
            bestValue = node.ItemDef.BaseCashValue
            best = node
        end
    end
    return best
end

function ItemSpawnService.RemoveWorldNode(uid: string)
    local node = ItemSpawnService._activeNodes[uid]
    if not node then
        return
    end
    if node.Model then
        node.Model:Destroy()
        node.Model = nil
    end
    ItemSpawnService._activeNodes[uid] = nil
end

function ItemSpawnService.SpawnSpecificItemAt(
    itemDef: Types.ItemDefinition,
    worldPos: Vector3,
    biomeId: string,
    isDropped: boolean?,
    mutationOverride: Types.MutationId?
): WorldSpawnNode
    local uid = Utils.GenerateUid("spawn")
    local worldRoot = Workspace:FindFirstChild("GameWorld")
    local itemsFolder = if worldRoot then worldRoot:FindFirstChild("WorldItems") else Workspace

    local mut: Types.MutationId = mutationOverride or "Normal"
    local mutDef = MutationConfig.Get(mut)
    local cf = CFrame.new(worldPos)
    local model = ItemVisualBuilder.BuildItemModel(itemDef, cf, { Scale = 1.0, ShowBillboard = true, Mutation = mut })
    model.Name = "WorldItem_" .. uid
    model:SetAttribute("SpawnUid", uid)
    model:SetAttribute("BiomeId", biomeId)
    model:SetAttribute("Mutation", mut)

    -- Attach interactive ProximityPrompt for server-validated pickup
    local primary = model.PrimaryPart
    if primary then
        local prompt = Instance.new("ProximityPrompt")
        prompt.Name = "StealPickupPrompt"
        prompt.ActionText = "Grab " .. mutDef.Prefix .. itemDef.Name
        prompt.ObjectText = RarityConfig.Get(itemDef.Rarity).DisplayName
        prompt.HoldDuration = if itemDef.Rarity == "Secret" or itemDef.Rarity == "Impossible" then 0.35 else 0.15
        prompt.MaxActivationDistance = 11
        prompt.RequiresLineOfSight = false
        prompt.Parent = primary

        prompt.Triggered:Connect(function(player: Player)
            local node = ItemSpawnService._activeNodes[uid]
            if not node then
                return
            end
            if ItemSpawnService._onPickupCallback then
                ItemSpawnService._onPickupCallback(player, node)
            end
        end)
    end

    model.Parent = itemsFolder or Workspace

    local node: WorldSpawnNode = {
        Uid = uid,
        ItemDef = itemDef,
        Mutation = mut,
        BiomeId = biomeId,
        Position = worldPos,
        Model = model,
        SpawnedAt = os.time(),
        IsDropped = isDropped == true,
    }
    ItemSpawnService._activeNodes[uid] = node
    return node
end

function ItemSpawnService.SpawnInBiome(biomeId: string, luckMultiplier: number?): WorldSpawnNode?
    local center = WorldBuilder.BiomeCenters[biomeId]
    if biomeId == "SpecialRift" then
        center = GameConfig.RIFT_ARENA_POSITION + Vector3.new(0, 5, 0)
    end
    if not center then
        return nil
    end

    local totalLuck = (luckMultiplier or 1.0) * ItemSpawnService._worldEventLuckBonus
    local rolledRarity = RarityConfig.RollRarity(totalLuck, ItemSpawnService._rng)
    local pool = ItemCatalog.GetPool(biomeId, rolledRarity)
    local chosen = Utils.PickRandom(pool, ItemSpawnService._rng)
    if not chosen then
        return nil
    end

    local mutLuck = if biomeId == "SpecialRift" then totalLuck * 1.5 else totalLuck
    local rolledMutation = MutationConfig.RollMutation(mutLuck, ItemSpawnService._rng)

    local offsetX = ItemSpawnService._rng:NextNumber(-44, 44)
    local offsetZ = ItemSpawnService._rng:NextNumber(-44, 44)
    local spawnPos = center + Vector3.new(offsetX, 6.5, offsetZ)
    return ItemSpawnService.SpawnSpecificItemAt(chosen, spawnPos, biomeId, false, rolledMutation)
end

function ItemSpawnService.ClearBiomeSpawns(biomeId: string)
    for uid, node in pairs(ItemSpawnService._activeNodes) do
        if node.BiomeId == biomeId and not node.IsDropped then
            ItemSpawnService.RemoveWorldNode(uid)
        end
    end
end

function ItemSpawnService.CountInBiome(biomeId: string): number
    local count = 0
    for _, node in pairs(ItemSpawnService._activeNodes) do
        if node.BiomeId == biomeId and not node.IsDropped then
            count += 1
        end
    end
    return count
end

function ItemSpawnService.StepSpawner()
    local now = os.time()

    -- Expire dropped world items that nobody grabbed within despawn window
    for uid, node in pairs(ItemSpawnService._activeNodes) do
        if node.IsDropped and (now - node.SpawnedAt) >= GameConfig.WORLD_DROP_DESPAWN_SECONDS then
            ItemSpawnService.RemoveWorldNode(uid)
        end
    end

    -- Replenish permanent biomes
    for _, biome in ipairs(BiomeConfig.Biomes) do
        local current = ItemSpawnService.CountInBiome(biome.Id)
        if current < GameConfig.MAX_WORLD_ITEMS_PER_BIOME then
            ItemSpawnService.SpawnInBiome(biome.Id, biome.LuckMultiplier)
        end
    end

    -- Replenish 15-min Special Rift Dimension if active
    if ItemSpawnService._riftOpenCheck then
        local isOpen, riftLuck = ItemSpawnService._riftOpenCheck()
        if isOpen then
            local riftCount = ItemSpawnService.CountInBiome("SpecialRift")
            if riftCount < GameConfig.MAX_RIFT_ITEMS then
                ItemSpawnService.SpawnInBiome("SpecialRift", riftLuck)
            end
        end
    end
end

function ItemSpawnService.Start()
    -- Initial world seed across all 5 biomes
    for _, biome in ipairs(BiomeConfig.Biomes) do
        for _ = 1, GameConfig.MAX_WORLD_ITEMS_PER_BIOME do
            ItemSpawnService.SpawnInBiome(biome.Id, biome.LuckMultiplier)
        end
    end

    task.spawn(function()
        while true do
            task.wait(GameConfig.SPAWN_TICK_SECONDS)
            ItemSpawnService.StepSpawner()
        end
    end)
end

return ItemSpawnService
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000019">
  <Properties>
    <string name="Name">ItemVisualBuilder</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Procedural High-Detail 3D Item Visual Builder
-- Constructs distinct 3D Roblox models for Frozen Sun, Mini Apocalypse, Time Eater,
-- The Last Eye (with TrackingEyePart tag), Galaxy Egg, 0.01% Secrets, and all Relics.

local CollectionService = game:GetService("CollectionService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Types = require(Shared.Types)
local RarityConfig = require(Shared.RarityConfig)
local MutationConfig = require(Shared.MutationConfig)

local ItemVisualBuilder = {}

local function makePart(props: {
    Name: string,
    Size: Vector3,
    Shape: Enum.PartType?,
    Color: Color3,
    Material: Enum.Material,
    Transparency: number?,
    Parent: Instance,
    CFrameOffset: CFrame?,
    BaseCFrame: CFrame,
}): Part
    local p = Instance.new("Part")
    p.Name = props.Name
    p.Size = props.Size
    p.Shape = props.Shape or Enum.PartType.Block
    p.Color = props.Color
    p.Material = props.Material
    p.Transparency = props.Transparency or 0
    p.Anchored = true
    p.CanCollide = false
    p.CastShadow = false
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.CFrame = props.BaseCFrame * (props.CFrameOffset or CFrame.new())
    p.Parent = props.Parent
    return p
end

local function attachParticles(parentPart: Part, colorA: Color3, colorB: Color3, isSecret: boolean)
    local light = Instance.new("PointLight")
    light.Color = colorA
    light.Range = if isSecret then 26 else 16
    light.Brightness = if isSecret then 3.2 else 1.8
    light.Parent = parentPart

    local emitter = Instance.new("ParticleEmitter")
    emitter.Color = ColorSequence.new(colorA, colorB)
    emitter.LightEmission = 0.85
    emitter.Rate = if isSecret then 28 else 10
    emitter.Speed = NumberRange.new(1.5, 4.0)
    emitter.Lifetime = NumberRange.new(0.8, 1.8)
    emitter.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.45),
        NumberSequenceKeypoint.new(1, 0),
    })
    emitter.Parent = parentPart
end

function ItemVisualBuilder.BuildItemModel(
    itemDef: Types.ItemDefinition,
    originCFrame: CFrame,
    options: { Scale: number?, ShowBillboard: boolean?, CustomLabel: string?, Mutation: Types.MutationId? }?
): Model
    local opts = options or {}
    local scale = opts.Scale or 1.0
    local rarityInfo = RarityConfig.Get(itemDef.Rarity)
    local mutationId: Types.MutationId = opts.Mutation or "Normal"
    local mutationDef = MutationConfig.Get(mutationId)
    local hasMutation = (mutationId ~= "Normal")
    local isSecret = itemDef.Rarity == "Secret" or (itemDef.IsSecret == true)

    local model = Instance.new("Model")
    model.Name = "ItemModel_" .. itemDef.Id
    model:SetAttribute("ItemId", itemDef.Id)
    model:SetAttribute("Rarity", itemDef.Rarity)
    model:SetAttribute("Mutation", mutationId)
    model:SetAttribute("SpecialBehavior", itemDef.SpecialBehavior or "")

    local root = makePart({
        Name = "PrimaryHandle",
        Size = Vector3.new(2.2, 2.2, 2.2) * scale,
        Shape = Enum.PartType.Ball,
        Color = itemDef.PrimaryColor,
        Material = Enum.Material.Neon,
        Transparency = 1,
        Parent = model,
        BaseCFrame = originCFrame,
    })
    model.PrimaryPart = root

    local style = itemDef.VisualStyle

    if style == "FrozenSun" then
        -- Blazing golden star encased inside crystalline ice spikes!
        makePart({
            Name = "SolarCore",
            Size = Vector3.new(1.9, 1.9, 1.9) * scale,
            Shape = Enum.PartType.Ball,
            Color = itemDef.SecondaryColor,
            Material = Enum.Material.Neon,
            Parent = model,
            BaseCFrame = originCFrame,
        })
        makePart({
            Name = "IceShell",
            Size = Vector3.new(2.6, 2.6, 2.6) * scale,
            Shape = Enum.PartType.Block,
            Color = itemDef.PrimaryColor,
            Material = Enum.Material.Ice,
            Transparency = 0.32,
            Parent = model,
            CFrameOffset = CFrame.Angles(math.rad(45), math.rad(45), 0),
            BaseCFrame = originCFrame,
        })
        for i = 1, 4 do
            local ang = (i - 1) * (math.pi / 2)
            makePart({
                Name = "FrostSpike" .. tostring(i),
                Size = Vector3.new(0.45, 2.8, 0.45) * scale,
                Color = Color3.fromRGB(225, 250, 255),
                Material = Enum.Material.Glass,
                Transparency = 0.15,
                Parent = model,
                CFrameOffset = CFrame.Angles(0, ang, math.rad(35)),
                BaseCFrame = originCFrame,
            })
        end
    elseif style == "MiniApocalypse" then
        -- Cute/fierce floating dragon head, glowing eyes, swept magma wings & tail
        makePart({
            Name = "DragonBody",
            Size = Vector3.new(1.5, 1.3, 2.2) * scale,
            Color = itemDef.SecondaryColor,
            Material = Enum.Material.Basalt,
            Parent = model,
            BaseCFrame = originCFrame,
        })
        makePart({
            Name = "DragonCore",
            Size = Vector3.new(1.0, 0.9, 1.5) * scale,
            Shape = Enum.PartType.Ball,
            Color = itemDef.PrimaryColor,
            Material = Enum.Material.Neon,
            Parent = model,
            CFrameOffset = CFrame.new(0, 0.1 * scale, -0.55 * scale),
            BaseCFrame = originCFrame,
        })
        for _, side in ipairs({ -1, 1 }) do
            makePart({
                Name = if side < 0 then "WingL" else "WingR",
                Size = Vector3.new(2.1, 0.18, 1.2) * scale,
                Color = itemDef.PrimaryColor,
                Material = Enum.Material.Neon,
                Transparency = 0.15,
                Parent = model,
                CFrameOffset = CFrame.new(side * 1.45 * scale, 0.4 * scale, 0.1 * scale)
                    * CFrame.Angles(0, 0, side * math.rad(22)),
                BaseCFrame = originCFrame,
            })
            makePart({
                Name = if side < 0 then "EyeL" else "EyeR",
                Size = Vector3.new(0.28, 0.28, 0.28) * scale,
                Shape = Enum.PartType.Ball,
                Color = Color3.fromRGB(255, 235, 85),
                Material = Enum.Material.Neon,
                Parent = model,
                CFrameOffset = CFrame.new(side * 0.42 * scale, 0.3 * scale, -1.05 * scale),
                BaseCFrame = originCFrame,
            })
        end
    elseif style == "TimeEater" or style == "ClockworkGear" then
        -- Floating golden timepiece with spinning counter-clockwise clock hands!
        makePart({
            Name = "ClockRim",
            Size = Vector3.new(0.55, 2.6, 2.6) * scale,
            Shape = Enum.PartType.Cylinder,
            Color = itemDef.PrimaryColor,
            Material = Enum.Material.Metal,
            Parent = model,
            CFrameOffset = CFrame.Angles(0, math.rad(90), 0),
            BaseCFrame = originCFrame,
        })
        makePart({
            Name = "TimeFace",
            Size = Vector3.new(0.65, 2.0, 2.0) * scale,
            Shape = Enum.PartType.Cylinder,
            Color = itemDef.SecondaryColor,
            Material = Enum.Material.Neon,
            Transparency = 0.2,
            Parent = model,
            CFrameOffset = CFrame.Angles(0, math.rad(90), 0),
            BaseCFrame = originCFrame,
        })
        local handA = makePart({
            Name = "MinuteHand",
            Size = Vector3.new(0.18, 1.0, 0.18) * scale,
            Color = Color3.fromRGB(25, 25, 45),
            Material = Enum.Material.SmoothPlastic,
            Parent = model,
            CFrameOffset = CFrame.new(0, 0.4 * scale, -0.38 * scale),
            BaseCFrame = originCFrame,
        })
        CollectionService:AddTag(handA, "ReverseClockHand")
    elseif style == "TheLastEye" then
        -- Mysterious floating eye that tracks nearest player!
        local eyeball = makePart({
            Name = "Sclera",
            Size = Vector3.new(2.3, 2.3, 2.3) * scale,
            Shape = Enum.PartType.Ball,
            Color = Color3.fromRGB(240, 235, 255),
            Material = Enum.Material.SmoothPlastic,
            Parent = model,
            BaseCFrame = originCFrame,
        })
        local iris = makePart({
            Name = "TrackingIris",
            Size = Vector3.new(1.25, 1.25, 0.6) * scale,
            Shape = Enum.PartType.Ball,
            Color = itemDef.PrimaryColor,
            Material = Enum.Material.Neon,
            Parent = model,
            CFrameOffset = CFrame.new(0, 0, -0.95 * scale),
            BaseCFrame = originCFrame,
        })
        makePart({
            Name = "VoidPupil",
            Size = Vector3.new(0.55, 0.95, 0.45) * scale,
            Shape = Enum.PartType.Ball,
            Color = Color3.fromRGB(10, 8, 22),
            Material = Enum.Material.SmoothPlastic,
            Parent = model,
            CFrameOffset = CFrame.new(0, 0, -1.16 * scale),
            BaseCFrame = originCFrame,
        })
        -- Orbiting Watcher Halo
        makePart({
            Name = "WatcherHalo",
            Size = Vector3.new(3.1, 0.22, 3.1) * scale,
            Color = itemDef.SecondaryColor,
            Material = Enum.Material.Neon,
            Transparency = 0.25,
            Parent = model,
            CFrameOffset = CFrame.Angles(math.rad(22), 0, math.rad(15)),
            BaseCFrame = originCFrame,
        })
        CollectionService:AddTag(eyeball, "TrackingEyeCore")
        CollectionService:AddTag(iris, "TrackingEyeIris")
    elseif style == "GalaxyEgg" then
        -- Shimmering cosmic egg with twin planetary rings!
        makePart({
            Name = "EggShell",
            Size = Vector3.new(2.1, 2.8, 2.1) * scale,
            Shape = Enum.PartType.Ball,
            Color = itemDef.PrimaryColor,
            Material = Enum.Material.Glass,
            Parent = model,
            BaseCFrame = originCFrame,
        })
        makePart({
            Name = "EggNebulaCore",
            Size = Vector3.new(1.5, 2.1, 1.5) * scale,
            Shape = Enum.PartType.Ball,
            Color = itemDef.SecondaryColor,
            Material = Enum.Material.Neon,
            Transparency = 0.25,
            Parent = model,
            BaseCFrame = originCFrame,
        })
        makePart({
            Name = "OrbitRing1",
            Size = Vector3.new(3.4, 0.16, 3.4) * scale,
            Color = Color3.fromRGB(0, 245, 255),
            Material = Enum.Material.Neon,
            Transparency = 0.2,
            Parent = model,
            CFrameOffset = CFrame.Angles(math.rad(28), 0, math.rad(18)),
            BaseCFrame = originCFrame,
        })
        makePart({
            Name = "OrbitRing2",
            Size = Vector3.new(3.1, 0.14, 3.1) * scale,
            Color = itemDef.SecondaryColor,
            Material = Enum.Material.Neon,
            Transparency = 0.25,
            Parent = model,
            CFrameOffset = CFrame.Angles(math.rad(-32), 0, math.rad(-22)),
            BaseCFrame = originCFrame,
        })
    elseif style == "CrownRelic" then
        makePart({
            Name = "CrownBase",
            Size = Vector3.new(0.7, 2.2, 2.2) * scale,
            Shape = Enum.PartType.Cylinder,
            Color = itemDef.PrimaryColor,
            Material = Enum.Material.Metal,
            Parent = model,
            CFrameOffset = CFrame.Angles(0, 0, math.rad(90)),
            BaseCFrame = originCFrame,
        })
        for i = 1, 4 do
            local ang = (i - 1) * (math.pi / 2)
            makePart({
                Name = "CrownJewel" .. tostring(i),
                Size = Vector3.new(0.45, 1.1, 0.45) * scale,
                Color = itemDef.SecondaryColor,
                Material = Enum.Material.Neon,
                Parent = model,
                CFrameOffset = CFrame.new(math.cos(ang) * 0.85 * scale, 0.65 * scale, math.sin(ang) * 0.85 * scale),
                BaseCFrame = originCFrame,
            })
        end
    else
        -- CrystalRelic / CubeArtifact / OrbSingularity / DragonTotem / VoidPrism
        local isCube = (style == "CubeArtifact")
        makePart({
            Name = "CoreShape",
            Size = Vector3.new(1.8, 1.8, 1.8) * scale,
            Shape = if isCube then Enum.PartType.Block else Enum.PartType.Ball,
            Color = itemDef.PrimaryColor,
            Material = Enum.Material.Neon,
            Parent = model,
            CFrameOffset = CFrame.Angles(math.rad(30), math.rad(45), 0),
            BaseCFrame = originCFrame,
        })
        makePart({
            Name = "OuterFrame",
            Size = Vector3.new(2.3, 2.3, 2.3) * scale,
            Shape = Enum.PartType.Block,
            Color = itemDef.SecondaryColor,
            Material = Enum.Material.Glass,
            Transparency = 0.45,
            Parent = model,
            CFrameOffset = CFrame.Angles(math.rad(-25), math.rad(20), math.rad(35)),
            BaseCFrame = originCFrame,
        })
    end

    local pColorA = if hasMutation then mutationDef.Color else itemDef.PrimaryColor
    local pColorB = if hasMutation then mutationDef.ParticleColor else itemDef.SecondaryColor
    attachParticles(root, pColorA, pColorB, isSecret or mutationId == "Celestial")

    if hasMutation then
        makePart({
            Name = "MutationRing",
            Size = Vector3.new(0.2, 3.6, 3.6) * scale,
            Shape = Enum.PartType.Cylinder,
            Color = mutationDef.Color,
            Material = Enum.Material.Neon,
            Transparency = 0.4,
            Parent = model,
            CFrameOffset = CFrame.new(0, -1.25 * scale, 0) * CFrame.Angles(0, 0, math.rad(90)),
            BaseCFrame = originCFrame,
        })
    end

    if opts.ShowBillboard ~= false then
        local bb = Instance.new("BillboardGui")
        bb.Name = "ItemOverhead"
        bb.Size = UDim2.fromOffset(230, 72)
        bb.StudsOffset = Vector3.new(0, 3.3 * scale, 0)
        bb.AlwaysOnTop = false
        bb.MaxDistance = 95
        bb.Parent = root

        local bg = Instance.new("Frame")
        bg.Size = UDim2.fromScale(1, 1)
        bg.BackgroundColor3 = Color3.fromRGB(14, 17, 26)
        bg.BackgroundTransparency = 0.18
        bg.BorderSizePixel = 0
        bg.Parent = bb

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = bg

        local stroke = Instance.new("UIStroke")
        stroke.Color = if hasMutation then mutationDef.Color else rarityInfo.Color
        stroke.Thickness = if isSecret or hasMutation then 2.4 else 1.6
        stroke.Parent = bg

        local rarityLabel = Instance.new("TextLabel")
        rarityLabel.Size = UDim2.new(1, -10, 0.38, 0)
        rarityLabel.Position = UDim2.fromOffset(5, 3)
        rarityLabel.BackgroundTransparency = 1
        rarityLabel.Font = Enum.Font.GothamBlack
        rarityLabel.TextScaled = true
        rarityLabel.TextColor3 = rarityInfo.Color
        rarityLabel.Text = if hasMutation
            then (rarityInfo.DisplayName .. " • " .. mutationDef.DisplayName)
            else rarityInfo.DisplayName
        rarityLabel.Parent = bg

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, -10, 0.52, 0)
        nameLabel.Position = UDim2.new(0, 5, 0.42, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextScaled = true
        nameLabel.TextColor3 = if hasMutation then mutationDef.Color else Color3.fromRGB(248, 250, 255)
        nameLabel.Text = opts.CustomLabel or (itemDef.Icon .. " " .. mutationDef.Prefix .. itemDef.Name)
        nameLabel.Parent = bg
    end

    CollectionService:AddTag(model, "ImpossibleItemModel")
    return model
end

return ItemVisualBuilder
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001A">
  <Properties>
    <string name="Name">LeaderboardService</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Global Leaderboards (OrderedDataStore + 3D Plaza Monolith Boards + Client Modal Data)

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Utils = require(Shared.Utils)

local DataService = require(script.Parent.DataService)
local WorldBuilder = require(script.Parent.WorldBuilder)

export type LeaderboardEntry = {
    Rank: number,
    UserId: number,
    Name: string,
    Value: number,
}

local LeaderboardService = {}
LeaderboardService._cachedBoards = {
    NetWorth = {} :: { LeaderboardEntry },
    Steals = {} :: { LeaderboardEntry },
    Secrets = {} :: { LeaderboardEntry },
}
LeaderboardService._nameCache = {} :: { [number]: string }

local function resolvePlayerName(userId: number): string
    local online = Players:GetPlayerByUserId(userId)
    if online then
        LeaderboardService._nameCache[userId] = online.Name
        return online.Name
    end
    if LeaderboardService._nameCache[userId] then
        return LeaderboardService._nameCache[userId]
    end
    local ok, name = pcall(function()
        return Players:GetNameFromUserIdAsync(userId)
    end)
    if ok and type(name) == "string" then
        LeaderboardService._nameCache[userId] = name
        return name
    end
    return "Player_" .. tostring(userId)
end

local function fetchOrderedBoard(dsName: string): { LeaderboardEntry }?
    local okStore, ods = pcall(function()
        return DataStoreService:GetOrderedDataStore(dsName)
    end)
    if not okStore or not ods then
        return nil
    end

    local okPages, pages = pcall(function()
        return ods:GetSortedAsync(false, 10)
    end)
    if not okPages or not pages then
        return nil
    end

    local current = pages:GetCurrentPage()
    local rows: { LeaderboardEntry } = {}
    for rank, entry in ipairs(current) do
        local uid = tonumber(entry.key) or 0
        table.insert(rows, {
            Rank = rank,
            UserId = uid,
            Name = resolvePlayerName(uid),
            Value = tonumber(entry.value) or 0,
        })
    end
    return rows
end

function LeaderboardService.BuildInServerFallback(boardKey: "NetWorth" | "Steals" | "Secrets"): { LeaderboardEntry }
    local rows: { LeaderboardEntry } = {}
    for _, player in ipairs(Players:GetPlayers()) do
        local profile = DataService.GetProfile(player)
        if profile then
            local val = if boardKey == "NetWorth"
                then DataService.ComputeNetWorth(profile)
                elseif boardKey == "Steals" then profile.TotalSteals
                else profile.SecretCount
            table.insert(rows, {
                Rank = 0,
                UserId = player.UserId,
                Name = player.Name,
                Value = val,
            })
        end
    end
    table.sort(rows, function(a, b)
        return a.Value > b.Value
    end)
    for i, r in ipairs(rows) do
        r.Rank = i
    end
    return rows
end

function LeaderboardService.PushOnlineScores()
    if RunService:IsStudio() then
        return
    end
    for _, player in ipairs(Players:GetPlayers()) do
        local profile = DataService.GetProfile(player)
        if profile then
            local key = tostring(player.UserId)
            local netWorth = DataService.ComputeNetWorth(profile)
            pcall(function()
                DataStoreService:GetOrderedDataStore(GameConfig.ORDERED_WEALTH_DS):SetAsync(key, netWorth)
            end)
            pcall(function()
                DataStoreService:GetOrderedDataStore(GameConfig.ORDERED_STEALS_DS):SetAsync(key, profile.TotalSteals)
            end)
            pcall(function()
                DataStoreService:GetOrderedDataStore(GameConfig.ORDERED_SECRETS_DS):SetAsync(key, profile.SecretCount)
            end)
        end
    end
end

function LeaderboardService.RefreshAllBoards()
    local globalWorth = if not RunService:IsStudio() then fetchOrderedBoard(GameConfig.ORDERED_WEALTH_DS) else nil
    local globalSteals = if not RunService:IsStudio() then fetchOrderedBoard(GameConfig.ORDERED_STEALS_DS) else nil
    local globalSecrets = if not RunService:IsStudio() then fetchOrderedBoard(GameConfig.ORDERED_SECRETS_DS) else nil

    LeaderboardService._cachedBoards.NetWorth = if globalWorth and #globalWorth > 0
        then globalWorth
        else LeaderboardService.BuildInServerFallback("NetWorth")

    LeaderboardService._cachedBoards.Steals = if globalSteals and #globalSteals > 0
        then globalSteals
        else LeaderboardService.BuildInServerFallback("Steals")

    LeaderboardService._cachedBoards.Secrets = if globalSecrets and #globalSecrets > 0
        then globalSecrets
        else LeaderboardService.BuildInServerFallback("Secrets")

    -- Update 3D Central Plaza SurfaceGui Monoliths
    local worthBoard = WorldBuilder.LeaderboardBoards.NetWorth
    if worthBoard then
        local bg = worthBoard:FindFirstChildOfClass("Frame")
        local rowsLbl = if bg then bg:FindFirstChild("Rows") :: TextLabel? else nil
        if rowsLbl then
            local lines = {}
            for _, row in ipairs(LeaderboardService._cachedBoards.NetWorth) do
                table.insert(lines, string.format("#%d  %-16s  %s", row.Rank, row.Name, Utils.FormatCash(row.Value)))
            end
            rowsLbl.Text = if #lines > 0 then table.concat(lines, "\n") else "No rankings yet!"
        end
    end

    local secretBoard = WorldBuilder.LeaderboardBoards.Secrets
    if secretBoard then
        local bg = secretBoard:FindFirstChildOfClass("Frame")
        local rowsLbl = if bg then bg:FindFirstChild("Rows") :: TextLabel? else nil
        if rowsLbl then
            local lines = {}
            for _, row in ipairs(LeaderboardService._cachedBoards.Secrets) do
                table.insert(lines, string.format("#%d  %-16s  %d Secrets", row.Rank, row.Name, row.Value))
            end
            rowsLbl.Text = if #lines > 0 then table.concat(lines, "\n") else "Be the first to find a 0.01% Secret!"
        end
    end
end

function LeaderboardService.GetSnapshot(): { NetWorth: { LeaderboardEntry }, Steals: { LeaderboardEntry }, Secrets: { LeaderboardEntry } }
    LeaderboardService.RefreshAllBoards()
    return LeaderboardService._cachedBoards
end

function LeaderboardService.Start()
    Remotes.GetFunction("GetLeaderboard").OnServerInvoke = function()
        return LeaderboardService.GetSnapshot()
    end

    task.spawn(function()
        while true do
            LeaderboardService.PushOnlineScores()
            LeaderboardService.RefreshAllBoards()
            task.wait(GameConfig.LEADERBOARD_REFRESH_SECONDS)
        end
    end)
end

return LeaderboardService
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001B">
  <Properties>
    <string name="Name">MonetizationService</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Ethical Cosmetic-First Robux Monetization & Cosmetic Appearance Service
-- Handles GamePass checks, ProcessReceipt, equipping Skins / Base Designs / Animations / VIP / Pets

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local CosmeticCatalog = require(Shared.CosmeticCatalog)
local Remotes = require(Shared.Remotes)
local Utils = require(Shared.Utils)

local DataService = require(script.Parent.DataService)
local BaseService = require(script.Parent.BaseService)

local MonetizationService = {}
MonetizationService._rateLimiter = Utils.CreateRateLimiter()

local function applyCharacterCosmetics(player: Player)
    local profile = DataService.GetProfile(player)
    local char = player.Character
    if not profile or not char then
        return
    end

    local head = char:FindFirstChild("Head") :: BasePart?
    local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?

    -- 1. VIP Gold Crown Overhead Name Tag
    if head then
        local oldVip = head:FindFirstChild("VIPOverheadGui")
        if oldVip then
            oldVip:Destroy()
        end
        if profile.EquippedCosmetics.VipTagEnabled then
            local bb = Instance.new("BillboardGui")
            bb.Name = "VIPOverheadGui"
            bb.Size = UDim2.fromOffset(170, 38)
            bb.StudsOffset = Vector3.new(0, 2.7, 0)
            bb.AlwaysOnTop = false
            bb.MaxDistance = 85
            bb.Parent = head

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.fromScale(1, 1)
            lbl.BackgroundColor3 = Color3.fromRGB(22, 18, 12)
            lbl.BackgroundTransparency = 0.25
            lbl.Font = Enum.Font.GothamBlack
            lbl.TextScaled = true
            lbl.TextColor3 = Color3.fromRGB(255, 215, 55)
            lbl.Text = "👑 VIP  " .. player.Name
            lbl.Parent = bb

            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(0, 8)
            c.Parent = lbl
        end
    end

    -- 2. Custom Character Skin Aura / Trail
    if hrp then
        local oldAura = char:FindFirstChild("CosmeticSkinAura")
        if oldAura then
            oldAura:Destroy()
        end
        local skinId = profile.EquippedCosmetics.CharacterSkin
        if skinId then
            local asset = CosmeticCatalog.GetAsset(skinId)
            if asset then
                local aura = Instance.new("Highlight")
                aura.Name = "CosmeticSkinAura"
                aura.FillColor = asset.PrimaryColor
                aura.OutlineColor = asset.SecondaryColor
                aura.FillTransparency = 0.72
                aura.OutlineTransparency = 0.1
                aura.Parent = char
            end
        end

        -- 3. Purely Cosmetic Shoulder Pet Companion
        local oldPet = char:FindFirstChild("CosmeticPetCompanion")
        if oldPet then
            oldPet:Destroy()
        end
        local petId = profile.EquippedCosmetics.PetSkin
        if petId then
            local petAsset = CosmeticCatalog.GetAsset(petId)
            if petAsset then
                local pet = Instance.new("Part")
                pet.Name = "CosmeticPetCompanion"
                pet.Size = Vector3.new(1.3, 1.3, 1.3)
                pet.Shape = Enum.PartType.Ball
                pet.Color = petAsset.PrimaryColor
                pet.Material = Enum.Material.Neon
                pet.CanCollide = false
                pet.Massless = true
                pet.CFrame = hrp.CFrame * CFrame.new(2.3, 2.2, 1.2)
                pet.Parent = char

                local weld = Instance.new("WeldConstraint")
                weld.Part0 = hrp
                weld.Part1 = pet
                weld.Parent = pet

                local light = Instance.new("PointLight")
                light.Color = petAsset.SecondaryColor
                light.Range = 10
                light.Brightness = 1.6
                light.Parent = pet
            end
        end
    end

    player:SetAttribute("EquippedAnimationPack", profile.EquippedCosmetics.AnimationPack or "")
end

function MonetizationService.GrantProduct(player: Player, productId: string): boolean
    local profile = DataService.GetProfile(player)
    local prod = CosmeticCatalog.GetProduct(productId)
    if not profile or not prod then
        return false
    end

    profile.OwnedProducts[productId] = true
    -- Auto-equip VIP tag immediately on purchase
    if prod.Category == "VipTag" or productId == "prod_extra_cosmetic_pack" then
        profile.EquippedCosmetics.VipTagEnabled = true
    end
    DataService.MarkDirty(player)
    applyCharacterCosmetics(player)
    BaseService.SyncProfileToClient(player)
    return true
end

function MonetizationService.SyncMarketplaceOwnership(player: Player)
    local profile = DataService.GetProfile(player)
    if not profile then
        return
    end
    for _, prod in ipairs(CosmeticCatalog.Products) do
        if not profile.OwnedProducts[prod.Id] and prod.GamePassId > 0 then
            local ok, owns = pcall(function()
                return MarketplaceService:UserOwnsGamePassAsync(player.UserId, prod.GamePassId)
            end)
            if ok and owns then
                profile.OwnedProducts[prod.Id] = true
            end
        end
    end
    applyCharacterCosmetics(player)
end

function MonetizationService.EquipCosmetic(player: Player, assetId: string?): (boolean, string)
    local profile = DataService.GetProfile(player)
    if not profile then
        return false, "Profile missing"
    end
    if assetId == nil or assetId == "" then
        return false, "Invalid asset"
    end

    local asset = CosmeticCatalog.GetAsset(assetId)
    if not asset then
        return false, "Cosmetic not found"
    end

    if not CosmeticCatalog.PlayerOwnsAsset(profile.OwnedProducts, assetId) then
        return false, "Not owned"
    end

    if asset.Category == "CharacterSkin" then
        profile.EquippedCosmetics.CharacterSkin = if profile.EquippedCosmetics.CharacterSkin == assetId then nil else assetId
    elseif asset.Category == "BaseDesign" then
        profile.EquippedCosmetics.BaseDesign = if profile.EquippedCosmetics.BaseDesign == assetId then nil else assetId
        local slot = BaseService.GetPlayerSlot(player)
        if slot then
            BaseService.RefreshBaseVisuals(slot)
        end
    elseif asset.Category == "AnimationPack" then
        profile.EquippedCosmetics.AnimationPack = if profile.EquippedCosmetics.AnimationPack == assetId then nil else assetId
    elseif asset.Category == "PetSkin" then
        profile.EquippedCosmetics.PetSkin = if profile.EquippedCosmetics.PetSkin == assetId then nil else assetId
    elseif asset.Category == "VipTag" then
        profile.EquippedCosmetics.VipTagEnabled = not profile.EquippedCosmetics.VipTagEnabled
    end

    DataService.MarkDirty(player)
    applyCharacterCosmetics(player)
    BaseService.SyncProfileToClient(player)
    return true, "Updated!"
end

-- Developer Receipt Handler for repeatable DevProducts
function MonetizationService.ProcessReceipt(receiptInfo: { PlayerId: number, ProductId: number }): Enum.ProductPurchaseDecision
    local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
    if not player then
        return Enum.ProductPurchaseDecision.NotProcessedYet
    end

    for _, prod in ipairs(CosmeticCatalog.Products) do
        if prod.DevProductId == receiptInfo.ProductId or prod.GamePassId == receiptInfo.ProductId then
            local granted = MonetizationService.GrantProduct(player, prod.Id)
            if granted then
                return Enum.ProductPurchaseDecision.PurchaseGranted
            end
        end
    end

    return Enum.ProductPurchaseDecision.NotProcessedYet
end

function MonetizationService.Start()
    MarketplaceService.ProcessReceipt = MonetizationService.ProcessReceipt

    MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
        if wasPurchased then
            local prod = CosmeticCatalog.ProductByGamePassId[gamePassId]
            if prod then
                MonetizationService.GrantProduct(player, prod.Id)
            end
        end
    end)

    Remotes.GetEvent("RequestPromptProduct").OnServerEvent:Connect(function(player, productId)
        if type(productId) ~= "string" then
            return
        end
        if not MonetizationService._rateLimiter:Check(player.UserId, "PromptBuy", 0.6) then
            return
        end
        local prod = CosmeticCatalog.GetProduct(productId)
        if not prod then
            return
        end

        if RunService:IsStudio() then
            -- In unpublished Studio playtest, allow instant cosmetic unlock preview for testing!
            MonetizationService.GrantProduct(player, prod.Id)
            return
        end

        pcall(function()
            MarketplaceService:PromptGamePassPurchase(player, prod.GamePassId)
        end)
    end)

    Remotes.GetEvent("RequestEquipCosmetic").OnServerEvent:Connect(function(player, assetId)
        if type(assetId) ~= "string" then
            return
        end
        if not MonetizationService._rateLimiter:Check(player.UserId, "EquipCosmetic", 0.25) then
            return
        end
        MonetizationService.EquipCosmetic(player, assetId)
    end)

    Remotes.GetEvent("RequestSetLanguage").OnServerEvent:Connect(function(player, lang)
        if lang ~= "en" and lang ~= "tr" then
            return
        end
        local profile = DataService.GetProfile(player)
        if profile then
            profile.PreferredLanguage = lang
            DataService.MarkDirty(player)
            BaseService.SyncProfileToClient(player)
        end
    end)

    Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function()
            task.wait(0.2)
            applyCharacterCosmetics(player)
        end)
    end)

    Players.PlayerRemoving:Connect(function(player)
        MonetizationService._rateLimiter:ClearPlayer(player.UserId)
    end)
end

return MonetizationService
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001C">
  <Properties>
    <string name="Name">QuestCodeService</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Daily Quests, Promo Code Redemption, Black-Market Merchant & Rebirth/Ascension Service

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Types = require(Shared.Types)
local GameConfig = require(Shared.GameConfig)
local RarityConfig = require(Shared.RarityConfig)
local MutationConfig = require(Shared.MutationConfig)
local ItemCatalog = require(Shared.ItemCatalog)
local QuestAndCodeConfig = require(Shared.QuestAndCodeConfig)
local Remotes = require(Shared.Remotes)
local Utils = require(Shared.Utils)

local DataService = require(script.Parent.DataService)
local BaseService = require(script.Parent.BaseService)
local CarryStealService = require(script.Parent.CarryStealService)

local QuestCodeService = {}
QuestCodeService._rateLimiter = Utils.CreateRateLimiter()

local function pushFeedback(player: Player, ok: boolean, message: string)
    Remotes.GetEvent("ActionFeedback"):FireClient(player, {
        Success = ok,
        Message = message,
    })
end

function QuestCodeService.RedeemCode(player: Player, rawCode: string): (boolean, string)
    local profile = DataService.GetProfile(player)
    if not profile then
        return false, "Profile unavailable"
    end
    local clean = string.upper((string.gsub(rawCode, "%s+", "")))
    local codeDef = QuestAndCodeConfig.PromoCodes[clean]
    if not codeDef or not codeDef.Active then
        return false, "Invalid or expired code"
    end
    if profile.RedeemedCodes[clean] then
        return false, "Code already redeemed!"
    end

    profile.RedeemedCodes[clean] = true
    DataService.AddCash(player, codeDef.RewardCash)
    if codeDef.LuckDurationSeconds and codeDef.LuckDurationSeconds > 0 then
        local now = os.time()
        local base = math.max(now, profile.ActiveBuffs.LuckUntil or 0)
        profile.ActiveBuffs.LuckUntil = base + codeDef.LuckDurationSeconds
    end

    DataService.MarkDirty(player)
    BaseService.SyncProfileToClient(player)
    return true, codeDef.Description
end

function QuestCodeService.ClaimQuest(player: Player, questId: string): (boolean, string)
    local profile = DataService.GetProfile(player)
    if not profile then
        return false, "Profile unavailable"
    end
    DataService.EnsureDailyQuestReset(profile)

    if profile.ClaimedQuests[questId] then
        return false, "Already claimed today!"
    end

    local targetDef: QuestAndCodeConfig.QuestDef? = nil
    for _, q in ipairs(QuestAndCodeConfig.DailyQuests) do
        if q.Id == questId then
            targetDef = q
            break
        end
    end
    if not targetDef then
        return false, "Quest not found"
    end

    local progress = (profile.QuestProgress :: any)[targetDef.StatKey] or 0
    if progress < targetDef.Target then
        return false, string.format("Progress %d/%d", progress, targetDef.Target)
    end

    profile.ClaimedQuests[questId] = true
    DataService.AddCash(player, targetDef.RewardCash)
    DataService.MarkDirty(player)
    BaseService.SyncProfileToClient(player)
    return true, string.format("Claimed +%s!", Utils.FormatCash(targetDef.RewardCash))
end

function QuestCodeService.BuyMerchantItem(player: Player, merchantId: string): (boolean, string)
    local profile = DataService.GetProfile(player)
    if not profile then
        return false, "Profile unavailable"
    end
    local def = QuestAndCodeConfig.MerchantById[merchantId]
    if not def then
        return false, "Merchant item not found"
    end
    if profile.Cash < def.Cost then
        return false, "Not enough Cash"
    end

    profile.Cash -= def.Cost
    local now = os.time()
    local msg = "Purchased " .. def.Name

    if def.BuffType == "LuckElixir" then
        profile.ActiveBuffs.LuckUntil = math.max(now, profile.ActiveBuffs.LuckUntil or 0) + def.DurationSeconds
    elseif def.BuffType == "Featherweight" then
        profile.ActiveBuffs.FeatherUntil = math.max(now, profile.ActiveBuffs.FeatherUntil or 0) + def.DurationSeconds
        CarryStealService.ApplyCarrierWalkSpeed(player)
    elseif def.BuffType == "ShadowCloak" then
        profile.ActiveBuffs.ShadowCloakUntil = math.max(now, profile.ActiveBuffs.ShadowCloakUntil or 0) + def.DurationSeconds
    elseif def.BuffType == "MysteryCrate" then
        local luck = DataService.GetPlayerLuckMultiplier(player) * 3.0
        local rolledRarity = RarityConfig.RollRarity(luck)
        -- Mystery Crate guarantees at least Rare!
        if RarityConfig.Get(rolledRarity).Order < 3 then
            rolledRarity = "Rare"
        end
        local pool = {}
        for _, item in ipairs(ItemCatalog.All) do
            if item.Rarity == rolledRarity and item.BiomeId ~= "WorldEvent" then
                table.insert(pool, item)
            end
        end
        local chosen = Utils.PickRandom(pool) or ItemCatalog.Get("frozen_sun")
        local mut = MutationConfig.RollMutation(luck)
        if chosen then
            if not CarryStealService.IsCarrying(player) then
                CarryStealService.GiveCarryItem(player, chosen, chosen.BiomeId, mut)
                msg = string.format("Crate dropped %s %s! Run to Base!", MutationConfig.Get(mut).Prefix, chosen.Name)
            else
                BaseService.AddExtractedItemToBase(player, chosen, "MysteryCrate", mut)
                msg = string.format("Crate added %s %s to Base!", MutationConfig.Get(mut).Prefix, chosen.Name)
            end
        end
    end

    DataService.MarkDirty(player)
    BaseService.SyncProfileToClient(player)
    return true, msg
end

function QuestCodeService.AscendRebirth(player: Player): (boolean, string)
    local profile = DataService.GetProfile(player)
    if not profile then
        return false, "Profile unavailable"
    end
    local cost = QuestAndCodeConfig.GetRebirthCost(profile.Rebirths or 0)
    if profile.Cash < cost then
        return false, string.format("Need %s Cash to Rebirth", Utils.FormatCash(cost))
    end

    -- Preserve ALL 0.01% Secrets, Discovered Codex, Gadgets, Codes & Cosmetics!
    local keptVault: { Types.OwnedItemInstance } = {}
    local slotCounter = 1
    for _, inst in ipairs(profile.VaultItems) do
        local def = ItemCatalog.Get(inst.ItemId)
        if def and (def.Rarity == "Secret" or def.IsSecret) then
            inst.PedestalSlot = if slotCounter <= 4 then slotCounter else nil
            slotCounter += 1
            table.insert(keptVault, inst)
        end
    end

    profile.Rebirths = (profile.Rebirths or 0) + 1
    profile.Cash = GameConfig.STARTING_CASH
    profile.UncollectedSafeCash = 0
    profile.BaseTier = 1
    profile.VaultItems = keptVault

    DataService.MarkDirty(player)
    local slot = BaseService.GetPlayerSlot(player)
    if slot then
        BaseService.RefreshBaseVisuals(slot)
    end
    BaseService.SyncProfileToClient(player)

    Remotes.GetEvent("FeedAnnouncement"):FireAllClients({
        Type = "PlayerRebirth",
        PlayerName = player.Name,
        Rebirths = profile.Rebirths,
    })

    return true, string.format("ASCENDED TO REBIRTH %d! (+%.0f%% Income)", profile.Rebirths, profile.Rebirths * 50)
end

function QuestCodeService.Start()
    Remotes.GetEvent("RequestRedeemCode").OnServerEvent:Connect(function(player, code)
        if type(code) ~= "string" then
            return
        end
        if not QuestCodeService._rateLimiter:Check(player.UserId, "Code", 0.75) then
            return
        end
        local ok, msg = QuestCodeService.RedeemCode(player, code)
        pushFeedback(player, ok, msg)
    end)

    Remotes.GetEvent("RequestClaimQuest").OnServerEvent:Connect(function(player, questId)
        if type(questId) ~= "string" then
            return
        end
        if not QuestCodeService._rateLimiter:Check(player.UserId, "ClaimQuest", 0.4) then
            return
        end
        local ok, msg = QuestCodeService.ClaimQuest(player, questId)
        pushFeedback(player, ok, msg)
    end)

    Remotes.GetEvent("RequestBuyMerchantItem").OnServerEvent:Connect(function(player, merchId)
        if type(merchId) ~= "string" then
            return
        end
        if not QuestCodeService._rateLimiter:Check(player.UserId, "BuyMerch", 0.5) then
            return
        end
        local ok, msg = QuestCodeService.BuyMerchantItem(player, merchId)
        pushFeedback(player, ok, msg)
    end)

    Remotes.GetEvent("RequestRebirth").OnServerEvent:Connect(function(player)
        if not QuestCodeService._rateLimiter:Check(player.UserId, "Rebirth", 1.5) then
            return
        end
        local ok, msg = QuestCodeService.AscendRebirth(player)
        pushFeedback(player, ok, msg)
    end)

    Players.PlayerRemoving:Connect(function(player)
        QuestCodeService._rateLimiter:ClearPlayer(player.UserId)
    end)
end

return QuestCodeService
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001D">
  <Properties>
    <string name="Name">SecretService</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- 0.01% SECRET COLLECTION & Galaxy Egg Hatching + Global MessagingService Announcements

local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Types = require(Shared.Types)
local GameConfig = require(Shared.GameConfig)
local ItemCatalog = require(Shared.ItemCatalog)
local Remotes = require(Shared.Remotes)
local Utils = require(Shared.Utils)

local DataService = require(script.Parent.DataService)

local SecretService = {}
SecretService._subscribed = false
SecretService._recentAnnouncements = {} :: { { PlayerName: string, ItemId: string, ItemName: string, Timestamp: number } }

function SecretService.PublishSecretDiscovery(player: Player, itemDef: Types.ItemDefinition)
    local profile = DataService.GetProfile(player)
    local isFirstPersonal = false
    if profile then
        if not profile.DiscoveredSecrets[itemDef.Id] then
            profile.DiscoveredSecrets[itemDef.Id] = os.time()
            isFirstPersonal = true
        end
        profile.SecretCount += 1
        DataService.MarkDirty(player)
    end

    local payload = {
        PlayerName = player.DisplayName ~= "" and player.DisplayName or player.Name,
        Username = player.Name,
        UserId = player.UserId,
        ItemId = itemDef.Id,
        ItemName = itemDef.Name,
        ItemNameTR = itemDef.NameTR,
        Icon = itemDef.Icon,
        Rarity = itemDef.Rarity,
        IsFirstPersonal = isFirstPersonal,
        Timestamp = os.time(),
    }

    -- Broadcast immediately to current server
    Remotes.GetEvent("GlobalSecretAnnouncement"):FireAllClients(payload)
    table.insert(SecretService._recentAnnouncements, 1, {
        PlayerName = payload.PlayerName,
        ItemId = itemDef.Id,
        ItemName = itemDef.Name,
        Timestamp = payload.Timestamp,
    })
    if #SecretService._recentAnnouncements > 20 then
        table.remove(SecretService._recentAnnouncements)
    end

    -- Publish globally across ALL active Roblox servers via MessagingService
    task.spawn(function()
        pcall(function()
            MessagingService:PublishAsync(GameConfig.MESSAGING_SECRET_TOPIC, payload)
        end)
    end)
end

function SecretService.HatchGalaxyEgg(player: Player, instanceUid: string): (boolean, string?, Types.OwnedItemInstance?)
    local profile = DataService.GetProfile(player)
    if not profile then
        return false, "Profile not loaded", nil
    end

    local targetItem: Types.OwnedItemInstance? = nil
    for _, inst in ipairs(profile.VaultItems) do
        if inst.Uid == instanceUid then
            targetItem = inst
            break
        end
    end

    if not targetItem then
        return false, "Item not found", nil
    end

    local def = ItemCatalog.Get(targetItem.ItemId)
    if not def or def.SpecialBehavior ~= "HatchableEgg" then
        return false, "Only Galaxy Eggs can be hatched", nil
    end

    if targetItem.HatchedCreature ~= nil then
        return false, "Already hatched into " .. targetItem.HatchedCreature, nil
    end

    local creature = ItemCatalog.RollGalaxyCreature()
    targetItem.HatchedCreature = creature.Id
    DataService.MarkDirty(player)

    Remotes.GetEvent("FeedAnnouncement"):FireAllClients({
        Type = "EggHatched",
        PlayerName = player.Name,
        ItemName = def.Name,
        CreatureName = creature.Name,
        CreatureNameTR = creature.NameTR,
        Icon = creature.Icon,
        Multiplier = creature.BonusIncomeMultiplier,
    })

    return true, creature.Id, targetItem
end

function SecretService.GetRecentAnnouncements(): { { PlayerName: string, ItemId: string, ItemName: string, Timestamp: number } }
    return Utils.DeepCopy(SecretService._recentAnnouncements)
end

function SecretService.Start()
    if SecretService._subscribed then
        return
    end
    SecretService._subscribed = true

    task.spawn(function()
        pcall(function()
            MessagingService:SubscribeAsync(GameConfig.MESSAGING_SECRET_TOPIC, function(message)
                local data = message and message.Data
                if type(data) ~= "table" then
                    return
                end
                -- Skip duplicate echo if player is right here in this server
                if Players:GetPlayerByUserId(tonumber(data.UserId) or 0) ~= nil then
                    return
                end
                Remotes.GetEvent("GlobalSecretAnnouncement"):FireAllClients(data)
            end)
        end)
    end)
end

return SecretService
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001E">
  <Properties>
    <string name="Name">ShopService</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Free-to-Play Cash Progression Shop: Tech Upgrades & In-Game Utility Gadgets

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local BaseConfig = require(Shared.BaseConfig)
local Remotes = require(Shared.Remotes)
local Utils = require(Shared.Utils)

local DataService = require(script.Parent.DataService)
local BaseService = require(script.Parent.BaseService)
local CarryStealService = require(script.Parent.CarryStealService)
local ItemSpawnService = require(script.Parent.ItemSpawnService)

local ShopService = {}
ShopService._gadgetCooldowns = {} :: { [string]: number }
ShopService._rateLimiter = Utils.CreateRateLimiter()

function ShopService.BuyTechUpgrade(player: Player, techId: string): (boolean, string)
    local profile = DataService.GetProfile(player)
    if not profile then
        return false, "Profile missing"
    end
    local currentLevel = profile.TechLevels[techId]
    if currentLevel == nil then
        return false, "Invalid tech"
    end
    local cost = BaseConfig.GetTechCost(techId, currentLevel)
    if not cost then
        return false, "Already Max Level!"
    end
    if profile.Cash < cost then
        return false, "Not enough Cash"
    end

    profile.Cash -= cost
    profile.TechLevels[techId] = currentLevel + 1
    DataService.MarkDirty(player)
    CarryStealService.ApplyCarrierWalkSpeed(player)
    BaseService.SyncProfileToClient(player)
    return true, "Upgraded!"
end

function ShopService.BuyGadget(player: Player, gadgetId: string): (boolean, string)
    local profile = DataService.GetProfile(player)
    if not profile then
        return false, "Profile missing"
    end
    local def = BaseConfig.GadgetById[gadgetId]
    if not def then
        return false, "Invalid gadget"
    end
    if profile.OwnedGadgets[gadgetId] then
        return false, "Already owned"
    end
    if profile.Cash < def.Cost then
        return false, "Not enough Cash"
    end

    profile.Cash -= def.Cost
    profile.OwnedGadgets[gadgetId] = true
    DataService.MarkDirty(player)
    BaseService.SyncProfileToClient(player)
    return true, "Purchased!"
end

function ShopService.ActivateGadget(player: Player, gadgetId: string): (boolean, any?)
    local profile = DataService.GetProfile(player)
    if not profile or not profile.OwnedGadgets[gadgetId] then
        return false, "Gadget not owned"
    end
    local def = BaseConfig.GadgetById[gadgetId]
    if not def then
        return false, "Invalid gadget"
    end

    local key = tostring(player.UserId) .. ":" .. gadgetId
    local now = os.clock()
    local readyAt = ShopService._gadgetCooldowns[key] or 0
    if now < readyAt then
        return false, string.format("Cooldown %.1fs", readyAt - now)
    end
    ShopService._gadgetCooldowns[key] = now + def.Cooldown

    local char = player.Character
    local hrp = if char then char:FindFirstChild("HumanoidRootPart") :: BasePart? else nil

    if gadgetId == "speed_coil" then
        player:SetAttribute("GadgetSpeedBoost", 12)
        CarryStealService.ApplyCarrierWalkSpeed(player)
        task.delay(4.5, function()
            if player.Parent then
                player:SetAttribute("GadgetSpeedBoost", 0)
                CarryStealService.ApplyCarrierWalkSpeed(player)
            end
        end)
        return true, { Type = "speed_coil", Duration = 4.5 }
    elseif gadgetId == "phase_dash" then
        if hrp then
            hrp.AssemblyLinearVelocity = hrp.CFrame.LookVector * 65 + Vector3.new(0, 12, 0)
        end
        return true, { Type = "phase_dash" }
    elseif gadgetId == "magnet_radar" then
        local rarest = ItemSpawnService.GetRarestActiveNode()
        if rarest then
            return true, {
                Type = "magnet_radar",
                TargetPos = rarest.Position,
                ItemName = rarest.ItemDef.Name,
                Rarity = rarest.ItemDef.Rarity,
            }
        end
        return true, { Type = "magnet_radar", TargetPos = nil }
    elseif gadgetId == "frost_bolas" then
        if hrp then
            for _, other in ipairs(Players:GetPlayers()) do
                if other ~= player and CarryStealService.IsCarrying(other) then
                    local oChar = other.Character
                    local oRoot = if oChar then oChar:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
                    local oHum = if oChar then oChar:FindFirstChildOfClass("Humanoid") else nil
                    if oRoot and oHum and (oRoot.Position - hrp.Position).Magnitude <= 26 then
                        oHum.WalkSpeed = 8
                        task.delay(2.5, function()
                            if other.Parent then
                                CarryStealService.ApplyCarrierWalkSpeed(other)
                            end
                        end)
                    end
                end
            end
        end
        return true, { Type = "frost_bolas" }
    end

    return false, "Unknown gadget"
end

function ShopService.Start()
    Remotes.GetEvent("RequestUpgradeTech").OnServerEvent:Connect(function(player, techId)
        if type(techId) ~= "string" then
            return
        end
        if not ShopService._rateLimiter:Check(player.UserId, "UpgradeTech", 0.3) then
            return
        end
        ShopService.BuyTechUpgrade(player, techId)
    end)

    Remotes.GetEvent("RequestBuyGadget").OnServerEvent:Connect(function(player, gadgetId)
        if type(gadgetId) ~= "string" then
            return
        end
        if not ShopService._rateLimiter:Check(player.UserId, "BuyGadget", 0.4) then
            return
        end
        ShopService.BuyGadget(player, gadgetId)
    end)

    Remotes.GetEvent("RequestUseGadget").OnServerEvent:Connect(function(player, gadgetId)
        if type(gadgetId) ~= "string" then
            return
        end
        if not ShopService._rateLimiter:Check(player.UserId, "UseGadget", 0.4) then
            return
        end
        local ok, payload = ShopService.ActivateGadget(player, gadgetId)
        if ok and payload then
            Remotes.GetEvent("CosmeticFXBurst"):FireClient(player, payload)
        end
    end)

    Players.PlayerRemoving:Connect(function(player)
        ShopService._rateLimiter:ClearPlayer(player.UserId)
    end)
end

return ShopService
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001F">
  <Properties>
    <string name="Name">SpecialZoneService</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- 15-Minute Rotating Special Zone ("THE RIFT DIMENSION")
-- Every 15 minutes (900s), opens a high-tier rotating zone for 5 minutes (300s).

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local GameConfig = require(Shared.GameConfig)
local BiomeConfig = require(Shared.BiomeConfig)
local Remotes = require(Shared.Remotes)

local WorldBuilder = require(script.Parent.WorldBuilder)
local ItemSpawnService = require(script.Parent.ItemSpawnService)

local SpecialZoneService = {}
SpecialZoneService.IsActive = false
SpecialZoneService.CurrentThemeIndex = 1
SpecialZoneService.ActiveUntil = 0
SpecialZoneService.NextOpenAt = 0
SpecialZoneService._portalTouchConn = nil :: RBXScriptConnection?

function SpecialZoneService.GetCurrentTheme(): BiomeConfig.SpecialRiftTheme
    return BiomeConfig.SpecialRiftThemes[SpecialZoneService.CurrentThemeIndex] or BiomeConfig.SpecialRiftThemes[1]
end

local function updatePortalVisuals(open: boolean, theme: BiomeConfig.SpecialRiftTheme)
    local gate = WorldBuilder.RiftPortalRing
    if not gate then
        return
    end
    gate:SetAttribute("RiftPortalActive", open)
    gate.Color = theme.AccentColor
    gate.Transparency = if open then 0.2 else 0.85

    local sign = gate:FindFirstChild("WorldSign")
    local frame = if sign then sign:FindFirstChildOfClass("Frame") else nil
    local label = if frame then frame:FindFirstChildOfClass("TextLabel") else nil
    if label then
        label.Text = if open
            then ("🌀 " .. theme.Name:upper() .. "\nENTER RIFT!")
            else ("15M SPECIAL RIFT\nNEXT: " .. theme.Name:upper())
    end

    if WorldBuilder.RiftArenaFolder then
        local plat = WorldBuilder.RiftArenaFolder:FindFirstChild("RiftPlatform") :: BasePart?
        if plat then
            plat.Color = theme.PrimaryColor
        end
    end
end

function SpecialZoneService.OpenRift(durationOverride: number?)
    if SpecialZoneService.IsActive then
        return
    end
    local dur = durationOverride or GameConfig.SPECIAL_ZONE_DURATION_SECONDS
    local theme = SpecialZoneService.GetCurrentTheme()

    SpecialZoneService.IsActive = true
    SpecialZoneService.ActiveUntil = os.time() + dur
    updatePortalVisuals(true, theme)

    -- Populate Rift loot immediately!
    for _ = 1, GameConfig.MAX_RIFT_ITEMS do
        ItemSpawnService.SpawnInBiome("SpecialRift", theme.LuckMultiplier)
    end

    Remotes.GetEvent("SpecialRiftFX"):FireAllClients({
        Active = true,
        ThemeId = theme.Id,
        ThemeName = theme.Name,
        ThemeNameTR = theme.NameTR,
        TimeRemaining = dur,
    })

    Remotes.GetEvent("FeedAnnouncement"):FireAllClients({
        Type = "SpecialRiftOpened",
        ThemeName = theme.Name,
        ThemeNameTR = theme.NameTR,
    })
end

function SpecialZoneService.CloseRift()
    if not SpecialZoneService.IsActive then
        return
    end
    SpecialZoneService.IsActive = false
    SpecialZoneService.NextOpenAt = os.time() + GameConfig.SPECIAL_ZONE_INTERVAL_SECONDS

    -- Evacuate any players still on Rift Sky Platform safely to Central Plaza
    for _, player in ipairs(Players:GetPlayers()) do
        local char = player.Character
        local hrp = if char then char:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
        if hrp and (hrp.Position - GameConfig.RIFT_ARENA_POSITION).Magnitude < 90 then
            hrp.CFrame = CFrame.new(0, 7, 26)
        end
    end

    ItemSpawnService.ClearBiomeSpawns("SpecialRift")
    SpecialZoneService.CurrentThemeIndex = (SpecialZoneService.CurrentThemeIndex % #BiomeConfig.SpecialRiftThemes) + 1
    updatePortalVisuals(false, SpecialZoneService.GetCurrentTheme())

    Remotes.GetEvent("SpecialRiftFX"):FireAllClients({
        Active = false,
        NextOpenIn = GameConfig.SPECIAL_ZONE_INTERVAL_SECONDS,
    })
end

function SpecialZoneService.Step(nowTime: number)
    if SpecialZoneService.IsActive then
        if nowTime >= SpecialZoneService.ActiveUntil then
            SpecialZoneService.CloseRift()
        end
    else
        if nowTime >= SpecialZoneService.NextOpenAt then
            SpecialZoneService.OpenRift()
        end
    end
end

function SpecialZoneService.GetTimerState(nowTime: number?): { IsOpen: boolean, SecondsLeft: number, ThemeName: string }
    local now = nowTime or os.time()
    local theme = SpecialZoneService.GetCurrentTheme()
    if SpecialZoneService.IsActive then
        return {
            IsOpen = true,
            SecondsLeft = math.max(0, SpecialZoneService.ActiveUntil - now),
            ThemeName = theme.Name,
        }
    end
    return {
        IsOpen = false,
        SecondsLeft = math.max(0, SpecialZoneService.NextOpenAt - now),
        ThemeName = theme.Name,
    }
end

function SpecialZoneService.Start()
    SpecialZoneService.NextOpenAt = os.time() + GameConfig.SPECIAL_ZONE_INTERVAL_SECONDS
    updatePortalVisuals(false, SpecialZoneService.GetCurrentTheme())

    ItemSpawnService.SetRiftCheck(function()
        return SpecialZoneService.IsActive, SpecialZoneService.GetCurrentTheme().LuckMultiplier
    end)

    -- Portal teleport to Rift Sky Arena
    local gate = WorldBuilder.RiftPortalRing
    if gate then
        local tpCooldown: { [number]: number } = {}
        gate.Touched:Connect(function(hit: BasePart)
            if not SpecialZoneService.IsActive then
                return
            end
            local model = hit:FindFirstAncestorOfClass("Model")
            local player = if model then Players:GetPlayerFromCharacter(model) else nil
            local hrp = if model then model:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
            if player and hrp then
                local now = os.clock()
                local lastTp = tpCooldown[player.UserId]
                if lastTp ~= nil and (now - lastTp) < 1.5 then
                    return
                end
                tpCooldown[player.UserId] = now
                hrp.CFrame = CFrame.new(GameConfig.RIFT_ARENA_POSITION + Vector3.new(0, 5, 32))
            end
        end)
    end

    -- Exit pad back to Central Plaza (players carrying Rift loot must sprint back!)
    for _, pad in ipairs(CollectionService:GetTagged("RiftReturnPad")) do
        if pad:IsA("BasePart") then
            local retCooldown: { [number]: number } = {}
            pad.Touched:Connect(function(hit: BasePart)
                local model = hit:FindFirstAncestorOfClass("Model")
                local player = if model then Players:GetPlayerFromCharacter(model) else nil
                local hrp = if model then model:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
                if player and hrp then
                    local now = os.clock()
                    local lastRet = retCooldown[player.UserId]
                    if lastRet ~= nil and (now - lastRet) < 1.5 then
                        return
                    end
                    retCooldown[player.UserId] = now
                    hrp.CFrame = CFrame.new(0, 7, 26)
                end
            end)
        end
    end
end

return SpecialZoneService
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000020">
  <Properties>
    <string name="Name">SquadService</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Squad / Team Party Management for Co-op Big Heists ("Arkadaşlarıyla takım kurup büyük soygunlara katılacak")

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Types = require(Shared.Types)
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Utils = require(Shared.Utils)

local SquadService = {}
SquadService._squads = {} :: { [string]: Types.SquadData }
SquadService._playerSquad = {} :: { [number]: string }
SquadService._pendingInvites = {} :: { [number]: string } -- targetUserId -> squadId
SquadService._rateLimiter = Utils.CreateRateLimiter()

function SquadService.GetPlayerSquad(player: Player): Types.SquadData?
    local squadId = SquadService._playerSquad[player.UserId]
    if not squadId then
        return nil
    end
    return SquadService._squads[squadId]
end

function SquadService.GetSquadMembersPlayers(squadId: string): { Player }
    local squad = SquadService._squads[squadId]
    if not squad then
        return {}
    end
    local res: { Player } = {}
    for _, uid in ipairs(squad.Members) do
        local p = Players:GetPlayerByUserId(uid)
        if p then
            table.insert(res, p)
        end
    end
    return res
end

local function broadcastSquad(squadId: string)
    local squad = SquadService._squads[squadId]
    if not squad then
        return
    end
    local memberInfo = {}
    for _, uid in ipairs(squad.Members) do
        local p = Players:GetPlayerByUserId(uid)
        table.insert(memberInfo, {
            UserId = uid,
            Name = if p then p.Name else "Player_" .. tostring(uid),
            IsLeader = (uid == squad.LeaderUserId),
        })
    end
    local payload = {
        SquadId = squad.SquadId,
        LeaderUserId = squad.LeaderUserId,
        Members = memberInfo,
    }
    for _, p in ipairs(SquadService.GetSquadMembersPlayers(squadId)) do
        Remotes.GetEvent("SquadStateSync"):FireClient(p, payload)
    end
end

function SquadService.CreateSquad(leader: Player): (boolean, Types.SquadData?)
    if SquadService._playerSquad[leader.UserId] ~= nil then
        return false, SquadService.GetPlayerSquad(leader)
    end
    local id = Utils.GenerateUid("squad")
    local squad: Types.SquadData = {
        SquadId = id,
        LeaderUserId = leader.UserId,
        Members = { leader.UserId },
        CreatedAt = os.time(),
    }
    SquadService._squads[id] = squad
    SquadService._playerSquad[leader.UserId] = id
    broadcastSquad(id)
    return true, squad
end

function SquadService.InvitePlayer(leader: Player, targetUserId: number): (boolean, string)
    local squad = SquadService.GetPlayerSquad(leader)
    if not squad then
        local ok, newSquad = SquadService.CreateSquad(leader)
        if not ok or not newSquad then
            return false, "Could not create squad"
        end
        squad = newSquad
    end
    local sq = squad :: Types.SquadData
    if sq.LeaderUserId ~= leader.UserId then
        return false, "Only squad leader can invite"
    end
    if #sq.Members >= GameConfig.HEIST_MAX_PLAYERS then
        return false, "Squad is full"
    end
    if targetUserId == leader.UserId then
        return false, "Cannot invite yourself"
    end
    if SquadService._playerSquad[targetUserId] ~= nil then
        return false, "Player already in a squad"
    end
    local target = Players:GetPlayerByUserId(targetUserId)
    if not target then
        return false, "Player not found"
    end

    SquadService._pendingInvites[targetUserId] = sq.SquadId
    Remotes.GetEvent("SquadInvitePrompt"):FireClient(target, {
        SquadId = sq.SquadId,
        LeaderName = leader.Name,
        LeaderUserId = leader.UserId,
    })
    return true, "Invite sent"
end

function SquadService.AcceptInvite(player: Player, squadId: string): (boolean, string)
    if SquadService._playerSquad[player.UserId] ~= nil then
        return false, "Already in a squad"
    end
    local pending = SquadService._pendingInvites[player.UserId]
    if pending ~= squadId then
        return false, "Invite expired or invalid"
    end
    local squad = SquadService._squads[squadId]
    if not squad then
        SquadService._pendingInvites[player.UserId] = nil
        return false, "Squad disbanded"
    end
    if #squad.Members >= GameConfig.HEIST_MAX_PLAYERS then
        return false, "Squad full"
    end

    SquadService._pendingInvites[player.UserId] = nil
    table.insert(squad.Members, player.UserId)
    SquadService._playerSquad[player.UserId] = squadId
    broadcastSquad(squadId)
    return true, "Joined squad!"
end

function SquadService.LeaveSquad(player: Player)
    local squadId = SquadService._playerSquad[player.UserId]
    if not squadId then
        return
    end
    local squad = SquadService._squads[squadId]
    SquadService._playerSquad[player.UserId] = nil
    Remotes.GetEvent("SquadStateSync"):FireClient(player, nil)

    if not squad then
        return
    end

    for i, uid in ipairs(squad.Members) do
        if uid == player.UserId then
            table.remove(squad.Members, i)
            break
        end
    end

    if #squad.Members == 0 then
        SquadService._squads[squadId] = nil
    else
        if squad.LeaderUserId == player.UserId then
            squad.LeaderUserId = squad.Members[1]
        end
        broadcastSquad(squadId)
    end
end

function SquadService.Start()
    Remotes.GetEvent("RequestCreateSquad").OnServerEvent:Connect(function(player)
        if not SquadService._rateLimiter:Check(player.UserId, "CreateSquad", 0.5) then
            return
        end
        SquadService.CreateSquad(player)
    end)

    Remotes.GetEvent("RequestLeaveSquad").OnServerEvent:Connect(function(player)
        if not SquadService._rateLimiter:Check(player.UserId, "LeaveSquad", 0.5) then
            return
        end
        SquadService.LeaveSquad(player)
    end)

    Remotes.GetEvent("RequestInviteSquad").OnServerEvent:Connect(function(player, targetUserId)
        if type(targetUserId) ~= "number" then
            return
        end
        if not SquadService._rateLimiter:Check(player.UserId, "InviteSquad", 0.75) then
            return
        end
        SquadService.InvitePlayer(player, math.floor(targetUserId))
    end)

    Remotes.GetEvent("RequestAcceptSquad").OnServerEvent:Connect(function(player, squadId)
        if type(squadId) ~= "string" then
            return
        end
        if not SquadService._rateLimiter:Check(player.UserId, "AcceptSquad", 0.5) then
            return
        end
        SquadService.AcceptInvite(player, squadId)
    end)

    Players.PlayerRemoving:Connect(function(player)
        SquadService.LeaveSquad(player)
        SquadService._pendingInvites[player.UserId] = nil
        SquadService._rateLimiter:ClearPlayer(player.UserId)
    end)
end

return SquadService
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000021">
  <Properties>
    <string name="Name">TradeService</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Atomic Server-Authoritative Player-to-Player Trading System
-- Features anti-scam confirm reset on offer modification + full ownership validation!

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Types = require(Shared.Types)
local GameConfig = require(Shared.GameConfig)
local Remotes = require(Shared.Remotes)
local Utils = require(Shared.Utils)

local DataService = require(script.Parent.DataService)
local BaseService = require(script.Parent.BaseService)

export type TradeOfferSide = {
    UserId: number,
    PlayerName: string,
    ItemUids: { string },
    Cash: number,
    Confirmed: boolean,
}

export type ActiveTrade = {
    TradeId: string,
    SideA: TradeOfferSide,
    SideB: TradeOfferSide,
    CreatedAt: number,
}

local TradeService = {}
TradeService._trades = {} :: { [string]: ActiveTrade }
TradeService._playerTrade = {} :: { [number]: string }
TradeService._pendingRequests = {} :: { [number]: { FromUserId: number, FromName: string } }
TradeService._rateLimiter = Utils.CreateRateLimiter()

local function getSides(trade: ActiveTrade, userId: number): (TradeOfferSide?, TradeOfferSide?)
    if trade.SideA.UserId == userId then
        return trade.SideA, trade.SideB
    elseif trade.SideB.UserId == userId then
        return trade.SideB, trade.SideA
    end
    return nil, nil
end

local function buildSidePayload(side: TradeOfferSide): any
    local profile = DataService.GetProfileByUserId(side.UserId)
    local itemPreviews = {}
    if profile then
        local uidSet: { [string]: boolean } = {}
        for _, uid in ipairs(side.ItemUids) do
            uidSet[uid] = true
        end
        for _, inst in ipairs(profile.VaultItems) do
            if uidSet[inst.Uid] then
                table.insert(itemPreviews, {
                    Uid = inst.Uid,
                    ItemId = inst.ItemId,
                    Mutation = inst.Mutation,
                    HatchedCreature = inst.HatchedCreature,
                })
            end
        end
    end
    return {
        UserId = side.UserId,
        PlayerName = side.PlayerName,
        Cash = side.Cash,
        Confirmed = side.Confirmed,
        Items = itemPreviews,
    }
end

local function syncTrade(trade: ActiveTrade)
    local pA = Players:GetPlayerByUserId(trade.SideA.UserId)
    local pB = Players:GetPlayerByUserId(trade.SideB.UserId)
    local payload = {
        TradeId = trade.TradeId,
        SideA = buildSidePayload(trade.SideA),
        SideB = buildSidePayload(trade.SideB),
    }
    if pA then
        Remotes.GetEvent("TradeStateSync"):FireClient(pA, payload)
    end
    if pB then
        Remotes.GetEvent("TradeStateSync"):FireClient(pB, payload)
    end
end

function TradeService.SendTradeRequest(sender: Player, targetUserId: number): (boolean, string)
    if sender.UserId == targetUserId then
        return false, "Cannot trade with yourself"
    end
    if TradeService._playerTrade[sender.UserId] ~= nil then
        return false, "Already in a trade"
    end
    if TradeService._playerTrade[targetUserId] ~= nil then
        return false, "Target player is busy"
    end
    local target = Players:GetPlayerByUserId(targetUserId)
    if not target then
        return false, "Player offline"
    end

    TradeService._pendingRequests[targetUserId] = {
        FromUserId = sender.UserId,
        FromName = sender.Name,
    }
    Remotes.GetEvent("TradeInvitePrompt"):FireClient(target, {
        FromUserId = sender.UserId,
        FromName = sender.Name,
    })
    return true, "Trade request sent!"
end

function TradeService.RespondTradeRequest(target: Player, fromUserId: number, accept: boolean): (boolean, ActiveTrade?)
    local pending = TradeService._pendingRequests[target.UserId]
    if not pending or pending.FromUserId ~= fromUserId then
        return false, nil
    end
    TradeService._pendingRequests[target.UserId] = nil

    if not accept then
        return false, nil
    end
    local sender = Players:GetPlayerByUserId(fromUserId)
    if not sender or TradeService._playerTrade[sender.UserId] ~= nil or TradeService._playerTrade[target.UserId] ~= nil then
        return false, nil
    end

    local tid = Utils.GenerateUid("trade")
    local trade: ActiveTrade = {
        TradeId = tid,
        SideA = {
            UserId = sender.UserId,
            PlayerName = sender.Name,
            ItemUids = {},
            Cash = 0,
            Confirmed = false,
        },
        SideB = {
            UserId = target.UserId,
            PlayerName = target.Name,
            ItemUids = {},
            Cash = 0,
            Confirmed = false,
        },
        CreatedAt = os.time(),
    }
    TradeService._trades[tid] = trade
    TradeService._playerTrade[sender.UserId] = tid
    TradeService._playerTrade[target.UserId] = tid
    syncTrade(trade)
    return true, trade
end

function TradeService.UpdateOffer(player: Player, itemUids: { string }, offerCash: number): (boolean, string)
    local tid = TradeService._playerTrade[player.UserId]
    local trade = if tid then TradeService._trades[tid] else nil
    local profile = DataService.GetProfile(player)
    if not trade or not profile then
        return false, "No active trade"
    end

    local mine, _other = getSides(trade, player.UserId)
    if not mine then
        return false, "Invalid trade participant"
    end

    local cleanCash = math.max(0, math.floor(offerCash))
    if cleanCash > profile.Cash then
        return false, "Insufficient Cash"
    end

    -- Verify player owns every unique offered item UID
    local ownedByUid: { [string]: boolean } = {}
    for _, inst in ipairs(profile.VaultItems) do
        ownedByUid[inst.Uid] = true
    end

    local verifiedUids: { string } = {}
    local seen: { [string]: boolean } = {}
    for _, uid in ipairs(itemUids) do
        if type(uid) == "string" and ownedByUid[uid] and not seen[uid] and #verifiedUids < 8 then
            seen[uid] = true
            table.insert(verifiedUids, uid)
        end
    end

    mine.ItemUids = verifiedUids
    mine.Cash = cleanCash
    -- Anti-scam protection: ANY offer change un-confirms both participants!
    trade.SideA.Confirmed = false
    trade.SideB.Confirmed = false
    syncTrade(trade)
    return true, "Offer updated"
end

function TradeService.CancelTrade(player: Player)
    local tid = TradeService._playerTrade[player.UserId]
    if not tid then
        return
    end
    local trade = TradeService._trades[tid]
    TradeService._trades[tid] = nil
    if trade then
        TradeService._playerTrade[trade.SideA.UserId] = nil
        TradeService._playerTrade[trade.SideB.UserId] = nil
        local pA = Players:GetPlayerByUserId(trade.SideA.UserId)
        local pB = Players:GetPlayerByUserId(trade.SideB.UserId)
        if pA then
            Remotes.GetEvent("TradeStateSync"):FireClient(pA, nil)
        end
        if pB then
            Remotes.GetEvent("TradeStateSync"):FireClient(pB, nil)
        end
    else
        TradeService._playerTrade[player.UserId] = nil
    end
end

local function executeAtomicTrade(trade: ActiveTrade): (boolean, string)
    local pA = Players:GetPlayerByUserId(trade.SideA.UserId)
    local pB = Players:GetPlayerByUserId(trade.SideB.UserId)
    local profA = if pA then DataService.GetProfile(pA) else nil
    local profB = if pB then DataService.GetProfile(pB) else nil
    if not pA or not pB or not profA or not profB then
        return false, "Participant offline"
    end

    if profA.Cash < trade.SideA.Cash or profB.Cash < trade.SideB.Cash then
        return false, "Cash verification failed"
    end

    -- Check inventory space
    local netA = #profA.VaultItems - #trade.SideA.ItemUids + #trade.SideB.ItemUids
    local netB = #profB.VaultItems - #trade.SideB.ItemUids + #trade.SideA.ItemUids
    if netA > GameConfig.MAX_VAULT_INVENTORY or netB > GameConfig.MAX_VAULT_INVENTORY then
        return false, "Vault full"
    end

    local function extractAndValidate(profile: Types.PlayerProfile, uids: { string }): (boolean, { Types.OwnedItemInstance })
        local want: { [string]: boolean } = {}
        for _, uid in ipairs(uids) do
            want[uid] = true
        end
        local moving: { Types.OwnedItemInstance } = {}
        for _, inst in ipairs(profile.VaultItems) do
            if want[inst.Uid] then
                table.insert(moving, inst)
            end
        end
        if #moving ~= #uids then
            return false, {}
        end
        return true, moving
    end

    local okA, movingFromA = extractAndValidate(profA, trade.SideA.ItemUids)
    local okB, movingFromB = extractAndValidate(profB, trade.SideB.ItemUids)
    if not okA or not okB then
        return false, "Item ownership changed"
    end

    -- Remove from source vaults
    local setA: { [string]: boolean } = {}
    for _, u in ipairs(trade.SideA.ItemUids) do
        setA[u] = true
    end
    local setB: { [string]: boolean } = {}
    for _, u in ipairs(trade.SideB.ItemUids) do
        setB[u] = true
    end

    local nextVaultA: { Types.OwnedItemInstance } = {}
    for _, inst in ipairs(profA.VaultItems) do
        if not setA[inst.Uid] then
            table.insert(nextVaultA, inst)
        end
    end
    for _, inst in ipairs(movingFromB) do
        inst.PedestalSlot = nil
        profA.DiscoveredItems[inst.ItemId] = (profA.DiscoveredItems[inst.ItemId] or 0) + 1
        table.insert(nextVaultA, inst)
    end

    local nextVaultB: { Types.OwnedItemInstance } = {}
    for _, inst in ipairs(profB.VaultItems) do
        if not setB[inst.Uid] then
            table.insert(nextVaultB, inst)
        end
    end
    for _, inst in ipairs(movingFromA) do
        inst.PedestalSlot = nil
        profB.DiscoveredItems[inst.ItemId] = (profB.DiscoveredItems[inst.ItemId] or 0) + 1
        table.insert(nextVaultB, inst)
    end

    profA.VaultItems = nextVaultA
    profB.VaultItems = nextVaultB
    profA.Cash = profA.Cash - trade.SideA.Cash + trade.SideB.Cash
    profB.Cash = profB.Cash - trade.SideB.Cash + trade.SideA.Cash

    DataService.MarkDirty(pA)
    DataService.MarkDirty(pB)

    local sA = BaseService.GetPlayerSlot(pA)
    if sA then
        BaseService.RefreshBaseVisuals(sA)
    end
    local sB = BaseService.GetPlayerSlot(pB)
    if sB then
        BaseService.RefreshBaseVisuals(sB)
    end

    BaseService.SyncProfileToClient(pA)
    BaseService.SyncProfileToClient(pB)
    return true, "Trade completed!"
end

function TradeService.ConfirmTrade(player: Player): (boolean, string)
    local tid = TradeService._playerTrade[player.UserId]
    local trade = if tid then TradeService._trades[tid] else nil
    if not trade then
        return false, "No active trade"
    end
    local mine, other = getSides(trade, player.UserId)
    if not mine or not other then
        return false, "Invalid participant"
    end
    mine.Confirmed = true
    syncTrade(trade)

    if mine.Confirmed and other.Confirmed then
        local ok, msg = executeAtomicTrade(trade)
        TradeService.CancelTrade(player)
        return ok, msg
    end
    return true, "Waiting for partner confirmation"
end

function TradeService.Start()
    Remotes.GetEvent("RequestSendTrade").OnServerEvent:Connect(function(player, targetUserId)
        if type(targetUserId) ~= "number" then
            return
        end
        if not TradeService._rateLimiter:Check(player.UserId, "SendTrade", 1.0) then
            return
        end
        TradeService.SendTradeRequest(player, math.floor(targetUserId))
    end)

    Remotes.GetEvent("RequestRespondTrade").OnServerEvent:Connect(function(player, fromUserId, accept)
        if type(fromUserId) ~= "number" or type(accept) ~= "boolean" then
            return
        end
        TradeService.RespondTradeRequest(player, math.floor(fromUserId), accept)
    end)

    Remotes.GetEvent("RequestUpdateTradeOffer").OnServerEvent:Connect(function(player, uids, offerCash)
        if type(uids) ~= "table" or type(offerCash) ~= "number" then
            return
        end
        if not TradeService._rateLimiter:Check(player.UserId, "UpdateTrade", 0.25) then
            return
        end
        TradeService.UpdateOffer(player, uids, offerCash)
    end)

    Remotes.GetEvent("RequestConfirmTrade").OnServerEvent:Connect(function(player)
        if not TradeService._rateLimiter:Check(player.UserId, "ConfirmTrade", 0.4) then
            return
        end
        TradeService.ConfirmTrade(player)
    end)

    Remotes.GetEvent("RequestCancelTrade").OnServerEvent:Connect(function(player)
        TradeService.CancelTrade(player)
    end)

    Players.PlayerRemoving:Connect(function(player)
        TradeService.CancelTrade(player)
        TradeService._pendingRequests[player.UserId] = nil
        TradeService._rateLimiter:ClearPlayer(player.UserId)
    end)
end

return TradeService
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000022">
  <Properties>
    <string name="Name">WorldBuilder</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Procedural 3D World Architecture for STEAL THE IMPOSSIBLE
-- Constructs:
--   * Central Plaza ("The Nexus Hub") with SpawnLocations, Leaderboard Monoliths & Rift Portal Arch
--   * 8 Symmetric Personal Bases (Base_1 .. Base_8) with Deposit Pads & Security Gates
--   * 5 Distinct Biomes with glowing Sky Bridges & Parkour Islands
--   * 15-Minute Special Rift Sky Arena
--   * Co-op Big Heist Vault with Synchronized Squad Locks

local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local GameConfig = require(Shared.GameConfig)
local BiomeConfig = require(Shared.BiomeConfig)
local BaseConfig = require(Shared.BaseConfig)

local WorldBuilder = {}

WorldBuilder.BiomeCenters = {} :: { [string]: Vector3 }
WorldBuilder.BaseFolders = {} :: { [number]: Folder }
WorldBuilder.LeaderboardBoards = {} :: { [string]: SurfaceGui }
WorldBuilder.RiftPortalRing = nil :: Part?
WorldBuilder.RiftArenaFolder = nil :: Folder?
WorldBuilder.HeistLockPlates = {} :: { Part }
WorldBuilder.HeistVaultDoor = nil :: Part?

local function createPart(props: {
    Name: string,
    Size: Vector3,
    CFrame: CFrame,
    Color: Color3,
    Material: Enum.Material?,
    Shape: Enum.PartType?,
    Transparency: number?,
    CanCollide: boolean?,
    Parent: Instance,
}): Part
    local p = Instance.new("Part")
    p.Name = props.Name
    p.Size = props.Size
    p.CFrame = props.CFrame
    p.Color = props.Color
    p.Material = props.Material or Enum.Material.SmoothPlastic
    p.Shape = props.Shape or Enum.PartType.Block
    p.Transparency = props.Transparency or 0
    p.Anchored = true
    p.CanCollide = if props.CanCollide == nil then true else props.CanCollide
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = props.Parent
    return p
end

local function createSurfaceSign(part: Part, title: string, accentColor: Color3, face: Enum.NormalId?)
    local gui = Instance.new("SurfaceGui")
    gui.Name = "WorldSign"
    gui.Face = face or Enum.NormalId.Front
    gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    gui.PixelsPerStud = 22
    gui.Parent = part

    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromScale(1, 1)
    frame.BackgroundColor3 = Color3.fromRGB(14, 18, 28)
    frame.BorderSizePixel = 0
    frame.Parent = gui

    local stroke = Instance.new("UIStroke")
    stroke.Color = accentColor
    stroke.Thickness = 4
    stroke.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(0.92, 0.85)
    label.Position = UDim2.fromScale(0.04, 0.075)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBlack
    label.TextColor3 = Color3.fromRGB(248, 250, 255)
    label.TextScaled = true
    label.Text = title
    label.Parent = frame
end

local function createBridge(fromPos: Vector3, toPos: Vector3, width: number, color: Color3, accent: Color3, parent: Instance)
    local delta = toPos - fromPos
    local dist = delta.Magnitude
    local mid = fromPos + delta * 0.5
    local cf = CFrame.lookAt(mid, toPos)

    createPart({
        Name = "EnergyBridge",
        Size = Vector3.new(width, 2.5, dist),
        CFrame = cf * CFrame.new(0, -1.2, 0),
        Color = color,
        Material = Enum.Material.Metal,
        Parent = parent,
    })

    for _, side in ipairs({ -1, 1 }) do
        createPart({
            Name = "BridgeRail",
            Size = Vector3.new(0.8, 0.6, dist),
            CFrame = cf * CFrame.new(side * (width * 0.48), 0.3, 0),
            Color = accent,
            Material = Enum.Material.Neon,
            CanCollide = false,
            Parent = parent,
        })
    end
end

local function buildCentralPlaza(worldRoot: Folder)
    local plaza = Instance.new("Folder")
    plaza.Name = "CentralPlaza"
    plaza.Parent = worldRoot

    -- Outer safety ocean / void floor well beneath bridges
    createPart({
        Name = "VoidSeaFloor",
        Size = Vector3.new(1200, 4, 1200),
        CFrame = CFrame.new(0, -32, 0),
        Color = Color3.fromRGB(10, 14, 26),
        Material = Enum.Material.SmoothPlastic,
        Parent = plaza,
    })

    -- Main Circular Plaza Floor
    createPart({
        Name = "PlazaFloor",
        Size = Vector3.new(4, GameConfig.PLAZA_RADIUS * 2, GameConfig.PLAZA_RADIUS * 2),
        CFrame = CFrame.new(0, 2, 0) * CFrame.Angles(0, 0, math.rad(90)),
        Shape = Enum.PartType.Cylinder,
        Color = Color3.fromRGB(26, 31, 48),
        Material = Enum.Material.Marble,
        Parent = plaza,
    })

    createPart({
        Name = "PlazaNeonRing",
        Size = Vector3.new(0.6, GameConfig.PLAZA_RADIUS * 1.92, GameConfig.PLAZA_RADIUS * 1.92),
        CFrame = CFrame.new(0, 4.1, 0) * CFrame.Angles(0, 0, math.rad(90)),
        Shape = Enum.PartType.Cylinder,
        Color = Color3.fromRGB(0, 235, 255),
        Material = Enum.Material.Neon,
        Transparency = 0.35,
        CanCollide = false,
        Parent = plaza,
    })

    -- Inner Plaza Spawn Ring (8 SpawnLocations)
    for i = 1, 8 do
        local ang = ((i - 1) / 8) * math.pi * 2
        local spawnPos = Vector3.new(math.cos(ang) * 24, 4.5, math.sin(ang) * 24)
        local sp = Instance.new("SpawnLocation")
        sp.Name = "HubSpawn_" .. tostring(i)
        sp.Size = Vector3.new(6, 1, 6)
        sp.CFrame = CFrame.lookAt(spawnPos, Vector3.new(0, 4.5, 0))
        sp.Anchored = true
        sp.Enabled = true
        sp.Neutral = true
        sp.Color = Color3.fromRGB(0, 215, 255)
        sp.Material = Enum.Material.Neon
        sp.Transparency = 0.25
        sp.Parent = plaza
    end

    -- 15-Minute Special Rift Portal Arch at Center (0, 12, 0)
    local portalFolder = Instance.new("Folder")
    portalFolder.Name = "SpecialRiftPortal"
    portalFolder.Parent = plaza

    -- Step ring around PortalPedestal so players walk straight in from PlazaFloor (Y=4 -> Y=6)
    createPart({
        Name = "PortalStep",
        Size = Vector3.new(26, 1.2, 26),
        CFrame = CFrame.new(0, 4.6, 0),
        Color = Color3.fromRGB(28, 34, 52),
        Material = Enum.Material.Metal,
        Parent = portalFolder,
    })

    createPart({
        Name = "PortalPedestal",
        Size = Vector3.new(20, 2, 20),
        CFrame = CFrame.new(0, 5, 0),
        Color = Color3.fromRGB(18, 22, 36),
        Material = Enum.Material.Obsidian,
        Parent = portalFolder,
    })

    -- 4 Diagonal Plaza Express Spokes (between Bases) straight to Outer Ring Highway
    for _, deg in ipairs({ 45, 135, 225, 315 }) do
        local rad = math.rad(deg)
        local dir = Vector3.new(math.cos(rad), 0, math.sin(rad))
        createBridge(
            dir * (GameConfig.PLAZA_RADIUS - 2) + Vector3.new(0, 4, 0),
            dir * 198 + Vector3.new(0, 5, 0),
            12,
            Color3.fromRGB(26, 32, 48),
            Color3.fromRGB(0, 235, 255),
            plaza
        )
    end

    for _, side in ipairs({ -1, 1 }) do
        createPart({
            Name = "PortalPillar",
            Size = Vector3.new(3, 22, 3),
            CFrame = CFrame.new(side * 9, 16, 0),
            Color = Color3.fromRGB(32, 38, 56),
            Material = Enum.Material.Metal,
            Parent = portalFolder,
        })
    end

    createPart({
        Name = "PortalCrown",
        Size = Vector3.new(22, 3, 4),
        CFrame = CFrame.new(0, 27, 0),
        Color = Color3.fromRGB(0, 255, 220),
        Material = Enum.Material.Neon,
        Parent = portalFolder,
    })

    local portalGate = createPart({
        Name = "PortalGateRing",
        Size = Vector3.new(15, 19, 1.5),
        CFrame = CFrame.new(0, 15.5, 0),
        Color = Color3.fromRGB(0, 255, 215),
        Material = Enum.Material.ForceField,
        Transparency = 0.85,
        CanCollide = false,
        Parent = portalFolder,
    })
    portalGate:SetAttribute("RiftPortalActive", false)
    WorldBuilder.RiftPortalRing = portalGate
    createSurfaceSign(portalGate, "15M SPECIAL RIFT\n[LOCKED]", Color3.fromRGB(0, 255, 220), Enum.NormalId.Front)

    -- 3D Plaza Global Leaderboard Monolith (Net Worth & Secret Hall of Fame)
    local boardData = {
        { Key = "NetWorth", Title = "🏆 GLOBAL RICHEST (NET WORTH)", Pos = Vector3.new(-38, 12, -38), Color = Color3.fromRGB(255, 205, 55) },
        { Key = "Secrets", Title = "✨ 0.01% SECRET COLLECTORS", Pos = Vector3.new(38, 12, -38), Color = Color3.fromRGB(0, 255, 245) },
    }
    for _, b in ipairs(boardData) do
        local monolith = createPart({
            Name = "LeaderboardMonolith_" .. b.Key,
            Size = Vector3.new(22, 14, 2.5),
            CFrame = CFrame.lookAt(b.Pos, Vector3.new(0, 12, 0)),
            Color = Color3.fromRGB(16, 20, 32),
            Material = Enum.Material.Metal,
            Parent = plaza,
        })

        local gui = Instance.new("SurfaceGui")
        gui.Name = "BoardGui"
        gui.Face = Enum.NormalId.Front
        gui.CanvasSize = Vector2.new(640, 400)
        gui.Parent = monolith

        local bg = Instance.new("Frame")
        bg.Size = UDim2.fromScale(1, 1)
        bg.BackgroundColor3 = Color3.fromRGB(12, 16, 28)
        bg.BorderSizePixel = 0
        bg.Parent = gui

        local stroke = Instance.new("UIStroke")
        stroke.Color = b.Color
        stroke.Thickness = 5
        stroke.Parent = bg

        local header = Instance.new("TextLabel")
        header.Name = "Header"
        header.Size = UDim2.new(1, -20, 0.18, 0)
        header.Position = UDim2.fromOffset(10, 8)
        header.BackgroundTransparency = 1
        header.Font = Enum.Font.GothamBlack
        header.TextColor3 = b.Color
        header.TextScaled = true
        header.Text = b.Title
        header.Parent = bg

        local body = Instance.new("TextLabel")
        body.Name = "Rows"
        body.Size = UDim2.new(1, -30, 0.78, 0)
        body.Position = UDim2.new(0, 15, 0.2, 0)
        body.BackgroundTransparency = 1
        body.Font = Enum.Font.GothamBold
        body.TextColor3 = Color3.fromRGB(235, 240, 255)
        body.TextSize = 24
        body.TextXAlignment = Enum.TextXAlignment.Left
        body.TextYAlignment = Enum.TextYAlignment.Top
        body.Text = "Loading global rankings..."
        body.Parent = bg

        WorldBuilder.LeaderboardBoards[b.Key] = gui
    end

    -- Interactive Plaza Kiosks (Merchant, Promo Codes & Rebirth Shrine)
    local kiosks = {
        { Name = "MerchantKiosk", Title = "🍀 BLACK-MARKET\nMERCHANT", Pos = Vector3.new(-36, 8, 34), Color = Color3.fromRGB(48, 225, 138), Modal = "Quests" },
        { Name = "CodeTerminal", Title = "🎟️ PROMO CODES\n& DAILY QUESTS", Pos = Vector3.new(36, 8, 34), Color = Color3.fromRGB(0, 235, 255), Modal = "Quests" },
        { Name = "RebirthShrine", Title = "♻️ ASCENSION\nREBIRTH SHRINE", Pos = Vector3.new(0, 8, 48), Color = Color3.fromRGB(255, 205, 55), Modal = "Quests" },
    }
    for _, k in ipairs(kiosks) do
        local stall = createPart({
            Name = k.Name,
            Size = Vector3.new(10, 8, 6),
            CFrame = CFrame.lookAt(k.Pos, Vector3.new(0, 8, 0)),
            Color = Color3.fromRGB(22, 26, 42),
            Material = Enum.Material.Metal,
            Parent = plaza,
        })
        stall:SetAttribute("KioskPanel", k.Modal)
        CollectionService:AddTag(stall, "PlazaKiosk")
        createSurfaceSign(stall, k.Title, k.Color, Enum.NormalId.Front)

        local kPrompt = Instance.new("ProximityPrompt")
        kPrompt.Name = "KioskPrompt"
        kPrompt.ActionText = "Open"
        kPrompt.ObjectText = k.Name
        kPrompt.HoldDuration = 0
        kPrompt.MaxActivationDistance = 14
        kPrompt.Parent = stall
    end
end

local function buildEightBases(worldRoot: Folder)
    local basesRoot = Instance.new("Folder")
    basesRoot.Name = "PlayerBases"
    basesRoot.Parent = worldRoot

    for slotIndex = 1, GameConfig.MAX_PLAYERS do
        local baseCF = BaseConfig.GetSlotCFrame(slotIndex)
        local basePos = baseCF.Position
        createBridge(
            basePos.Unit * (GameConfig.PLAZA_RADIUS - 2) + Vector3.new(0, 4, 0),
            basePos + baseCF.LookVector * 26,
            12,
            Color3.fromRGB(32, 38, 54),
            Color3.fromRGB(95, 185, 255),
            basesRoot
        )

        -- Outer Ring Highway Bridge segment connecting around the 8 Bases at radius 196
        local a1 = ((slotIndex - 1) / GameConfig.MAX_PLAYERS) * math.pi * 2
        local a2 = (slotIndex / GameConfig.MAX_PLAYERS) * math.pi * 2
        local p1 = Vector3.new(math.cos(a1) * 196, 5, math.sin(a1) * 196)
        local p2 = Vector3.new(math.cos(a2) * 196, 5, math.sin(a2) * 196)
        createBridge(p1, p2, 16, Color3.fromRGB(28, 34, 52), Color3.fromRGB(0, 225, 255), basesRoot)

        -- Connect Base rear flank to Outer Ring Highway for smooth escape routes
        createBridge(
            basePos - baseCF.LookVector * 26,
            basePos.Unit * 196 + Vector3.new(0, 1, 0),
            12,
            Color3.fromRGB(32, 38, 54),
            Color3.fromRGB(95, 185, 255),
            basesRoot
        )

        local folder = Instance.new("Folder")
        folder.Name = "Base_" .. tostring(slotIndex)
        folder:SetAttribute("BaseSlot", slotIndex)
        folder.Parent = basesRoot

        -- Base Floor Platform
        createPart({
            Name = "BaseFloor",
            Size = Vector3.new(54, 2, 54),
            CFrame = baseCF,
            Color = Color3.fromRGB(24, 28, 42),
            Material = Enum.Material.SmoothPlastic,
            Parent = folder,
        })

        -- Glowing Extraction / Deposit Pad near entrance
        local depositPad = createPart({
            Name = "DepositPad",
            Size = Vector3.new(14, 0.8, 12),
            CFrame = baseCF * CFrame.new(0, 1.3, -17),
            Color = Color3.fromRGB(45, 255, 145),
            Material = Enum.Material.Neon,
            CanCollide = false,
            Parent = folder,
        })
        depositPad:SetAttribute("BaseSlot", slotIndex)
        CollectionService:AddTag(depositPad, "BaseDepositPad")

        -- Security Laser Shield Gate across entrance
        local gate = createPart({
            Name = "SecurityGate",
            Size = Vector3.new(26, 12, 1.5),
            CFrame = baseCF * CFrame.new(0, 7, -26.5),
            Color = Color3.fromRGB(65, 195, 255),
            Material = Enum.Material.ForceField,
            Transparency = 0.65,
            CanCollide = false,
            Parent = folder,
        })
        gate:SetAttribute("BaseSlot", slotIndex)
        CollectionService:AddTag(gate, "BaseSecurityGate")

        -- Side perimeter walls
        for _, side in ipairs({ -1, 1 }) do
            createPart({
                Name = "SideWall_" .. tostring(side),
                Size = Vector3.new(2, 10, 54),
                CFrame = baseCF * CFrame.new(side * 26, 6, 0),
                Color = Color3.fromRGB(34, 40, 58),
                Material = Enum.Material.Metal,
                Parent = folder,
            })
        end

        createPart({
            Name = "BackWall",
            Size = Vector3.new(54, 12, 2),
            CFrame = baseCF * CFrame.new(0, 7, 26),
            Color = Color3.fromRGB(34, 40, 58),
            Material = Enum.Material.Metal,
            Parent = folder,
        })

        local signPart = createPart({
            Name = "OwnerSign",
            Size = Vector3.new(22, 6, 1.5),
            CFrame = baseCF * CFrame.new(0, 15, -26),
            Color = Color3.fromRGB(16, 20, 34),
            Material = Enum.Material.Metal,
            Parent = folder,
        })
        createSurfaceSign(signPart, "BASE #" .. tostring(slotIndex) .. "\nUNCLAIMED", Color3.fromRGB(95, 185, 255), Enum.NormalId.Front)

        -- Pre-place 24 Flex Showcase Pedestal anchors (activated progressively by BaseTier 1..5)
        local pedestalsFolder = Instance.new("Folder")
        pedestalsFolder.Name = "Pedestals"
        pedestalsFolder.Parent = folder

        for pIdx = 1, 24 do
            local row = math.floor((pIdx - 1) / 4)
            local col = (pIdx - 1) % 4
            local offsetX = (col - 1.5) * 10.5
            local offsetZ = -6 + row * 5.8
            local pedestal = createPart({
                Name = "Pedestal_" .. tostring(pIdx),
                Size = Vector3.new(4.2, 2.2, 4.2),
                CFrame = baseCF * CFrame.new(offsetX, 2.1, offsetZ),
                Color = Color3.fromRGB(38, 44, 66),
                Material = Enum.Material.Marble,
                Transparency = if pIdx <= 4 then 0 else 1,
                CanCollide = if pIdx <= 4 then true else false,
                Parent = pedestalsFolder,
            })
            pedestal:SetAttribute("PedestalIndex", pIdx)
            pedestal:SetAttribute("BaseSlot", slotIndex)
            CollectionService:AddTag(pedestal, "FlexPedestal")
        end

        -- Raidable Cash Safe inside Base corner (protects via Base Shield; High-Stakes doubles passive rate!)
        local raidSafe = createPart({
            Name = "RaidSafe",
            Size = Vector3.new(6, 6, 6),
            CFrame = baseCF * CFrame.new(-19, 4, -17),
            Color = Color3.fromRGB(255, 200, 55),
            Material = Enum.Material.Metal,
            Parent = folder,
        })
        raidSafe:SetAttribute("BaseSlot", slotIndex)
        CollectionService:AddTag(raidSafe, "BaseRaidSafe")
        createSurfaceSign(raidSafe, "VAULT SAFE\n$0", Color3.fromRGB(255, 205, 55), Enum.NormalId.Front)

        local safePrompt = Instance.new("ProximityPrompt")
        safePrompt.Name = "SafePrompt"
        safePrompt.ActionText = "Collect / Raid Safe"
        safePrompt.ObjectText = "Base #" .. tostring(slotIndex) .. " Safe"
        safePrompt.HoldDuration = 0.4
        safePrompt.MaxActivationDistance = 12
        safePrompt.Parent = raidSafe

        WorldBuilder.BaseFolders[slotIndex] = folder
    end
end

local function buildBiomesAndVault(worldRoot: Folder)
    local biomesFolder = Instance.new("Folder")
    biomesFolder.Name = "WorldBiomes"
    biomesFolder.Parent = worldRoot

    for _, biome in ipairs(BiomeConfig.Biomes) do
        local center = BiomeConfig.GetBiomePosition(biome)
        WorldBuilder.BiomeCenters[biome.Id] = center

        local bFolder = Instance.new("Folder")
        bFolder.Name = biome.Id
        bFolder.Parent = biomesFolder

        -- Main Biome Platform
        createPart({
            Name = "BiomePlatform",
            Size = biome.PlatformSize,
            CFrame = CFrame.new(center),
            Color = biome.PrimaryColor,
            Material = biome.FloorMaterial,
            Parent = bFolder,
        })

        -- Glowing Biome Trim & Corner Pillars
        for _, sx in ipairs({ -1, 1 }) do
            for _, sz in ipairs({ -1, 1 }) do
                createPart({
                    Name = "BiomeObelisk",
                    Size = Vector3.new(6, 36, 6),
                    CFrame = CFrame.new(center + Vector3.new(sx * 52, 18, sz * 52)),
                    Color = biome.AccentColor,
                    Material = Enum.Material.Neon,
                    Transparency = 0.2,
                    Parent = bFolder,
                })
            end
        end

        -- Center Biome Landmark Altar
        local altar = createPart({
            Name = "BiomeAltar",
            Size = Vector3.new(18, 4, 18),
            CFrame = CFrame.new(center + Vector3.new(0, 6, 0)),
            Color = biome.AccentColor,
            Material = Enum.Material.Neon,
            Transparency = 0.35,
            Parent = bFolder,
        })
        createSurfaceSign(altar, biome.Name:upper(), biome.AccentColor, Enum.NormalId.Top)

        -- Biome-Specific 3D Landmarks & Jump Pads
        local jumpPad = createPart({
            Name = "BiomeJumpPad",
            Size = Vector3.new(8, 1, 8),
            CFrame = CFrame.new(center + Vector3.new(0, 4.6, 36)),
            Color = Color3.fromRGB(0, 255, 215),
            Material = Enum.Material.Neon,
            CanCollide = false,
            Parent = bFolder,
        })
        jumpPad:SetAttribute("LaunchPower", 95)
        CollectionService:AddTag(jumpPad, "JumpPad")

        if biome.Id == "FrostCitadel" then
            for i = 1, 4 do
                local ang = i * (math.pi / 2)
                createPart({
                    Name = "IceSpire_" .. tostring(i),
                    Size = Vector3.new(7, 34, 7),
                    CFrame = CFrame.new(center + Vector3.new(math.cos(ang) * 32, 18, math.sin(ang) * 32))
                        * CFrame.Angles(math.rad(14), ang, math.rad(10)),
                    Color = Color3.fromRGB(165, 238, 255),
                    Material = Enum.Material.Ice,
                    Transparency = 0.2,
                    Parent = bFolder,
                })
            end
        elseif biome.Id == "AbyssalCaldera" then
            createPart({
                Name = "MagmaCraterPool",
                Size = Vector3.new(1.5, 42, 42),
                CFrame = CFrame.new(center + Vector3.new(0, 4.2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
                Shape = Enum.PartType.Cylinder,
                Color = Color3.fromRGB(255, 85, 25),
                Material = Enum.Material.Neon,
                CanCollide = false,
                Parent = bFolder,
            })
        elseif biome.Id == "ChronosRuins" then
            createPart({
                Name = "ChronosGiantRing",
                Size = Vector3.new(3, 46, 46),
                CFrame = CFrame.new(center + Vector3.new(0, 28, 0)) * CFrame.Angles(math.rad(20), 0, 0),
                Shape = Enum.PartType.Cylinder,
                Color = Color3.fromRGB(255, 210, 90),
                Material = Enum.Material.Metal,
                Transparency = 0.35,
                CanCollide = false,
                Parent = bFolder,
            })
        elseif biome.Id == "WatchersSanctum" then
            local statueBase = createPart({
                Name = "WatcherTower",
                Size = Vector3.new(12, 34, 12),
                CFrame = CFrame.new(center + Vector3.new(0, 20, -34)),
                Color = Color3.fromRGB(32, 20, 56),
                Material = Enum.Material.Slate,
                Parent = bFolder,
            })
            local giantIris = createPart({
                Name = "GiantWatcherEye",
                Size = Vector3.new(9, 9, 9),
                Shape = Enum.PartType.Ball,
                CFrame = statueBase.CFrame * CFrame.new(0, 20, 0),
                Color = Color3.fromRGB(215, 75, 255),
                Material = Enum.Material.Neon,
                Parent = bFolder,
            })
            CollectionService:AddTag(giantIris, "TrackingEyeIris")
        elseif biome.Id == "AstralVoid" then
            createPart({
                Name = "AstralUpperIsland",
                Size = Vector3.new(34, 3, 34),
                CFrame = CFrame.new(center + Vector3.new(0, 28, 0)),
                Color = Color3.fromRGB(48, 38, 105),
                Material = Enum.Material.Neon,
                Transparency = 0.25,
                Parent = bFolder,
            })
        end

        -- Connect Outer Ring Highway outward to Biome
        local flatDir = Vector3.new(center.X, 0, center.Z).Unit
        createBridge(
            flatDir * 194 + Vector3.new(0, 5, 0),
            center - flatDir * 58 + Vector3.new(0, 4, 0),
            16,
            biome.PrimaryColor,
            biome.AccentColor,
            bFolder
        )
    end

    -- 15-Minute Special Rift Sky Arena
    local riftFolder = Instance.new("Folder")
    riftFolder.Name = "SpecialRiftArena"
    riftFolder.Parent = worldRoot

    local riftPos = GameConfig.RIFT_ARENA_POSITION
    createPart({
        Name = "RiftPlatform",
        Size = Vector3.new(110, 4, 110),
        CFrame = CFrame.new(riftPos),
        Color = Color3.fromRGB(20, 28, 38),
        Material = Enum.Material.Glass,
        Transparency = 0.15,
        Parent = riftFolder,
    })

    local exitPad = createPart({
        Name = "RiftReturnPad",
        Size = Vector3.new(14, 1, 14),
        CFrame = CFrame.new(riftPos + Vector3.new(0, 2.5, 42)),
        Color = Color3.fromRGB(0, 255, 215),
        Material = Enum.Material.Neon,
        CanCollide = false,
        Parent = riftFolder,
    })
    CollectionService:AddTag(exitPad, "RiftReturnPad")
    WorldBuilder.RiftArenaFolder = riftFolder

    -- Co-op Big Heist Facility ("THE IMPOSSIBLE VAULT")
    local vaultFolder = Instance.new("Folder")
    vaultFolder.Name = "BigHeistVault"
    vaultFolder.Parent = worldRoot

    local vPos = GameConfig.VAULT_POSITION
    createBridge(
        Vector3.new(0, 5, -194),
        vPos + Vector3.new(0, 3, 52),
        18,
        Color3.fromRGB(36, 36, 48),
        Color3.fromRGB(255, 200, 55),
        vaultFolder
    )

    createPart({
        Name = "VaultFloor",
        Size = Vector3.new(105, 6, 105),
        CFrame = CFrame.new(vPos),
        Color = Color3.fromRGB(24, 24, 34),
        Material = Enum.Material.Metal,
        Parent = vaultFolder,
    })

    local vaultDoor = createPart({
        Name = "VaultSecurityDoor",
        Size = Vector3.new(26, 18, 3),
        CFrame = CFrame.new(vPos + Vector3.new(0, 12, 8)),
        Color = Color3.fromRGB(255, 185, 45),
        Material = Enum.Material.DiamondPlate,
        Parent = vaultFolder,
    })
    WorldBuilder.HeistVaultDoor = vaultDoor
    createSurfaceSign(vaultDoor, "CO-OP BIG HEIST VAULT\nSTEP ON ALL PLATES TOGETHER!", Color3.fromRGB(255, 205, 55), Enum.NormalId.Front)

    -- Interior Treasure Room Stacks behind Vault Door
    for bx = -14, 14, 14 do
        createPart({
            Name = "GoldBullionStack_" .. tostring(bx),
            Size = Vector3.new(8, 5, 10),
            CFrame = CFrame.new(vPos + Vector3.new(bx, 5.5, -24)),
            Color = Color3.fromRGB(255, 215, 55),
            Material = Enum.Material.Metal,
            Parent = vaultFolder,
        })
    end

    -- 2 Synchronized Co-op Heist Security Plates outside the vault door
    WorldBuilder.HeistLockPlates = {}
    for idx, xOff in ipairs({ -18, 18 }) do
        local plate = createPart({
            Name = "HeistLockPlate_" .. tostring(idx),
            Size = Vector3.new(10, 1, 10),
            CFrame = CFrame.new(vPos + Vector3.new(xOff, 3.5, 24)),
            Color = Color3.fromRGB(255, 65, 75),
            Material = Enum.Material.Neon,
            CanCollide = false,
            Parent = vaultFolder,
        })
        plate:SetAttribute("PlateIndex", idx)
        CollectionService:AddTag(plate, "HeistLockPlate")
        table.insert(WorldBuilder.HeistLockPlates, plate)
    end
end

function WorldBuilder.BuildIfMissing()
    local existing = Workspace:FindFirstChild("GameWorld")
    if existing and existing:IsA("Folder") then
        -- Hydrate centers for pre-built worlds
        for _, biome in ipairs(BiomeConfig.Biomes) do
            WorldBuilder.BiomeCenters[biome.Id] = BiomeConfig.GetBiomePosition(biome)
        end
        return
    end

    local worldRoot = Instance.new("Folder")
    worldRoot.Name = "GameWorld"
    worldRoot.Parent = Workspace

    -- Container folders for dynamic runtime spawns
    local worldItems = Instance.new("Folder")
    worldItems.Name = "WorldItems"
    worldItems.Parent = worldRoot

    local worldEvents = Instance.new("Folder")
    worldEvents.Name = "WorldEventFX"
    worldEvents.Parent = worldRoot

    buildCentralPlaza(worldRoot)
    buildEightBases(worldRoot)
    buildBiomesAndVault(worldRoot)
end

return WorldBuilder
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000023">
  <Properties>
    <string name="Name">WorldEventService</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Global Growth Feature #1: "THE WORLD IS ENDING"
-- Every 30 minutes (1800s), triggers a dramatic 90s world-changing apocalypse:
--   1. MeteorShower  -> Blazing meteors crash across the map + drop Apocalypse Star Shards
--   2. GiantMonster  -> 60-stud Titan of the End roams the arena with shockwave stomps
--   3. GravityLoss   -> Workspace.Gravity drops to 42 (Moon-Jump chaos + floating orbs!)

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Types = require(Shared.Types)
local GameConfig = require(Shared.GameConfig)
local ItemCatalog = require(Shared.ItemCatalog)
local Remotes = require(Shared.Remotes)

local ItemSpawnService = require(script.Parent.ItemSpawnService)

local WorldEventService = {}
WorldEventService.IsActive = false
WorldEventService.CurrentEvent = nil :: Types.WorldEventType?
WorldEventService.ActiveUntil = 0
WorldEventService.NextEventAt = 0
WorldEventService._eventIndex = 0
WorldEventService._activeProps = {} :: { Instance }

local EVENT_ROTATION: { Types.WorldEventType } = {
    "MeteorShower",
    "GiantMonster",
    "GravityLoss",
}

local function clearEventProps()
    for _, inst in ipairs(WorldEventService._activeProps) do
        if inst and inst.Parent then
            inst:Destroy()
        end
    end
    WorldEventService._activeProps = {}
end

local function getFXFolder(): Instance
    local gw = Workspace:FindFirstChild("GameWorld")
    local fx = if gw then gw:FindFirstChild("WorldEventFX") else nil
    return fx or Workspace
end

local function runMeteorShower(duration: number)
    local fxRoot = getFXFolder()
    local meteorStarItem = ItemCatalog.Get("world_ending_meteor_core")
    task.spawn(function()
        local stopAt = os.clock() + duration
        local dropCount = 0
        while WorldEventService.IsActive and WorldEventService.CurrentEvent == "MeteorShower" and os.clock() < stopAt do
            local ang = math.random() * math.pi * 2
            local dist = math.random(35, 310)
            local targetPos = Vector3.new(math.cos(ang) * dist, 5, math.sin(ang) * dist)

            -- Warning circle on ground
            local warnRing = Instance.new("Part")
            warnRing.Name = "MeteorTargetRing"
            warnRing.Size = Vector3.new(0.5, 20, 20)
            warnRing.Shape = Enum.PartType.Cylinder
            warnRing.Color = Color3.fromRGB(255, 55, 45)
            warnRing.Material = Enum.Material.Neon
            warnRing.Transparency = 0.45
            warnRing.Anchored = true
            warnRing.CanCollide = false
            warnRing.CFrame = CFrame.new(targetPos) * CFrame.Angles(0, 0, math.rad(90))
            warnRing.Parent = fxRoot
            table.insert(WorldEventService._activeProps, warnRing)

            -- Plunging Meteor Sphere
            local meteor = Instance.new("Part")
            meteor.Name = "FallingMeteor"
            meteor.Size = Vector3.new(10, 10, 10)
            meteor.Shape = Enum.PartType.Ball
            meteor.Color = Color3.fromRGB(255, 115, 35)
            meteor.Material = Enum.Material.Neon
            meteor.Anchored = true
            meteor.CanCollide = false
            meteor.CFrame = CFrame.new(targetPos + Vector3.new(35, 160, -25))
            meteor.Parent = fxRoot
            table.insert(WorldEventService._activeProps, meteor)

            local tween = TweenService:Create(
                meteor,
                TweenInfo.new(1.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                { CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0)) }
            )
            tween:Play()

            task.delay(1.15, function()
                if warnRing.Parent then
                    warnRing:Destroy()
                end
                if meteor.Parent then
                    meteor:Destroy()
                end
                -- Knockback players very close to meteor impact
                for _, player in ipairs(Players:GetPlayers()) do
                    local char = player.Character
                    local hrp = if char then char:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
                    if hrp and (hrp.Position - targetPos).Magnitude < 16 then
                        hrp.AssemblyLinearVelocity = (hrp.Position - targetPos).Unit * 45 + Vector3.new(0, 40, 0)
                    end
                end
                -- Every 4th meteor drops an Impossible Apocalypse Star Shard!
                dropCount += 1
                if meteorStarItem and (dropCount % 4 == 0) and WorldEventService.IsActive then
                    ItemSpawnService.SpawnSpecificItemAt(meteorStarItem, targetPos + Vector3.new(0, 5, 0), "WorldEvent", true)
                end
            end)

            task.wait(2.2)
        end
    end)
end

local function runGiantMonster(duration: number)
    local fxRoot = getFXFolder()
    local titan = Instance.new("Model")
    titan.Name = "TitanOfTheEnd"

    local torso = Instance.new("Part")
    torso.Name = "TitanCore"
    torso.Size = Vector3.new(26, 44, 18)
    torso.Color = Color3.fromRGB(25, 18, 34)
    torso.Material = Enum.Material.Basalt
    torso.Anchored = true
    torso.CanCollide = true
    torso.CFrame = CFrame.new(0, 26, -120)
    torso.Parent = titan
    titan.PrimaryPart = torso

    local eye = Instance.new("Part")
    eye.Name = "TitanLaserEye"
    eye.Size = Vector3.new(12, 6, 4)
    eye.Color = Color3.fromRGB(255, 45, 75)
    eye.Material = Enum.Material.Neon
    eye.Anchored = true
    eye.CanCollide = false
    eye.CFrame = torso.CFrame * CFrame.new(0, 14, 9.5)
    eye.Parent = titan

    local light = Instance.new("PointLight")
    light.Color = Color3.fromRGB(255, 45, 75)
    light.Range = 60
    light.Brightness = 3
    light.Parent = eye

    titan.Parent = fxRoot
    table.insert(WorldEventService._activeProps, titan)

    local titanLoot = ItemCatalog.Get("world_ending_meteor_core")
    task.spawn(function()
        local stopAt = os.clock() + duration
        local angle = 0
        while WorldEventService.IsActive and WorldEventService.CurrentEvent == "GiantMonster" and os.clock() < stopAt do
            angle += 0.35
            local pos = Vector3.new(math.cos(angle) * 115, 26, math.sin(angle) * 115)
            local lookAt = Vector3.new(math.cos(angle + 0.5) * 115, 26, math.sin(angle + 0.5) * 115)
            local nextCF = CFrame.lookAt(pos, lookAt)
            torso.CFrame = nextCF
            eye.CFrame = nextCF * CFrame.new(0, 14, -9.5)

            -- Drop Apocalypse Relic behind the Titan's footsteps periodically
            if titanLoot and math.random() < 0.25 then
                ItemSpawnService.SpawnSpecificItemAt(
                    titanLoot,
                    Vector3.new(pos.X, 7.5, pos.Z),
                    "WorldEvent",
                    true
                )
            end
            task.wait(1.8)
        end
    end)
end

local function runGravityLoss(duration: number)
    Workspace.Gravity = GameConfig.ZERO_G_GRAVITY
    local fxRoot = getFXFolder()

    -- Spawn floating cosmic zero-G rings across the sky
    for i = 1, 14 do
        local ang = (i / 14) * math.pi * 2
        local r = math.random(45, 260)
        local orb = Instance.new("Part")
        orb.Name = "ZeroGOrb_" .. tostring(i)
        orb.Size = Vector3.new(8, 8, 8)
        orb.Shape = Enum.PartType.Ball
        orb.Color = Color3.fromRGB(0, 235, 255)
        orb.Material = Enum.Material.ForceField
        orb.Anchored = true
        orb.CanCollide = false
        orb.CFrame = CFrame.new(math.cos(ang) * r, math.random(22, 65), math.sin(ang) * r)
        orb.Parent = fxRoot
        table.insert(WorldEventService._activeProps, orb)
    end

    task.delay(duration, function()
        if not WorldEventService.IsActive or WorldEventService.CurrentEvent ~= "GravityLoss" then
            Workspace.Gravity = GameConfig.NORMAL_GRAVITY
        end
    end)
end

function WorldEventService.TriggerWorldEnding(eventType: Types.WorldEventType?, durationOverride: number?)
    if WorldEventService.IsActive then
        WorldEventService.EndWorldEnding()
    end

    local chosen: Types.WorldEventType
    if eventType then
        chosen = eventType
    else
        WorldEventService._eventIndex = (WorldEventService._eventIndex % #EVENT_ROTATION) + 1
        chosen = EVENT_ROTATION[WorldEventService._eventIndex]
    end

    local dur = durationOverride or GameConfig.WORLD_ENDING_DURATION_SECONDS
    WorldEventService.IsActive = true
    WorldEventService.CurrentEvent = chosen
    WorldEventService.ActiveUntil = os.time() + dur

    -- Boost rare loot spawns during apocalypse!
    ItemSpawnService.SetWorldEventLuckBonus(2.25)

    -- Dramatic apocalyptic sky tint
    Lighting.FogColor = if chosen == "GravityLoss"
        then Color3.fromRGB(16, 22, 58)
        else Color3.fromRGB(58, 18, 22)
    Lighting.Ambient = if chosen == "GravityLoss"
        then Color3.fromRGB(45, 75, 130)
        else Color3.fromRGB(115, 42, 42)

    if chosen == "MeteorShower" then
        runMeteorShower(dur)
    elseif chosen == "GiantMonster" then
        runGiantMonster(dur)
    elseif chosen == "GravityLoss" then
        runGravityLoss(dur)
    end

    Remotes.GetEvent("WorldEndingFX"):FireAllClients({
        Active = true,
        EventType = chosen,
        Duration = dur,
    })

    Remotes.GetEvent("FeedAnnouncement"):FireAllClients({
        Type = "WorldEndingStarted",
        EventType = chosen,
    })
end

function WorldEventService.EndWorldEnding()
    if not WorldEventService.IsActive then
        return
    end
    WorldEventService.IsActive = false
    WorldEventService.CurrentEvent = nil
    WorldEventService.NextEventAt = os.time() + GameConfig.WORLD_ENDING_INTERVAL_SECONDS

    Workspace.Gravity = GameConfig.NORMAL_GRAVITY
    Lighting.FogColor = Color3.fromRGB(15, 20, 36)
    Lighting.Ambient = Color3.fromRGB(46, 51, 71)
    ItemSpawnService.SetWorldEventLuckBonus(1.0)
    clearEventProps()

    Remotes.GetEvent("WorldEndingFX"):FireAllClients({
        Active = false,
    })
end

function WorldEventService.Step(nowTime: number)
    if WorldEventService.IsActive then
        if nowTime >= WorldEventService.ActiveUntil then
            WorldEventService.EndWorldEnding()
        end
    else
        if nowTime >= WorldEventService.NextEventAt then
            WorldEventService.TriggerWorldEnding()
        end
    end
end

function WorldEventService.GetTimerState(nowTime: number?): { IsActive: boolean, EventType: Types.WorldEventType?, SecondsLeft: number }
    local now = nowTime or os.time()
    if WorldEventService.IsActive then
        return {
            IsActive = true,
            EventType = WorldEventService.CurrentEvent,
            SecondsLeft = math.max(0, WorldEventService.ActiveUntil - now),
        }
    end
    return {
        IsActive = false,
        EventType = nil,
        SecondsLeft = math.max(0, WorldEventService.NextEventAt - now),
    }
end

function WorldEventService.Start()
    Workspace.Gravity = GameConfig.NORMAL_GRAVITY
    WorldEventService.NextEventAt = os.time() + GameConfig.WORLD_ENDING_INTERVAL_SECONDS
end

return WorldEventService
]]></ProtectedString>
  </Properties>
</Item>
</Item>
</Item>
</Item>
