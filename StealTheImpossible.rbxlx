        SecondaryColor = Color3.fromRGB(35, 225, 145),
    },
    {
        Id = "world_ending_meteor_core",
        Name = "Apocalypse Star Shard",
        NameTR = "Kıyamet Yıldızı Parçası",
        Description = "Dropped directly during THE WORLD IS ENDING catastrophe!",
        DescriptionTR = "DÜNYA YOK OLUYOR felaketi sırasında gökten düşer!",
        Icon = "☄️",
        Rarity = "Impossible",
        BiomeId = "WorldEvent",
        BaseCashValue = 98000,
        PassiveIncomePerSec = 860,
        VisualStyle = "FrozenSun",
        PrimaryColor = Color3.fromRGB(255, 90, 45),
        SecondaryColor = Color3.fromRGB(255, 225, 95),
        SpecialBehavior = "MiniFireAura",
    },
}

-- Merge Weekly Items dynamically
local AllItemsList: { Types.ItemDefinition } = {}
local ById: { [string]: Types.ItemDefinition } = {}
local ByBiomeAndRarity: { [string]: { [Types.RarityId]: { Types.ItemDefinition } } } = {}
local SecretsList: { Types.ItemDefinition } = {}

local function registerItem(def: Types.ItemDefinition)
    table.insert(AllItemsList, def)
    ById[def.Id] = def
    if def.IsSecret or def.Rarity == "Secret" then
        table.insert(SecretsList, def)
    end
    if not ByBiomeAndRarity[def.BiomeId] then
        ByBiomeAndRarity[def.BiomeId] = {}
    end
    if not ByBiomeAndRarity[def.BiomeId][def.Rarity] then
        ByBiomeAndRarity[def.BiomeId][def.Rarity] = {}
    end
    table.insert(ByBiomeAndRarity[def.BiomeId][def.Rarity], def)
end

for _, item in ipairs(BaseItems) do
    registerItem(item)
end
for _, weeklyItem in ipairs(WeeklyItems.Items) do
    registerItem(weeklyItem)
end

-- Galaxy Egg random creature hatch pool ("İçinden rastgele galaksi yaratığı çıkan yumurta")
local GalaxyCreatures: { GalaxyCreatureDef } = {
    {
        Id = "nebula_fox",
        Name = "Nebula Fox",
        NameTR = "Nebula Tilkisi",
        Icon = "🦊",
        ChanceWeight = 42,
        BonusIncomeMultiplier = 1.25,
        Color = Color3.fromRGB(165, 125, 255),
    },
    {
        Id = "starlight_owl",
        Name = "Starlight Owl",
        NameTR = "Yıldızışığı Baykuşu",
        Icon = "🦉",
        ChanceWeight = 30,
        BonusIncomeMultiplier = 1.45,
        Color = Color3.fromRGB(95, 225, 255),
    },
    {
        Id = "quasar_wyrm",
        Name = "Quasar Wyrm",
        NameTR = "Kuasar Ejderi",
        Icon = "🐉",
        ChanceWeight = 18,
        BonusIncomeMultiplier = 1.75,
        Color = Color3.fromRGB(255, 115, 220),
    },
    {
        Id = "supernova_griffin",
        Name = "Supernova Griffin",
        NameTR = "Süpernova Grifonu",
        Icon = "🦅",
        ChanceWeight = 8,
        BonusIncomeMultiplier = 2.25,
        Color = Color3.fromRGB(255, 210, 75),
    },
    {
        Id = "celestial_leviathan",
        Name = "Void Celestial Leviathan",
        NameTR = "Kozmik Leviathan",
        Icon = "🌌",
        ChanceWeight = 2,
        BonusIncomeMultiplier = 3.50,
        Color = Color3.fromRGB(0, 255, 235),
    },
}

local ItemCatalog = {
    All = table.freeze(AllItemsList),
    ById = table.freeze(ById),
    Secrets = table.freeze(SecretsList),
    GalaxyCreatures = table.freeze(GalaxyCreatures),
}

function ItemCatalog.Get(itemId: string): Types.ItemDefinition?
    return ById[itemId]
end

function ItemCatalog.GetPool(biomeId: string, rarity: Types.RarityId): { Types.ItemDefinition }
    local biomeMap = ByBiomeAndRarity[biomeId]
    if biomeMap and biomeMap[rarity] and #biomeMap[rarity] > 0 then
        return biomeMap[rarity]
    end
    -- Fallback across any item matching rarity
    local fallback: { Types.ItemDefinition } = {}
    for _, item in ipairs(AllItemsList) do
        if item.Rarity == rarity and item.BiomeId ~= "WorldEvent" and item.BiomeId ~= "BigHeistVault" then
            table.insert(fallback, item)
        end
    end
    if #fallback > 0 then
        return fallback
    end
    -- Second fallback: anything in the requested biome
    if biomeMap then
        for _, list in pairs(biomeMap) do
            for _, item in ipairs(list) do
                table.insert(fallback, item)
            end
        end
    end
    return fallback
end

function ItemCatalog.RollGalaxyCreature(rng: Random?): GalaxyCreatureDef
    local total = 0
    for _, c in ipairs(GalaxyCreatures) do
        total += c.ChanceWeight
    end
    local roll = (if rng then rng:NextNumber() else math.random()) * total
    local accum = 0
    for _, c in ipairs(GalaxyCreatures) do
        accum += c.ChanceWeight
        if roll <= accum then
            return c
        end
    end
    return GalaxyCreatures[1]
end

function ItemCatalog.GetInstanceMultiplier(inst: Types.OwnedItemInstance): number
    local mult = 1.0
    if inst.HatchedCreature then
        for _, c in ipairs(GalaxyCreatures) do
            if c.Id == inst.HatchedCreature then
                mult = mult * c.BonusIncomeMultiplier
                break
            end
        end
    end
    if inst.Mutation then
        mult = mult * MutationConfig.Get(inst.Mutation).ValueMultiplier
    end
    return mult
end

function ItemCatalog.GetMasteredBiomeCount(discoveredItems: { [string]: number }): number
    local biomeCoreItems: { [string]: { string } } = {}
    for _, item in ipairs(AllItemsList) do
        if not item.IsSecret and not item.IsWeekly and item.BiomeId ~= "WorldEvent" and item.BiomeId ~= "BigHeistVault" and item.BiomeId ~= "SpecialRift" then
            biomeCoreItems[item.BiomeId] = biomeCoreItems[item.BiomeId] or {}
            table.insert(biomeCoreItems[item.BiomeId], item.Id)
        end
    end

    local mastered = 0
    for _, ids in pairs(biomeCoreItems) do
        local allFound = (#ids > 0)
        for _, id in ipairs(ids) do
            if (discoveredItems[id] or 0) <= 0 then
                allFound = false
                break
            end
        end
        if allFound then
            mastered += 1
        end
    end
    return mastered
end

return table.freeze(ItemCatalog)
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000008">
  <Properties>
    <string name="Name">Localization</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Global EN + Turkish (TR) Localization Dictionary for STEAL THE IMPOSSIBLE

export type LanguageCode = "en" | "tr"

local Translations: { [string]: { en: string, tr: string } } = {
    GAME_TITLE = { en = "STEAL THE IMPOSSIBLE", tr = "STEAL THE IMPOSSIBLE" },
    CASH = { en = "Cash", tr = "Nakit" },
    INCOME_PER_SEC = { en = "/sec", tr = "/sn" },
    NET_WORTH = { en = "Net Worth", tr = "Servet" },
    CARRYING = { en = "CARRYING", tr = "TAŞINIYOR" },
    RUN_TO_BASE = { en = "RUN BACK TO YOUR BASE TO SECURE!", tr = "GÜVENCEYE ALMAK İÇİN ÜSSÜNE KOŞ!" },
    TACKLE_BTN = { en = "STEAL / TACKLE", tr = "ÇAL / MÜDAHALE ET" },
    GADGET_BTN = { en = "USE GADGET", tr = "EKİPMAN KULLAN" },
    RIFT_OPEN_IN = { en = "15M SPECIAL RIFT IN", tr = "15 DK ÖZEL YARIK" },
    RIFT_ACTIVE = { en = "RIFT OPEN:", tr = "YARIK AÇIK:" },
    WORLD_END_IN = { en = "WORLD ENDING IN", tr = "DÜNYA SONU" },
    WORLD_END_ACTIVE = { en = "THE WORLD IS ENDING!", tr = "DÜNYA YOK OLUYOR!" },
    BASE_MENU = { en = "Base & Vault", tr = "Üs & Kasa" },
    FLEX_MENU = { en = "Flex Bases", tr = "Üs Gez" },
    SHOP_MENU = { en = "Shop & Style", tr = "Mağaza" },
    INDEX_MENU = { en = "Secret Index", tr = "Gizli Koleksiyon" },
    SQUAD_MENU = { en = "Squad Heist", tr = "Takım Soygunu" },
    RANK_MENU = { en = "Leaderboard", tr = "Sıralama" },
    UPGRADE_BASE = { en = "Upgrade Base", tr = "Üssü Yükselt" },
    EQUIP_PEDESTAL = { en = "Flex on Pedestal", tr = "Stantta Sergile" },
    HATCH_EGG = { en = "Hatch Galaxy Egg", tr = "Galaksi Yumurtası Çatlat" },
    VISIT_BASE = { en = "Visit Base", tr = "Üssü Ziyaret Et" },
    LIKE_BASE = { en = "Like Base ❤️", tr = "Üssü Beğen ❤️" },
    RETURN_HOME = { en = "Return to My Base", tr = "Kendi Üssüme Dön" },
    BUY = { en = "Buy", tr = "Satın Al" },
    EQUIP = { en = "Equip", tr = "Kuşan" },
    EQUIPPED = { en = "Equipped", tr = "Kuşanıldı" },
    OWNED = { en = "Owned", tr = "Sahipsin" },
    NO_P2W_BADGE = {
        en = "100% COSMETIC ONLY — ZERO PAY-TO-WIN",
        tr = "%100 KOZMETİK — PARAYLA GÜÇ SATIN ALINMAZ",
    },
    SECRET_BANNER_TITLE = {
        en = "0.01% SECRET COLLECTION DISCOVERY!",
        tr = "%0,01 GİZLİ KOLEKSİYON KEŞFİ!",
    },
    CREATE_SQUAD = { en = "Create Squad", tr = "Takım Kur" },
    LEAVE_SQUAD = { en = "Leave Squad", tr = "Takımdan Ayrıl" },
    INVITE = { en = "Invite", tr = "Davet Et" },
    START_HEIST = { en = "Start Big Heist", tr = "Büyük Soygunu Başlat" },
    LANG_LABEL = { en = "Language: EN", tr = "Dil: TR" },
    EVENT_METEOR = { en = "METEOR SHOWER", tr = "METEOR YAĞMURU" },
    EVENT_MONSTER = { en = "GIANT MONSTER", tr = "DEV CANAVAR" },
    EVENT_GRAVITY = { en = "GRAVITY LOSS", tr = "YERÇEKİMİ KAYBI" },
    QUESTS_MENU = { en = "Quests & Codes", tr = "Görev & Kod" },
    TRADE_MENU = { en = "Trade", tr = "Takas" },
    REDEEM = { en = "Redeem", tr = "Kullan" },
    CLAIM = { en = "Claim", tr = "Ödülü Al" },
    CLAIMED = { en = "Claimed", tr = "Alındı" },
    REBIRTH_BTN = { en = "ASCEND / REBIRTH", tr = "YÜKSEL / REBIRTH" },
    HIGH_STAKES = { en = "High-Stakes 2x Safe", tr = "Yüksek Risk 2x Kasa" },
    COLLECT_SAFE = { en = "Collect Safe", tr = "Kasayı Topla" },
    ACTIVATE_SHIELD = { en = "Recharge Shield", tr = "Kalkanı Yenile" },
    RAID_SAFE = { en = "RAID SAFE!", tr = "KASAYI SOY!" },
    HOME_COMPASS = { en = "YOUR BASE", tr = "ÜSSÜN" },
}

local Localization = {}

function Localization.Get(key: string, lang: LanguageCode?): string
    local entry = Translations[key]
    if not entry then
        return key
    end
    local code: LanguageCode = if lang == "tr" then "tr" else "en"
    return entry[code]
end

return table.freeze(Localization)
]]></ProtectedString>
  </Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000009">
  <Properties>
    <string name="Name">MutationConfig</string>
    <ProtectedString name="Source"><![CDATA[--!strict
-- Item Mutation System (Normal, Shiny, Frostbitten, Glitch, VoidTouched, Celestial)
-- Multiplies item Cash Value & Passive Income/sec and adds distinct visual flair!

export type MutationId =
    "Normal"
    | "Shiny"
    | "Frostbitten"
    | "Glitch"
    | "VoidTouched"
    | "Celestial"

export type MutationDef = {
    Id: MutationId,
    DisplayName: string,
    DisplayNameTR: string,
    Prefix: string,
    DropWeight: number, -- out of 100.0
    ValueMultiplier: number,
    Color: Color3,
    ParticleColor: Color3,
}

local Order: { MutationId } = {
    "Normal",
    "Shiny",
    "Frostbitten",
    "Glitch",
    "VoidTouched",
    "Celestial",
}

local Mutations: { [MutationId]: MutationDef } = {
    Normal = {
        Id = "Normal",
        DisplayName = "Standard",
        DisplayNameTR = "Standart",
        Prefix = "",
        DropWeight = 84.75,
        ValueMultiplier = 1.0,
        Color = Color3.fromRGB(225, 232, 245),
        ParticleColor = Color3.fromRGB(225, 232, 245),
    },
    Shiny = {
        Id = "Shiny",
        DisplayName = "SHINY",
        DisplayNameTR = "PARLAK",
        Prefix = "✨ Shiny ",
        DropWeight = 8.00,
        ValueMultiplier = 1.75,
        Color = Color3.fromRGB(255, 235, 115),
        ParticleColor = Color3.fromRGB(255, 245, 165),
    },
    Frostbitten = {
        Id = "Frostbitten",
        DisplayName = "FROSTBITTEN",
        DisplayNameTR = "BUZLANMIŞ",
        Prefix = "❄️ Frost ",
        DropWeight = 4.00,
        ValueMultiplier = 2.25,
        Color = Color3.fromRGB(115, 235, 255),
        ParticleColor = Color3.fromRGB(205, 250, 255),
    },
    Glitch = {
        Id = "Glitch",
        DisplayName = "GLITCHED",
        DisplayNameTR = "GLİTCHLİ",
        Prefix = "⚡ Glitched ",
        DropWeight = 2.00,
        ValueMultiplier = 3.00,
        Color = Color3.fromRGB(0, 255, 185),
        ParticleColor = Color3.fromRGB(255, 55, 215),
    },
    VoidTouched = {
        Id = "VoidTouched",
        DisplayName = "VOID-TOUCHED",
        DisplayNameTR = "HİÇLİK DOKUNUŞLU",
        Prefix = "🌑 Void ",
        DropWeight = 1.00,
        ValueMultiplier = 4.00,
        Color = Color3.fromRGB(175, 65, 255),
        ParticleColor = Color3.fromRGB(75, 25, 135),
    },
    Celestial = {
        Id = "Celestial",
        DisplayName = "CELESTIAL",
        DisplayNameTR = "GÖKSEL",
        Prefix = "👑 Celestial ",
        DropWeight = 0.25,
        ValueMultiplier = 7.50,
        Color = Color3.fromRGB(255, 195, 45),
        ParticleColor = Color3.fromRGB(0, 255, 245),
    },
}

local MutationConfig = {
    Order = table.freeze(Order),
    Tiers = table.freeze(Mutations),
}

function MutationConfig.Get(mutationId: MutationId?): MutationDef
    if mutationId and Mutations[mutationId] then
        return Mutations[mutationId]
    end
    return Mutations.Normal
end

function MutationConfig.RollMutation(luckMultiplier: number?, rng: Random?): MutationId
    local mult = math.max(1.0, luckMultiplier or 1.0)
    local total = 0
    local weights: { { id: MutationId, w: number } } = {}

    for _, mId in ipairs(Order) do
        local def = Mutations[mId]
        local w = if mId == "Normal" then def.DropWeight else (def.DropWeight * mult)
        total += w
        table.insert(weights, { id = mId, w = w })
    end

    local roll = (if rng then rng:NextNumber() else math.random()) * total
    local accum = 0
    for _, entry in ipairs(weights) do
        accum += entry.w
        if roll <= accum then
            return entry.id
        end
    end
    return "Normal"
end

return table.freeze(MutationConfig)
]]></ProtectedString>
  </Properties>
</Item>
