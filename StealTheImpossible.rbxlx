    },

    -- VIP Tag
    {
        Id = "vip_gold_crown",
        Category = "VipTag",
        Name = "VIP Crown Tag",
        NameTR = "VIP Taç Etiketi",
        RequiredProductId = "prod_vip_nametag",
        PrimaryColor = Color3.fromRGB(255, 215, 45),
        SecondaryColor = Color3.fromRGB(255, 125, 35),
        TagText = "👑 VIP",
    },

    -- Pet Appearances (cosmetic only!)
    {
        Id = "pet_frost_wisp",
        Category = "PetSkin",
        Name = "Frost Wisp",
        NameTR = "Buz Perisi",
        RequiredProductId = "prod_custom_pets",
